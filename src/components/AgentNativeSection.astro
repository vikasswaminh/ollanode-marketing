---
// src/components/AgentNativeSection.astro
const workflowSteps = [
  {
    code: '200 OK',
    type: 'allowed',
    title: 'Standard Product Actions',
    endpoint: 'GET /v1/videos · POST /v1/uploads',
    desc: 'Agents run read & standard write requests freely within scope without human intervention.'
  },
  {
    code: '202 ACCEPTED',
    type: 'approval',
    title: 'Human-Gated Destructive Actions',
    endpoint: 'DELETE /v1/videos · POST /v1/functions',
    desc: 'Returns 202 Pending Approval. Executed only after a human resubmits with an X-Approval-Id digest.'
  },
  {
    code: '403 FORBIDDEN',
    type: 'denied',
    title: 'Human-Only Prohibited Operations',
    endpoint: 'POST /v1/keys · DELETE /v1/org',
    desc: 'Agent keys are structurally prevented from holding admin, managing credentials, or accessing billing.'
  }
];

const governancePillars = [
  {
    num: '01',
    title: 'Capability Map (/v1/whoami)',
    desc: 'Agents inspect per-action capability states (allowed | approval | denied) before execution so they never fail by trial and error.'
  },
  {
    num: '02',
    title: 'Approval Digest Gating',
    desc: 'Destructive calls return 202 without running. Approvals bind to key, action, resource, and body hash to prevent payload tampering.'
  },
  {
    num: '03',
    title: 'Tamper-Evident Audit Chain',
    desc: 'Every mutation logs prev_hash/entry_hash integrity signatures in an immutable cryptographic audit chain (/v1/audit/verify).'
  },
  {
    num: '04',
    title: 'Emergency Project Kill-Switch',
    desc: 'Platform operators can instantly revoke all active AI agent keys for a project with one fail-closed call (/v1/admin/disable-agents).'
  }
];
---

<section class="band alt agent-native-sec" id="agent-native">
  <div class="wrap">
    {/* SECTION HEADER */}
    <div class="agent-header-wrap">
      <span class="eyebrow">
        <span class="eyebrow-dot"></span>
        AGENT-NATIVE INFRASTRUCTURE
      </span>
      <h2 class="agent-h2 reveal-up ">
        AI agents with human-in-the-loop guardrails.
      <p class="agent-lead-desc reveal-up" style="font-family: 'Inter', sans-serif;">
        Agents are API-first citizens with built-in governance. They discover their own capabilities via <code class="agent-inline-code">/v1/whoami</code>, run standard actions freely, but route destructive operations through human approval &mdash; backed by a tamper-evident audit trail and a project kill-switch.
      </p>

      <div class="agent-chips-strip">
        <span class="agent-chip">whoami map</span>
        <span class="agent-chip-dot">•</span>
        <span class="agent-chip">202 approval-gated</span>
        <span class="agent-chip-dot">•</span>
        <span class="agent-chip">hash-chain audit</span>
        <span class="agent-chip-dot">•</span>
        <span class="agent-chip">kill-switch</span>
      </div>
    </div>

    {/* WORKFLOW DIAGRAM */}
    <div class="agent-diagram-card">
      <div class="diagram-top-bar">
        <div class="agent-node-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="node-icon"><rect x="3" y="11" width="18" height="10" rx="2"/><circle cx="12" cy="5" r="2"/><path d="M12 7v4"/><line x1="8" y1="16" x2="8.01" y2="16"/><line x1="16" y1="16" x2="16.01" y2="16"/></svg>
          <span>AI AGENT / MCP CLIENT</span>
        </div>
        <span class="diagram-arrow">─── API Request ───►</span>
        <div class="control-node-badge">
          <span class="control-dot"></span>
          <span>OLLANODE CONTROL PLANE</span>
        </div>
      </div>

      {/* 3-BRANCH EXECUTION PATHS */}
      <div class="branches-grid">
        {workflowSteps.map((step) => (
          <div class={`branch-card branch-${step.type}`}>
            <div class="branch-header">
              <span class={`status-badge badge-${step.type}`}>{step.code}</span>
              <span class="endpoint-code">{step.endpoint}</span>
            </div>
            <h3 class="branch-title">{step.title}</h3>
            <p class="branch-desc">{step.desc}</p>
          </div>
        ))}
      </div>

      {/* BOTTOM DIAGRAM FOOTER */}
      <div class="diagram-bottom-bar">
        <div class="audit-status-item">
          <span class="audit-icon">🛡️</span>
          <span><b>Cryptographic Audit:</b> Every action signed with <code class="agent-inline-code">prev_hash / entry_hash</code> verification</span>
        </div>
        <div class="kill-status-item">
          <span class="kill-indicator"></span>
          <span><b>Kill-Switch:</b> Instant revocation via <code class="agent-inline-code">/v1/admin/disable-agents</code></span>
        </div>
      </div>
    </div>

    {/* 4 GOVERNANCE PILLARS GRID */}
    <div class="pillars-grid">
      {governancePillars.map((pillar) => (
        <article class="pillar-card">
          <div class="pillar-top">
            <span class="pillar-num">{pillar.num}</span>
          </div>
          <h4 class="pillar-title">{pillar.title}</h4>
          <p class="pillar-desc">{pillar.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .agent-native-sec {
    position: relative;
    width: 100%;
    background: linear-gradient(180deg, #FFF5F2 0%, #FFF9F7 100%);
    padding: 85px 0 95px;
    border-top: 1px solid rgba(255, 90, 61, 0.15);
    border-bottom: 1px solid rgba(255, 90, 61, 0.15);
    z-index: 2;
  }

  .agent-header-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 920px;
    margin: 0 auto 52px;
    gap: 18px;
  }

  .agent-h2 {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2rem, 3vw, 2.6rem);
    font-weight: 620;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: #1A1D23;
    margin: 0;
  }

  .agent-lead-desc {
    font-family: 'Inter', sans-serif;
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    font-weight: 400;
    color: #475569;
    line-height: 1.6;
    margin: 0;
  }

  .agent-inline-code {
    font-family: var(--mono);
    font-size: 0.9em;
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    padding: 2px 7px;
    border-radius: 5px;
    color: #FF5A3D;
  }

  .agent-chips-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 500;
    color: #1A1D23;
    padding-top: 6px;
  }

  .agent-chip {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    padding: 4px 12px;
    border-radius: 20px;
  }

  .agent-chip-dot {
    color: #FF5A3D;
    font-weight: bold;
  }

  /* WORKFLOW DIAGRAM CARD */
  .agent-diagram-card {
    background: #FFFFFF;
    border: 1px solid #1A1D23;
    border-radius: 16px;
    padding: 28px 32px;
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-bottom: 48px;
    box-shadow: 0 2px 10px rgba(26, 29, 35, 0.04);
  }

  .diagram-top-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    padding-bottom: 20px;
    border-bottom: 1px solid #E2E8F0;
  }

  .agent-node-badge,
  .control-node-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 8px;
    letter-spacing: 0.04em;
  }

  .agent-node-badge {
    background: #F1F5F9;
    border: 1px solid #CBD5E1;
    color: #1A1D23;
  }

  .control-node-badge {
    background: #FFF0EB;
    border: 1px solid #FF5A3D;
    color: #1A1D23;
  }

  .node-icon {
    width: 16px;
    height: 16px;
    color: #FF5A3D;
  }

  .control-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #FF5A3D;
    box-shadow: 0 0 0 3px rgba(255, 90, 61, 0.2);
  }

  .diagram-arrow {
    font-family: var(--mono);
    font-size: 12px;
    color: #667085;
    letter-spacing: 0.05em;
  }

  /* 3-BRANCH GRID */
  .branches-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .branch-card {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .branch-card:hover {
    transform: translateY(-2px);
  }

  .branch-allowed:hover {
    border-color: #16a34a;
  }

  .branch-approval:hover {
    border-color: #FF5A3D;
  }

  .branch-denied:hover {
    border-color: #dc2626;
  }

  .branch-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .status-badge {
    align-self: start;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 0.04em;
  }

  .badge-allowed {
    background: #DCFCE7;
    color: #15803D;
    border: 1px solid #86EFAC;
  }

  .badge-approval {
    background: #FFF0EB;
    color: #C2410C;
    border: 1px solid #FFBDAD;
  }

  .badge-denied {
    background: #FEE2E2;
    color: #B91C1C;
    border: 1px solid #FCA5A5;
  }

  .endpoint-code {
    font-family: var(--mono);
    font-size: 11px;
    color: #667085;
  }

  .branch-title {
    font-family: 'Inter', sans-serif;
    font-size: 1.05rem;
    font-weight: 650;
    color: #1A1D23;
    margin: 0;
  }

  .branch-desc {
    font-family: 'Inter', sans-serif;
    font-size: 0.88rem;
    color: #667085;
    line-height: 1.5;
    margin: 0;
  }

  .diagram-bottom-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: 16px;
    border-top: 1px solid #E2E8F0;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    color: #475569;
  }

  .audit-status-item,
  .kill-status-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .kill-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #dc2626;
  }

  /* 4 GOVERNANCE PILLARS */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .pillar-card {
    background: #FFFFFF;
    border: 1px solid #1A1D23;
    border-radius: 12px;
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .pillar-card:hover {
    border-color: #FF5A3D;
    transform: translateY(-2px);
  }

  .pillar-num {
    font-family: var(--mono);
    font-size: 1.1rem;
    font-weight: 700;
    color: #FF5A3D;
  }

  .pillar-title {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 650;
    color: #1A1D23;
    margin: 0;
  }

  .pillar-desc {
    font-family: 'Inter', sans-serif;
    font-size: 0.88rem;
    color: #667085;
    line-height: 1.5;
    margin: 0;
  }

  /* RESPONSIVE RULES */
  @media (max-width: 990px) {
    .branches-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .pillars-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
  }

  @media (max-width: 640px) {
    .agent-native-sec {
      padding: 55px 0 65px;
    }

    .agent-diagram-card {
      padding: 20px 16px;
    }

    .pillars-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .diagram-top-bar {
      flex-direction: column;
      gap: 10px;
    }

    .diagram-arrow {
      transform: rotate(90deg);
    }
  }
</style>
