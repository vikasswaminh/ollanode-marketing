---

<section class="delivery-edge-section" id="delivery-edge">
  <div class="delivery-edge-wrap">
    <div class="delivery-split-grid">
      
      {/* LEFT COLUMN: STICKY HEADER & INTERACTIVE HEADING NAV */}
      <div class="delivery-left-sticky">
        <div class="delivery-sticky-content">
          <div class="delivery-eyebrow">
            <span class="eyebrow-dot"></span>
            <span>DELIVERY &amp; EDGE</span>
          </div>

          <h2 class="delivery-h2 reveal-up">
            Deliver Faster.<br />
            Everywhere.
          </h2>

          <p class="delivery-lead-desc reveal-up">
            A global edge network and powerful infrastructure to store, optimize and deliver your content with ultra-low latency.
          </p>

          {/* INTERACTIVE HEADINGS LIST (CLICKING FLIPS & FOCUSES THE CARD) */}
          <div class="delivery-nav-menu" role="tablist" aria-label="Edge capabilities navigation">
            <span class="nav-menu-label">CLICK HEADING TO FLIP CARD ↓</span>
            {edgeCards.map((card) => (
              <button
                type="button"
                class="delivery-nav-item"
                data-target-id={card.id}
                aria-label={`Show detail for ${card.title}`}
              >
                <span class="nav-item-num">{card.number}</span>
                <span class="nav-item-title">{card.title}</span>
                <span class="nav-item-arrow">→</span>
              </button>
            ))}
          </div>
        </div>
      </div>

      {/* RIGHT COLUMN: COMPACT INTERACTIVE 3D FLIPPABLE CARDS */}
      <div class="delivery-right-cards">
        {edgeCards.map((card) => (
          <div class="flip-card-wrapper" id={`card-${card.id}`} data-card-id={card.id} title="Click anywhere on card to flip">
            <div class="flip-card-inner">
              
              {/* FRONT FACE (COMPACT SUMMARY) */}
              <div class="card-face card-front">
                <div class="card-top">
                  <div class="card-top-left">
                    <div class={`card-icon ${card.colorClass}`} set:html={card.icon}></div>
                    <span class="card-category">{card.category}</span>
                  </div>
                  <div class="card-top-right">
                    <span class="card-num">{card.number}</span>
                    <span class="flip-hint-pill" title="Click to flip">
                      <span class="flip-hint-text">Flip</span>
                      <span class="flip-icon">↺</span>
                    </span>
                  </div>
                </div>

                <h3 class="card-title">{card.title}</h3>
                <p class="card-desc">{card.summary}</p>

                <div class="card-snippet-box">
                  <span class="code-line-primary">{card.snippetPrimary}</span>
                  <span class="code-line-sub">· {card.snippetSub}</span>
                </div>
              </div>

              {/* BACK FACE (COMPLETE TECHNICAL DETAILS) */}
              <div class="card-face card-back">
                <div class="card-top">
                  <div class="card-top-left">
                    <span class="back-badge">FULL DETAIL</span>
                    <span class="back-title-tag">{card.title}</span>
                  </div>
                  <div class="card-top-right">
                    <span class="flip-back-pill" title="Click to flip back">
                      <span class="flip-hint-text">Back</span>
                      <span class="flip-icon">↺</span>
                    </span>
                  </div>
                </div>

                <ul class="card-detail-list">
                  {card.details.map((detail) => (
                    <li class="detail-list-item">
                      <span class="detail-bullet-dot"></span>
                      <span>{detail}</span>
                    </li>
                  ))}
                </ul>

                <div class="card-back-footer">
                  <a href={card.docLink} class="card-doc-link" onclick="event.stopPropagation()">
                    <span>{card.docText}</span>
                    <span class="link-arr">→</span>
                  </a>
                </div>
              </div>

            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<script is:inline>
  (function () {
    function initDeliveryCardInteractivity() {
      var navButtons = document.querySelectorAll('.delivery-nav-item');
      var cardWrappers = document.querySelectorAll('.flip-card-wrapper');

      if (!cardWrappers.length) return;

      // Function to toggle or set flip state on a card
      function flipCard(cardWrapper, shouldFlip) {
        if (!cardWrapper) return;
        var inner = cardWrapper.querySelector('.flip-card-inner');
        if (!inner) return;

        if (typeof shouldFlip === 'boolean') {
          if (shouldFlip) {
            inner.classList.add('is-flipped');
          } else {
            inner.classList.remove('is-flipped');
          }
        } else {
          inner.classList.toggle('is-flipped');
        }
      }

      // Reset all flipped cards back to front face
      function resetAllCardsToFront() {
        cardWrappers.forEach(function (wrapper) {
          var inner = wrapper.querySelector('.flip-card-inner');
          if (inner && inner.classList.contains('is-flipped')) {
            inner.classList.remove('is-flipped');
          }
        });
      }

      // 1. CLICK ANYWHERE ON CARD TO FLIP (Front <-> Back)
      cardWrappers.forEach(function (cardWrapper) {
        cardWrapper.addEventListener('click', function (e) {
          // If the click is on an anchor tag inside the card, allow navigation and don't toggle flip
          if (e.target.closest('a')) return;
          flipCard(cardWrapper);
        });
      });

      // 2. LEFT HEADINGS CLICK HANDLER
      navButtons.forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          var targetId = btn.getAttribute('data-target-id');
          if (!targetId) return;

          var targetCard = document.getElementById('card-' + targetId);
          if (!targetCard) return;

          // Highlight active nav item
          navButtons.forEach(function (b) { b.classList.remove('is-active'); });
          btn.classList.add('is-active');

          // Scroll target card into view smoothly
          targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });

          // Flip card to show complete detail
          flipCard(targetCard, true);

          // Subtle highlight animation
          targetCard.classList.add('is-highlighted');
          setTimeout(function () {
            targetCard.classList.remove('is-highlighted');
          }, 1200);
        });
      });

      // 3. AUTOMATICALLY FLIP BACK TO FRONT ON SCROLL
      var isScrollingTimer;
      window.addEventListener('scroll', function () {
        clearTimeout(isScrollingTimer);
        isScrollingTimer = setTimeout(function () {
          resetAllCardsToFront();
          navButtons.forEach(function (b) { b.classList.remove('is-active'); });
        }, 180);
      }, { passive: true });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initDeliveryCardInteractivity);
    } else {
      initDeliveryCardInteractivity();
    }
  })();
</script>

<style>
  .delivery-edge-section {
    position: relative;
    width: 100%;
    background: radial-gradient(120% 120% at 50% 10%, rgba(30, 41, 59, 0.45) 0%, rgba(15, 23, 42, 0.9) 50%, #070A0F 100%), linear-gradient(180deg, #070A0F 0%, #0B101D 50%, #070A0F 100%);
    padding: 85px 0 95px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    z-index: 2;
  }

  .delivery-edge-wrap {
    width: 100%;
    max-width: var(--maxw, 1320px);
    margin: 0 auto;
    padding: 0 var(--gutter, clamp(20px, 4vw, 40px));
  }

  /* SPLIT GRID: STICKY LEFT + SCROLLING CARDS RIGHT */
  .delivery-split-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(32px, 4.5vw, 60px);
    align-items: start;
    position: relative;
  }

  /* LEFT STICKY COLUMN */
  .delivery-left-sticky {
    position: sticky;
    top: 110px;
    align-self: start;
    height: auto;
  }

  .delivery-sticky-content {
    display: flex;
    flex-direction: column;
    padding-right: clamp(0px, 2vw, 12px);
  }

  /* EYEBROW */
  .delivery-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 90, 61, 0.12);
    border: 1.5px solid rgba(255, 90, 61, 0.3);
    border-radius: 999px;
    padding: 4px 13px;
    font-family: var(--mono, monospace);
    font-size: 11px;
    font-weight: 600;
    color: #FF7A4D;
    letter-spacing: 0.14em;
    margin-bottom: 16px;
    text-transform: uppercase;
    width: fit-content;
  }

  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #FF5A3D;
    box-shadow: 0 0 0 3px rgba(255, 90, 61, 0.25);
  }

  /* CRISP WHITE HEADING IN DARK MODE */
  .delivery-h2 {
    font-family: var(--sans, 'Inter', sans-serif);
    font-size: clamp(1.9rem, 2.8vw, 2.45rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.04em;
    color: #FFFFFF;
    margin: 0 0 14px;
  }

  .delivery-lead-desc {
    font-family: var(--sans, 'Inter', sans-serif);
    font-size: clamp(0.92rem, 1.05vw, 1.02rem);
    font-weight: 400;
    color: #94A3B8;
    line-height: 1.6;
    margin: 0 0 22px;
  }

  /* INTERACTIVE HEADING MENU */
  .delivery-nav-menu {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .nav-menu-label {
    font-family: var(--mono, monospace);
    font-size: 10px;
    font-weight: 650;
    color: #64748B;
    letter-spacing: 0.08em;
    margin-bottom: 2px;
    text-transform: uppercase;
  }

  .delivery-nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 8px;
    padding: 8px 12px;
    font-family: var(--sans, sans-serif);
    font-size: 13px;
    font-weight: 650;
    color: #CBD5E1;
    text-align: left;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
  }

  .delivery-nav-item:hover {
    border-color: #FF5A3D;
    background: #1E2235;
    color: #FF7A4D;
    transform: translateX(3px);
  }

  .delivery-nav-item.is-active {
    border-color: #FF5A3D;
    background: rgba(255, 90, 61, 0.15);
    color: #FFFFFF;
    box-shadow: 0 3px 12px rgba(255, 90, 61, 0.25);
  }

  .nav-item-num {
    font-family: var(--mono, monospace);
    font-size: 11.5px;
    font-weight: 700;
    color: #FF7A4D;
  }

  .nav-item-title {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nav-item-arrow {
    font-size: 12px;
    color: #64748B;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .delivery-nav-item:hover .nav-item-arrow,
  .delivery-nav-item.is-active .nav-item-arrow {
    transform: translateX(3px);
    color: #FF7A4D;
  }

  /* RIGHT COLUMN: SMALL COMPACT 3D FLIPPABLE CARDS */
  .delivery-right-cards {
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  .flip-card-wrapper {
    perspective: 1000px;
    width: 100%;
    cursor: pointer;
    user-select: none;
  }

  .flip-card-wrapper.is-highlighted {
    animation: card-pulse-highlight 1s ease-in-out;
  }

  @keyframes card-pulse-highlight {
    0% { transform: scale(1); }
    50% { transform: scale(1.02); }
    100% { transform: scale(1); }
  }

  .flip-card-inner {
    position: relative;
    width: 100%;
    min-height: 140px;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    transform-style: preserve-3d;
  }

  .flip-card-inner.is-flipped {
    transform: rotateY(180deg);
  }

  /* CARD FACES - DARK MODE */
  .card-face {
    position: relative;
    width: 100%;
    background: #0D1525;
    border: 1.5px solid #1E293B;
    border-radius: 12px;
    padding: 14px 18px 13px;
    display: flex;
    flex-direction: column;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .flip-card-wrapper:hover .card-face {
    border-color: #FF5A3D;
    box-shadow: 0 8px 26px rgba(255, 90, 61, 0.16);
  }

  .card-back {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    transform: rotateY(180deg);
    background: #090E1A;
    border-color: rgba(255, 90, 61, 0.4);
  }

  /* COMPACT CARD TOP */
  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 7px;
  }

  .card-top-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .card-top-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .card-icon {
    width: 28px;
    height: 28px;
    border-radius: 7px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .card-icon svg {
    width: 15px;
    height: 15px;
  }

  .icon-bg-blue { background: rgba(37, 99, 235, 0.18); }
  .icon-bg-orange { background: rgba(255, 90, 61, 0.18); }
  .icon-bg-green { background: rgba(22, 163, 74, 0.18); }
  .icon-bg-purple { background: rgba(147, 51, 234, 0.18); }

  .card-num {
    font-family: var(--mono, monospace);
    font-size: 11.5px;
    font-weight: 700;
    color: #FF7A4D;
  }

  .card-category {
    font-family: var(--mono, monospace);
    font-size: 9.5px;
    font-weight: 700;
    color: #94A3B8;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    background: rgba(255, 255, 255, 0.06);
    padding: 1.5px 6px;
    border-radius: 4px;
  }

  .flip-hint-pill,
  .flip-back-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: rgba(255, 90, 61, 0.12);
    border: 1px solid rgba(255, 90, 61, 0.3);
    border-radius: 4px;
    padding: 2px 6px;
    font-family: var(--mono, monospace);
    font-size: 10px;
    font-weight: 700;
    color: #FF7A4D;
    transition: all 0.2s ease;
  }

  .flip-card-wrapper:hover .flip-hint-pill {
    background: #FF5A3D;
    color: #FFFFFF;
    border-color: #FF5A3D;
  }

  .flip-icon {
    font-size: 11px;
    display: inline-block;
    line-height: 1;
  }

  /* CARD TITLE & DESC */
  .card-title {
    font-family: var(--sans, 'Inter', sans-serif);
    font-size: 14.5px;
    font-weight: 650;
    line-height: 1.25;
    color: #F8FAFC;
    margin: 0 0 4px;
    letter-spacing: -0.01em;
  }

  .card-desc {
    font-family: var(--sans, 'Inter', sans-serif);
    font-size: 12.5px;
    font-weight: 400;
    line-height: 1.4;
    color: #94A3B8;
    margin: 0 0 8px;
  }

  /* COMPACT SNIPPET */
  .card-snippet-box {
    background: #070B14;
    border: 1px solid #1E293B;
    border-radius: 6px;
    padding: 5px 9px;
    font-family: var(--mono, monospace);
    font-size: 10.5px;
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .code-line-primary {
    color: #E2E8F0;
    font-weight: 650;
  }

  .code-line-sub {
    color: #64748B;
    font-size: 9.5px;
  }

  /* BACK FACE DETAILS */
  .back-badge {
    font-family: var(--mono, monospace);
    font-size: 9px;
    font-weight: 750;
    color: #FF7A4D;
    background: rgba(255, 90, 61, 0.15);
    border: 1px solid rgba(255, 90, 61, 0.35);
    padding: 1.5px 6px;
    border-radius: 3px;
    letter-spacing: 0.06em;
  }

  .back-title-tag {
    font-family: var(--sans, sans-serif);
    font-size: 12.5px;
    font-weight: 700;
    color: #FFFFFF;
  }

  .card-detail-list {
    list-style: none;
    padding: 0;
    margin: 2px 0 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .detail-list-item {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    font-family: var(--sans, sans-serif);
    font-size: 11.5px;
    color: #CBD5E1;
    line-height: 1.35;
  }

  .detail-bullet-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #FF5A3D;
    margin-top: 5px;
    flex-shrink: 0;
  }

  .card-back-footer {
