---
// src/components/DeliveryEdgeSection.astro
---

<section class="band alt delivery-edge-sec" id="delivery-edge">
  <div class="wrap">
    {/* TOP SPLIT: CONTENT LEFT + GLOBAL EDGE NETWORK VISUALIZATION RIGHT */}
    <div class="delivery-top-grid">
      {/* LEFT CONTENT COLUMN */}
      <div class="delivery-left">
        <span class="eyebrow">
          <span class="eyebrow-dot"></span>
          DELIVERY &amp; EDGE
        </span>
        <h2 class="delivery-h2 reveal-up ">
          Deliver Faster.<br />
          Everywhere.
        </h2>
        <p class="delivery-desc reveal-up">
          A global edge network and powerful infrastructure to store, optimize and deliver your content with ultra-low latency.
        </p>

        {/* 2X2 CHECKLIST */}
        <div class="delivery-checklist">
          <div class="check-item reveal-up">
            <span class="check-icon">✓</span>
            <span class="check-text">Global Edge Locations</span>
          </div>
          <div class="check-item reveal-up">
            <span class="check-icon">✓</span>
            <span class="check-text">DDoS Protection</span>
          </div>
          <div class="check-item reveal-up">
            <span class="check-icon">✓</span>
            <span class="check-text">Smart Caching</span>
          </div>
          <div class="check-item reveal-up">
            <span class="check-icon">✓</span>
            <span class="check-text">Real-time Purging</span>
          </div>
        </div>

        <div class="delivery-cta-wrap">
          <a href="/docs/cdn" class="btn btn-primary chamfer-sm">
            Learn More About CDN →
          </a>
        </div>
      </div>

      {/* RIGHT TECHNICAL NETWORK VISUALIZER (MATCHING REFERENCE SCREENSHOT) */}
      <div class="delivery-right" role="region" aria-label="Global Edge Delivery Network Visualizer">
        <div class="map-card network-card">
          
          {/* TOP BANNER */}
          <div class="map-top-banner">
            <div class="map-status-pill">
              <span class="live-dot-pulse"></span>
              <span class="banner-title">GLOBAL EDGE NETWORK ACTIVE</span>
            </div>
            <span class="banner-sub">100+ Edge POPs &amp; Anycast Routing</span>
          </div>

          {/* WORLD MAP SVG VISUALIZATION */}
          <div class="network-svg-wrapper">
            <svg viewBox="0 0 1000 500" class="world-map-svg" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
              <defs>
                {/* Node Glow Filter */}
                <filter id="nodeGlow" x="-50%" y="-50%" width="200%" height="200%">
                  <feGaussianBlur stdDeviation="6" result="blur" />
                  <feComposite in="SourceGraphic" in2="blur" operator="over" />
                </filter>

                {/* Intense Outer Halo Filter */}
                <filter id="auraHalo" x="-100%" y="-100%" width="300%" height="300%">
                  <feGaussianBlur stdDeviation="14" result="blur" />
                </filter>
              </defs>

              {/* CARTOGRAPHIC HIGH-DEFINITION GEOGRAPHIC WORLD CONTINENTS */}
              <g class="world-continents" fill="#1E2636" stroke="rgba(255, 90, 61, 0.35)" stroke-width="0.9" stroke-linejoin="round" stroke-linecap="round">
                {/* North America Main Mass */}
                <path d="M 40,75 L 55,60 L 70,55 L 90,65 L 110,48 L 135,38 L 160,35 L 185,32 L 210,38 L 230,35 L 245,45 L 260,40 L 280,55 L 270,75 L 250,70 L 235,90 L 255,100 L 270,95 L 285,115 L 260,120 L 245,110 L 235,135 L 255,150 L 245,175 L 230,170 L 220,190 L 205,198 L 190,195 L 175,205 L 165,225 L 155,210 L 162,190 L 145,180 L 130,185 L 115,160 L 95,145 L 75,130 L 55,115 L 45,95 Z" />
                {/* Alaska Peninsula & Aleutian Chain */}
                <path d="M 40,75 L 30,85 L 20,90 L 10,95 L 18,100 L 32,92 L 45,85 Z" />
                {/* Florida Peninsula */}
                <path d="M 220,190 L 226,215 L 218,225 L 212,200 Z" />
                {/* Baja California */}
                <path d="M 130,165 L 142,195 L 138,205 L 126,170 Z" />
                {/* Mexico & Yucatan Peninsula */}
                <path d="M 165,225 L 185,220 L 205,228 L 215,220 L 225,235 L 200,245 L 180,238 Z" />
                {/* Central America Isthmus */}
                <path d="M 200,245 L 215,250 L 230,265 L 245,260 L 240,268 L 220,265 L 205,252 Z" />
                {/* West Indies / Caribbean Arc */}
                <path d="M 218,226 L 245,224 L 248,228 L 220,230 Z M 252,228 L 272,230 L 270,235 L 250,233 Z M 275,232 L 285,234 L 284,238 L 274,236 Z" />

                {/* Greenland */}
                <path d="M 275,25 L 300,18 L 322,20 L 338,30 L 348,48 L 338,68 L 315,82 L 290,82 L 272,68 L 265,48 Z" />
                {/* Baffin & Canadian Arctic Archipelago */}
                <path d="M 232,28 L 255,26 L 268,48 L 245,65 L 228,52 Z M 205,25 L 222,22 L 228,38 L 212,42 Z M 175,32 L 195,28 L 198,42 L 178,45 Z" />

                {/* South America Continent */}
                <path d="M 242,268 L 262,260 L 288,262 L 318,274 L 348,288 L 362,312 L 368,338 L 352,368 L 338,398 L 312,432 L 292,468 L 282,485 L 272,476 L 280,442 L 292,412 L 298,378 L 288,342 L 268,312 L 252,290 L 235,278 Z" />
                {/* Tierra del Fuego & Falklands */}
                <path d="M 270,478 L 282,478 L 280,488 L 268,486 Z M 298,482 L 308,480 L 309,488 L 296,487 Z" />

                {/* Europe Continent & Balkans */}
                <path d="M 428,72 L 442,60 L 458,54 L 482,48 L 508,50 L 522,64 L 532,86 L 542,96 L 528,116 L 512,110 L 498,122 L 490,114 L 482,132 L 468,144 L 448,146 L 432,140 L 426,124 L 416,112 L 420,92 Z" />
                {/* Scandinavian Peninsula */}
                <path d="M 458,54 L 472,36 L 492,26 L 512,32 L 532,48 L 545,35 L 535,62 L 522,78 L 505,88 L 488,76 L 478,82 L 468,68 Z" />
                {/* Iberian Peninsula */}
                <path d="M 416,112 L 434,110 L 440,126 L 430,144 L 410,142 L 408,124 Z" />
                {/* Italy Boot & Islands */}
                <path d="M 468,122 L 478,126 L 486,146 L 480,154 L 472,136 Z M 470,156 L 480,155 L 476,164 Z M 458,130 L 464,128 L 462,140 L 456,142 Z" />
                {/* British Isles */}
                <path d="M 402,74 L 416,66 L 424,80 L 420,98 L 406,104 L 400,86 Z M 386,80 L 396,76 L 400,88 L 390,94 Z" />

                {/* Africa Continent */}
                <path d="M 408,148 L 438,146 L 468,148 L 498,152 L 528,154 L 552,168 L 575,188 L 582,212 L 568,242 L 552,272 L 540,308 L 525,342 L 505,372 L 488,388 L 472,382 L 458,362 L 450,332 L 442,298 L 430,258 L 412,228 L 395,202 L 400,174 Z" />
                {/* Horn of Africa */}
                <path d="M 552,168 L 572,178 L 588,202 L 575,218 L 562,198 Z" />
                {/* Madagascar Island */}
                <path d="M 565,308 L 575,320 L 572,356 L 558,362 L 554,332 Z" />

                {/* Middle East (Arabia, Turkey, Iran) */}
                <path d="M 528,124 L 558,116 L 592,120 L 618,132 L 608,162 L 588,178 L 578,208 L 565,230 L 542,232 L 535,210 L 550,190 L 532,162 Z" />

                {/* Asia & Siberia Mass */}
                <path d="M 532,86 L 572,72 L 628,60 L 698,46 L 768,42 L 828,44 L 882,56 L 932,72 L 962,86 L 942,116 L 912,132 L 878,122 L 852,140 L 838,166 L 812,186 L 782,216 L 752,246 L 738,272 L 725,262 L 732,236 L 712,222 L 682,236 L 662,256 L 638,266 L 622,236 L 638,206 L 658,182 L 625,156 L 592,152 L 558,142 Z" />
                {/* Indian Subcontinent */}
                <path d="M 638,206 L 672,202 L 682,236 L 662,272 L 642,286 L 628,256 L 634,226 Z" />
                {/* Sri Lanka */}
                <path d="M 660,279 L 668,276 L 666,289 L 658,287 Z" />
                {/* Korean Peninsula */}
                <path d="M 830,148 L 840,146 L 844,170 L 832,174 Z" />
                {/* Japanese Archipelago */}
                <path d="M 862,122 L 882,112 L 890,135 L 875,152 Z M 850,150 L 865,142 L 870,166 L 854,170 Z M 842,168 L 852,165 L 854,175 L 844,176 Z" />

                {/* Southeast Asia & Indochina */}
                <path d="M 712,222 L 742,216 L 758,240 L 746,270 L 728,278 L 722,252 Z" />
                {/* Philippines Archipelago */}
                <path d="M 795,210 L 808,205 L 812,235 L 798,240 Z M 802,242 L 815,240 L 812,260 L 795,256 Z" />
                {/* Indonesian Archipelago */}
                <path d="M 718,284 L 752,278 L 782,290 L 748,300 Z M 758,264 L 788,258 L 792,284 L 762,286 Z M 790,294 L 838,290 L 842,304 L 792,306 Z M 846,284 L 892,278 L 905,300 L 850,304 Z" />

                {/* Australia Continent */}
                <path d="M 758,344 L 792,324 L 832,318 L 862,334 L 892,358 L 900,394 L 882,424 L 852,444 L 812,446 L 772,428 L 752,394 L 748,364 Z" />
                {/* Tasmania */}
                <path d="M 852,450 L 866,448 L 862,464 L 850,462 Z" />
                {/* New Zealand */}
                <path d="M 918,404 L 930,394 L 938,420 L 926,426 Z M 906,430 L 920,424 L 926,454 L 910,456 Z" />
              </g>

              {/* INTERCONNECTING GLOWING CURVED ARCS */}
              <g class="network-arcs" fill="none" stroke="#FF5A3D" stroke-width="2" stroke-opacity="0.7">
                <!-- US West to US East -->
                <path d="M 100 145 Q 165 110 235 135" />
                <!-- US East to Europe -->
                <path d="M 235 135 Q 340 85 450 110" />
                <!-- US East to South America -->
                <path d="M 235 135 Q 285 230 345 330" />
                <!-- Europe to Middle East -->
                <path d="M 450 110 Q 515 145 580 195" />
                <!-- Europe to Tokyo -->
                <path d="M 450 110 Q 660 70 870 150" />
                <!-- Middle East to Nairobi -->
                <path d="M 580 195 Q 568 235 565 280" />
                <!-- Middle East to Tokyo -->
                <path d="M 580 195 Q 725 130 870 150" />
                <!-- Middle East to Singapore -->
                <path d="M 580 195 Q 660 235 740 285" />
                <!-- Tokyo to Singapore -->
                <path d="M 870 150 Q 800 215 740 285" />
                <!-- Singapore to Sydney -->
                <path d="M 740 285 Q 805 345 870 410" />
              </g>

              {/* GLOWING ORANGE POP NETWORK NODES */}
              <!-- Node 1: US West (Seattle/SF) -->
              <g class="map-pop-node" transform="translate(100, 145)">
                <circle r="22" fill="#FF5A3D" opacity="0.35" filter="url(#auraHalo)" />
                <circle r="10" fill="#FF5A3D" filter="url(#nodeGlow)" />
                <circle r="5" fill="#FFFFFF" />
              </g>

              <!-- Node 2: US East (New York) -->
              <g class="map-pop-node" transform="translate(235, 135)">
                <circle r="26" fill="#FF5A3D" opacity="0.45" filter="url(#auraHalo)" />
                <circle r="12" fill="#FF5A3D" filter="url(#nodeGlow)" />
                <circle r="6" fill="#FFFFFF" />
              </g>

              <!-- Node 3: South America (São Paulo) -->
              <g class="map-pop-node" transform="translate(345, 330)">
                <circle r="22" fill="#FF5A3D" opacity="0.35" filter="url(#auraHalo)" />
                <circle r="10" fill="#FF5A3D" filter="url(#nodeGlow)" />
                <circle r="5" fill="#FFFFFF" />
              </g>

              <!-- Node 4: Europe (London/Frankfurt) -->
              <g class="map-pop-node" transform="translate(450, 110)">
                <circle r="26" fill="#FF5A3D" opacity="0.45" filter="url(#auraHalo)" />
                <circle r="12" fill="#FF5A3D" filter="url(#nodeGlow)" />
                <circle r="6" fill="#FFFFFF" />
              </g>

              <!-- Node 5: Middle East (Dubai) -->
              <g class="map-pop-node" transform="translate(580, 195)">
                <circle r="24" fill="#FF5A3D" opacity="0.38" filter="url(#auraHalo)" />
                <circle r="11" fill="#FF5A3D" filter="url(#nodeGlow)" />
                <circle r="5.5" fill="#FFFFFF" />
              </g>

              <!-- Node 6: East Africa (Nairobi) -->
              <g class="map-pop-node" transform="translate(565, 280)">
                <circle r="22" fill="#FF5A3D" opacity="0.35" filter="url(#auraHalo)" />
                <circle r="10" fill="#FF5A3D" filter="url(#nodeGlow)" />
                <circle r="5" fill="#FFFFFF" />
              </g>

              <!-- Node 7: East Asia (Tokyo) -->
              <g class="map-pop-node" transform="translate(870, 150)">
                <circle r="24" fill="#FF5A3D" opacity="0.38" filter="url(#auraHalo)" />
                <circle r="11" fill="#FF5A3D" filter="url(#nodeGlow)" />
                <circle r="5.5" fill="#FFFFFF" />
              </g>

              <!-- Node 8: Southeast Asia (Singapore) -->
              <g class="map-pop-node" transform="translate(740, 285)">
                <circle r="28" fill="#FF5A3D" opacity="0.5" filter="url(#auraHalo)" />
                <circle r="13" fill="#FF5A3D" filter="url(#nodeGlow)" />
                <circle r="6.5" fill="#FFFFFF" />
              </g>

              <!-- Node 9: Australia (Sydney) -->
              <g class="map-pop-node" transform="translate(870, 410)">
                <circle r="22" fill="#FF5A3D" opacity="0.35" filter="url(#auraHalo)" />
                <circle r="10" fill="#FF5A3D" filter="url(#nodeGlow)" />
                <circle r="5" fill="#FFFFFF" />
              </g>
            </svg>

            {/* FLOATING LATENCY TOOLTIP BADGE (SINGAPORE) */}
            <div class="map-singapore-badge">
              <span class="singapore-city">Singapore</span>
              <div class="singapore-ping">
                <span class="ping-dot"></span>
                <span class="ping-text">18ms</span>
              </div>
            </div>
          </div>

          {/* THREE INFRASTRUCTURE STATISTICS BAR */}
          <div class="network-stats-bar">
            <div class="stat-item">
              <span class="stat-num">100+</span>
              <span class="stat-lbl">Edge POPs</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
              <span class="stat-num">&lt;20ms</span>
              <span class="stat-lbl">Edge Latency</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
              <span class="stat-num">99.99%</span>
              <span class="stat-lbl">Availability</span>
            </div>
          </div>

        </div>
      </div>
    </div>

    {/* BOTTOM ROW: 4 x 3D FLIP CARDS GRID */}
    <div class="delivery-cards-grid">
      {/* CARD 1: CDN PULL ZONES */}
      <div class="flip-card-perspective">
        <div class="flip-card-inner" tabindex="0">
          {/* FRONT */}
          <div class="flip-card-front">
            <div class="card-top-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z" />
              </svg>
            </div>
            <h3 class="card-h3">CDN Pull Zones</h3>
            <p class="card-p">
              Multi-tenant pull zones on OpenResty, routed by Host. Full purge bumps a cache version; the next request is a MISS again, then HIT.
            </p>
            <div class="card-snippet">
              <span class="snip-part">request</span> → <span class="snip-part">edge</span> → <span class="snip-part miss">MISS</span> → <span class="snip-part hit">HIT</span>
            </div>
            <div class="flip-hint">Hover to flip card ↻</div>
          </div>

          {/* BACK (FLIPPED SPECS) */}
          <div class="flip-card-back">
            <span class="back-badge">OPENRESTY NGINX CORE</span>
            <h4 class="back-h4">CDN Technical Specs</h4>
            <ul class="back-specs-list">
              <li>✓ Multi-tenant Host header routing</li>
              <li>✓ Cache-Control &amp; ETag header parsing</li>
              <li>✓ Instant cache purge via version key</li>
              <li>✓ Zero origin request loop protection</li>
              <li>✓ Sub-10ms edge cache retrieval</li>
            </ul>
          </div>
        </div>
      </div>

      {/* CARD 2: STORAGE + IMAGE OPTIMIZER */}
      <div class="flip-card-perspective">
        <div class="flip-card-inner" tabindex="0">
          {/* FRONT */}
          <div class="flip-card-front">
            <div class="card-top-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <ellipse cx="12" cy="5" rx="9" ry="3" />
                <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" />
                <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
              </svg>
            </div>
            <h3 class="card-h3">Storage + Image Optimizer</h3>
            <p class="card-p">
              S3-style zones with presigned upload and a signed on-the-fly optimizer via imgproxy — resize, format, quality.
            </p>
            <div class="card-snippet highlight">
              <span class="snip-metric">39 KB JPEG → 2.9 KB WebP</span>
              <span class="snip-sub">@200px f/q/zs</span>
            </div>
            <div class="flip-hint">Hover to flip card ↻</div>
          </div>

          {/* BACK (FLIPPED SPECS) */}
          <div class="flip-card-back">
            <span class="back-badge">IMGPROXY + S3 CORE</span>
            <h4 class="back-h4">Storage &amp; Optimizer Specs</h4>
            <ul class="back-specs-list">
              <li>✓ S3-compatible REST API endpoints</li>
              <li>✓ On-the-fly image resizing &amp; cropping</li>
              <li>✓ Automatic AVIF &amp; WebP format selection</li>
              <li>✓ Presigned URL upload signatures</li>
              <li>✓ Zero egress charges on local storage</li>
            </ul>
          </div>
        </div>
      </div>

      {/* CARD 3: AUTHORITATIVE DNS */}
      <div class="flip-card-perspective">
        <div class="flip-card-inner" tabindex="0">
          {/* FRONT */}
          <div class="flip-card-front">
            <div class="card-top-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <line x1="2" y1="12" x2="22" y2="12" />
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
              </svg>
            </div>
            <h3 class="card-h3">Authoritative DNS</h3>
            <p class="card-p">
              Hickory serves your zones and records (A/AAAA/CNAME/TXT/MX/NS) straight from Postgres.
            </p>
            <div class="card-snippet cmd">
              <code>dig demo.ollanode.com</code>
              <span class="snip-sub">→ SOA + NS UDP · TCP · :53</span>
            </div>
            <div class="flip-hint">Hover to flip card ↻</div>
          </div>

          {/* BACK (FLIPPED SPECS) */}
          <div class="flip-card-back">
            <span class="back-badge">HICKORY + POSTGRES</span>
            <h4 class="back-h4">Authoritative DNS Specs</h4>
            <ul class="back-specs-list">
              <li>✓ Hickory DNS engine serving Port 53</li>
              <li>✓ Direct PostgreSQL record synchronization</li>
              <li>✓ Supports A, AAAA, CNAME, TXT, MX, NS</li>
              <li>✓ Sub-millisecond DNS query response</li>
              <li>✓ Built-in zone transfer protection</li>
            </ul>
          </div>
        </div>
      </div>

      {/* CARD 4: EDGE FUNCTIONS */}
      <div class="flip-card-perspective">
        <div class="flip-card-inner" tabindex="0">
          {/* FRONT */}
          <div class="flip-card-front">
            <div class="card-top-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="16 18 22 12 16 6" />
                <polyline points="8 6 2 12 8 18" />
              </svg>
            </div>
            <h3 class="card-h3">Edge Functions</h3>
            <p class="card-p">
              Deploy JS/TS and run it at the edge in a V8 isolate — no cold container, no server to manage.
            </p>
            <div class="card-snippet code">
              <code>GET /_fn/&lt;id&gt; → your code</code>
              <span class="snip-sub">V8 isolate · 200 OK</span>
            </div>
            <div class="flip-hint">Hover to flip card ↻</div>
          </div>

          {/* BACK (FLIPPED SPECS) */}
          <div class="flip-card-back">
            <span class="back-badge">V8 ISOLATE RUNTIME</span>
            <h4 class="back-h4">Edge Functions Specs</h4>
            <ul class="back-specs-list">
              <li>✓ Sub-millisecond V8 Isolate cold start</li>
              <li>✓ Native JavaScript &amp; TypeScript execution</li>
              <li>✓ Edge request/response transformation</li>
              <li>✓ Zero container overhead or server management</li>
              <li>✓ Sandboxed memory security model</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
