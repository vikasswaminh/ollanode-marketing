---
// src/components/FaqSection.astro

interface FaqItem {
  id: string;
  question: string;
  answer: string;
}

const faqs: FaqItem[] = [
  {
    id: 'faq-1',
    question: 'Is there live streaming?',
    answer: "No — it's a VOD pipeline only. There's no live / RTMP ingest. OllaNode is purpose-built for rock-solid on-demand transcoding, asset generation, private origin shielding, and edge delivery."
  },
  {
    id: 'faq-2',
    question: 'HLS or DASH?',
    answer: 'HLS today. Segments are already CMAF/fMP4 (DASH-ready packaging); a DASH manifest is the remaining piece. It delivers an adaptive resolution ladder from 360p up to 4K.'
  },
  {
    id: 'faq-3',
    question: 'How does pricing work?',
    answer: "It's self-hosted software you run on your own hardware. There's no billing system and no metered plans — the cost is your infrastructure."
  },
  {
    id: 'faq-4',
    question: "What's off by default?",
    answer: 'AI metadata, speaker diarization, GPU-accelerated H.265, loudness normalization and an AV1 tier are all real but config/hardware-gated and off by default.'
  },
  {
    id: 'faq-5',
    question: 'How is it licensed?',
    answer: 'Apache-2.0, with permissive-OSS-only dependencies (no AGPL) — every component is permissively licensed and auditable.'
  },
  {
    id: 'faq-6',
    question: "Where's the API described?",
    answer: 'Machine-readable at GET /openapi.json (OpenAPI 3.1), with MCP (Model Context Protocol) for agents and full /v1/whoami capability inspection.'
  },
  {
    id: 'faq-7',
    question: 'Is it managed or self-hosted?',
    answer: 'Ownership-first software. You bring the VMs and storage, OllaNode provides the platform control plane.'
  },
  {
    id: 'faq-8',
    question: 'Can AI agents execute admin tasks?',
    answer: 'No — agent keys are structurally prevented from holding admin, managing credentials, or accessing billing. Destructive mutations require explicit human approval.'
  }
];
---

<section class="faq-section" id="faq">
  <!-- Subtle light grid overlay -->
  <div class="faq-grid-bg" aria-hidden="true"></div>

  <div class="faq-wrap">
    
    <!-- SECTION HEADER -->
    <div class="faq-header">
      <div class="faq-badge-pill">
        <span>FREQUENTLY ASKED QUESTIONS</span>
      </div>
      <p class="faq-subtitle">
        Clear answers on platform boundaries, licensing, pricing, and infrastructure architecture — straight from the official source.
      </p>

    </div>

    <!-- 2-COLUMN FAQ ACCORDION GRID -->
    <div class="faq-grid" id="faq-accordion-list">
      {faqs.map((faq) => (
        <div class="faq-card" id={faq.id} data-state="closed">
          <button
            class="faq-card-btn"
            type="button"
            aria-expanded="false"
            aria-controls={`faq-body-${faq.id}`}
          >
            <h3 class="faq-card-question">{faq.question}</h3>
            
            <div class="faq-chevron-wrap" aria-hidden="true">
              <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </button>
          
          <div class="faq-card-body" id={`faq-body-${faq.id}`}>
            <div class="faq-body-inner">
              <p class="faq-answer-text">{faq.answer}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- BOTTOM HELP BOX -->
    <div class="faq-support-box">
      <div class="faq-support-left">
        <div class="faq-support-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
        </div>
        <div>
          <h4 class="faq-support-title">Still have questions?</h4>
          <p class="faq-support-desc">Can't find what you're looking for? Reach out or dive straight into our technical guides.</p>
        </div>
      </div>
      <div class="faq-support-actions">
        <a href="/docs" class="faq-support-btn-secondary">READ DOCUMENTATION</a>
        <a href="https://login.ollanode.com" class="faq-support-btn-primary">START BUILDING</a>
      </div>
    </div>

  </div>
</section>

<style>
  .faq-section {
    position: relative;
    background-color: #FFFFFF;
    padding: 85px 0 95px;
    border-top: 1px solid #E2E8F0;
    overflow: hidden;
  }

  /* SUBTLE LIGHT GRID BACKGROUND */
  .faq-grid-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background-image: 
      linear-gradient(to right, rgba(255, 90, 61, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 90, 61, 0.05) 1px, transparent 1px);
    background-size: 36px 36px;
    -webkit-mask-image: radial-gradient(ellipse 85% 75% at 50% 30%, #000 45%, transparent 95%);
    mask-image: radial-gradient(ellipse 85% 75% at 50% 30%, #000 45%, transparent 95%);
  }

  .faq-wrap {
    position: relative;
    z-index: 1;
    max-width: var(--maxw, 1260px);
    margin: 0 auto;
    padding: 0 var(--gutter, clamp(20px, 4vw, 40px));
  }

  /* HEADER */
  .faq-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 42px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* FILLED BADGE LIKE REFERENCE IMAGE */
  .faq-badge-pill {
    display: inline-block;
    background: linear-gradient(135deg, #FF7A4D 0%, #FF5A3D 45%, #D43210 100%);
    color: #FFFFFF;
    font-family: var(--sans, sans-serif);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 10px 24px;
    border-radius: 6px;
    box-shadow: 0 4px 16px rgba(255, 90, 61, 0.32);
    margin-bottom: 20px;
  }

  .faq-subtitle {
    font-family: var(--sans, 'Inter', sans-serif);
    font-size: clamp(0.98rem, 1.15vw, 1.1rem);
    font-weight: 500;
    color: #475569;
    line-height: 1.6;
    margin: 0 auto 28px;
    max-width: 680px;
  }

  /* 2-COLUMN GRID */
  .faq-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 48px;
    align-items: start;
  }

  /* FAQ CARD - GREY BORDER */
  .faq-card {
    background: #FFFFFF;
    border: 1.5px solid #CBD5E1;
    border-radius: 12px;
    box-shadow: 0 10px 30px -4px rgba(15, 23, 42, 0.08), 0 4px 12px -2px rgba(15, 23, 42, 0.05);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }

  .faq-card:hover {
    border-color: #94A3B8;
    box-shadow: 0 18px 40px -6px rgba(15, 23, 42, 0.12), 0 6px 16px -2px rgba(15, 23, 42, 0.06);
    transform: translateY(-2px);
  }

  .faq-card[data-state="open"] {
    border-color: #94A3B8;
    background: #FFFFFF;
    box-shadow: 0 18px 40px -4px rgba(15, 23, 42, 0.12), 0 6px 16px rgba(15, 23, 42, 0.06);
  }

  /* BUTTON TRIGGER */
  .faq-card-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: background-color 0.2s ease;
  }

  .faq-card[data-state="open"] .faq-card-btn {
    background: #FFFDFD;
  }

  .faq-card-question {
    font-family: var(--sans, sans-serif);
    font-size: 16.5px;
    font-weight: 700;
    color: #0F172A;
    line-height: 1.35;
    letter-spacing: -0.015em;
    margin: 0;
    flex: 1;
    transition: color 0.2s ease;
  }

  .faq-card[data-state="open"] .faq-card-question {
    color: #FF5A3D;
  }

  /* CHEVRON ICON */
  .faq-chevron-wrap {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    display: grid;
    place-items: center;
    color: #64748B;
    flex-shrink: 0;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-chevron {
    width: 16px;
    height: 16px;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-card:hover .faq-chevron-wrap {
    background: #FFF0EB;
    border-color: #FFD6CC;
    color: #FF5A3D;
  }

  .faq-card[data-state="open"] .faq-chevron-wrap {
    background: #FF5A3D;
    border-color: #FF5A3D;
    color: #FFFFFF;
  }

  .faq-card[data-state="open"] .faq-chevron {
    transform: rotate(180deg);
  }

  /* COLLAPSIBLE BODY */
  .faq-card-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-card[data-state="open"] .faq-card-body {
    grid-template-rows: 1fr;
  }

  .faq-body-inner {
    overflow: hidden;
    padding: 0 24px 20px 24px;
    border-top: 1px dashed rgba(226, 232, 240, 0.8);
    margin-top: -2px;
    padding-top: 16px;
  }

  .faq-answer-text {
    font-family: var(--sans, sans-serif);
    font-size: 14.5px;
    color: #475569;
    line-height: 1.65;
    margin: 0;
  }

  /* BOTTOM SUPPORT BANNER */
  .faq-support-box {
    background: #FFFFFF;
    border: 2px solid #CBD5E1;
    border-radius: 16px;
    padding: 26px 34px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    box-shadow: 0 12px 34px -4px rgba(15, 23, 42, 0.1), 0 4px 12px rgba(15, 23, 42, 0.05);
    flex-wrap: wrap;
  }

  .faq-support-left {
    display: flex;
    align-items: center;
    gap: 18px;
    max-width: 650px;
  }

  .faq-support-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: #FFF0EB;
    border: 1px solid #FFD6CC;
    display: grid;
    place-items: center;
    color: #FF5A3D;
    flex-shrink: 0;
  }

  .faq-support-icon svg {
    width: 24px;
    height: 24px;
  }

  .faq-support-title {
    font-family: var(--sans, sans-serif);
    font-size: 17px;
    font-weight: 700;
    color: #0F172A;
    margin: 0 0 4px 0;
  }

  .faq-support-desc {
    font-family: var(--sans, sans-serif);
    font-size: 14px;
    color: #64748B;
    margin: 0;
    line-height: 1.5;
  }

  .faq-support-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .faq-support-btn-primary {
    background: linear-gradient(135deg, #FF6A3D 0%, #FF4B24 45%, #D43210 100%);
    color: #FFFFFF;
    font-family: var(--sans, sans-serif);
    font-size: 13px;
    font-weight: 700;
    padding: 11px 22px;
    border-radius: 8px;
    border: 1px solid #D43210;
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: all 0.25s ease;
    box-shadow: 0 4px 16px rgba(255, 75, 36, 0.32);
    white-space: nowrap;
  }

  .faq-support-btn-primary:hover {
    background: linear-gradient(135deg, #FF7A4D 0%, #FF5A30 45%, #E23916 100%);
    border-color: #E23916;
    transform: translateY(-1.5px);
    box-shadow: 0 6px 22px rgba(255, 75, 36, 0.48);
  }

  .faq-support-btn-secondary {
    background: #F8FAFC;
    color: #0F172A;
    border: 1.5px solid #CBD5E1;
    font-family: var(--sans, sans-serif);
    font-size: 13px;
    font-weight: 700;
    padding: 11px 22px;
    border-radius: 8px;
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .faq-support-btn-secondary:hover {
    background: #EFF6FF;
    border-color: #94A3B8;
    color: #0F172A;
    transform: translateY(-1.5px);
  }

  /* RESPONSIVE */
  @media (max-width: 960px) {
    .faq-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }

  @media (max-width: 768px) {
    .faq-section {
      padding: 54px 0 64px;
    }

    .faq-head {
      margin-bottom: 28px;
    }

    .faq-h2 {
      font-size: clamp(1.8rem, 6.5vw, 2.3rem);
    }

    .faq-support-box {
      padding: 22px;
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    .faq-support-left {
      gap: 14px;
    }

    .faq-support-actions {
      width: 100%;
    }

    .faq-support-btn-primary,
    .faq-support-btn-secondary {
      width: 100%;
      text-align: center;
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .faq-section {
      padding: 42px 0 52px;
    }

    .faq-card-btn {
      padding: 15px 16px;
      gap: 12px;
    }

    .faq-card-question {
      font-size: 14.5px;
    }

    .faq-chevron-wrap {
      width: 28px;
      height: 28px;
    }

    .faq-chevron {
      width: 14px;
      height: 14px;
    }

    .faq-body-inner {
      padding: 0 16px 16px;
      padding-top: 14px;
    }

    .faq-answer-text {
      font-size: 13.5px;
    }

    .faq-support-left {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }
</style>

<script is:inline>
  (function () {
    function initFaq() {
      var cards = document.querySelectorAll('.faq-card');
      if (!cards.length) return;

      function setCardState(card, isOpen) {
        var btn = card.querySelector('.faq-card-btn');
        if (isOpen) {
          card.setAttribute('data-state', 'open');
          if (btn) btn.setAttribute('aria-expanded', 'true');
        } else {
          card.setAttribute('data-state', 'closed');
          if (btn) btn.setAttribute('aria-expanded', 'false');
        }
      }

      // Individual Card Click
      cards.forEach(function (card) {
        var btn = card.querySelector('.faq-card-btn');
        if (!btn) return;

        btn.addEventListener('click', function () {
          var isOpen = card.getAttribute('data-state') === 'open';
          setCardState(card, !isOpen);
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFaq);
    } else {
      initFaq();
    }
  })();
</script>
