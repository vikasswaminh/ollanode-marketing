<script is:inline>
(function () {
  function initPipelineSimulation() {
    var btn = document.getElementById('run-pipeline-sim');
    var btnText = document.getElementById('sim-btn-text');
    var logElem = document.getElementById('arch-terminal-log');
    if (!btn || !btnText || !logElem) return;

    var stage1 = document.getElementById('stage-1');
    var stage2 = document.getElementById('stage-2');
    var stage3 = document.getElementById('stage-3');
    var stage4 = document.getElementById('stage-4');
    var stage5 = document.getElementById('stage-5');

    var conn1 = document.getElementById('conn-1');
    var conn2 = document.getElementById('conn-2');
    var conn3 = document.getElementById('conn-3');
    var conn4 = document.getElementById('conn-4');

    var isRunning = false;

    var steps = [
      {
        stage: stage1,
        conn: conn1,
        msg: 'POST /v1/videos payload received via TUS upload conduit (video_4k.mp4)...',
        delay: 800
      },
      {
        stage: stage2,
        conn: conn2,
        msg: 'OllaNode Hub orchestrator: HMAC validated. Job queued on Rust async event bus...',
        delay: 900
      },
      {
        stage: stage3,
        conn: conn3,
        msg: 'Workers: Generating 360p→4K HLS ladders + S3 storage push + DNS :53 sync...',
        delay: 1100
      },
      {
        stage: stage4,
        conn: conn4,
        msg: 'Global CDN edge pull zones populated. Sub-150ms instant purge cache primed...',
        delay: 900
      },
      {
        stage: stage5,
        conn: null,
        msg: 'Stream ready. Expiring token validated. Delivering 4K HLS to player & MCP Agents.',
        delay: 1000
      }
    ];

    function clearAllStates() {
      [stage1, stage2, stage3, stage4, stage5].forEach(function (s) {
        if (s) s.classList.remove('is-active');
      });
      [conn1, conn2, conn3, conn4].forEach(function (c) {
        if (c) c.classList.remove('is-flowing');
      });
    }

    function runStep(index) {
      if (index >= steps.length) {
        setTimeout(function () {
          clearAllStates();
          btn.disabled = false;
          btnText.innerText = 'Replay Simulation ↻';
          isRunning = false;
        }, 1200);
        return;
      }

      var curr = steps[index];
      clearAllStates();
      if (curr.stage) curr.stage.classList.add('is-active');
      if (curr.conn) curr.conn.classList.add('is-flowing');

      logElem.innerHTML = '<span class="term-prompt">$</span> <span class="term-msg">' + curr.msg + '</span>';

      setTimeout(function () {
        runStep(index + 1);
      }, curr.delay);
    }

    btn.addEventListener('click', function (e) {
      e.preventDefault();
      if (isRunning) return;
      isRunning = true;
      btn.disabled = true;
      btnText.innerText = 'Simulating Pipeline...';
      clearAllStates();
      runStep(0);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPipelineSimulation);
  } else {
    initPipelineSimulation();
  }
})();
</script>
