---
---

<section class="blog-hero-sec">
  <div class="wrap">
    <div class="blog-hero-content">
      <div class="blog-eyebrow">
        <span class="blog-badge">OLLANODE ENGINEERING &amp; INSIGHTS</span>
        <span class="blog-live-pulse"></span>
      </div>

      <h1 class="blog-hero-title">
        Engineering, AI &amp; Network Infrastructure
      </h1>

      <p class="blog-hero-desc">
        Deep dives into self-hosted VOD pipelines, Anycast CDN pull zones, AI agent governance guardrails, and Rust edge platform architecture.
      </p>

      <!-- SEARCH DISCOVERY BAR -->
      <div class="blog-search-wrap">
        <div class="blog-search-box">
          <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          <input
            type="text"
            id="blog-search-input"
            class="blog-search-input"
            placeholder="Search articles by topic, keyword, or technology (e.g. AI, Rust, CDN, DNS)..."
            aria-label="Search articles"
          />
          <button id="blog-search-clear" class="search-clear-btn" aria-label="Clear search" style="display: none;">
            ✕
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
