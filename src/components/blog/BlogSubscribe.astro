<section class="blog-subscribe-sec">
  <div class="wrap">
    <div class="subscribe-card">
      <div class="subscribe-content">
        <span class="eyebrow center-eyebrow">DEVELOPER UPDATES</span>
        <h2 class="sub-h2">Stay Ahead of Video &amp; Edge Infrastructure Patterns</h2>
        <p class="sub-p">
          Get engineering deep dives, performance benchmarks, and self-hosted release notes delivered straight to your inbox once a month. No spam.
        </p>

        <form class="sub-form" onsubmit="event.preventDefault(); alert('Thank you for subscribing to Ollanode Engineering Insights!');">
          <input
            type="email"
            class="sub-input"
            placeholder="Enter your engineering email address..."
            required
            aria-label="Email address for engineering updates"
          />
          <button type="submit" class="btn btn-primary chamfer-sm">
            Subscribe Updates
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
