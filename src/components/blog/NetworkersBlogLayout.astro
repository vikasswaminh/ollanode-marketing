  .subcard-desc {
    font-size: 0.76rem;
    color: #64748B;
    line-height: 1.4;
    margin: 0 0 0.45rem;
    display: -webkit-box;
    -webkit-line-clamp: 2; /* Little concise contents */
    -webkit-box-orient: vertical;
    overflow: hidden;
    word-break: break-word;
  }

  .subcard-meta-footer {
    margin-top: auto;
    padding-top: 0.5rem;
