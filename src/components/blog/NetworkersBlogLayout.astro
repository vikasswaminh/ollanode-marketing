---
import {
  getAllBlogArticles,
  getFeaturedBlogArticle,
  getLeftSidebarArticles,
  OLLANODE_BLOG_CATEGORIES,
} from '../../data/blogArticles';

const articles = await getAllBlogArticles();
const mainFeatured = await getFeaturedBlogArticle();
const leftSidebarArticles = await getLeftSidebarArticles();
const gridArticles = mainFeatured
  ? articles.filter((a) => a.id !== mainFeatured.id)
  : articles;
---

<div class="blog-page-wrapper">
  
  <!-- CATEGORY STRIP BELOW HEADER WITH RIGHT-ALIGNED SEARCH BAR -->
  <div class="blog-category-strip">
    <div class="net-blog-container">
      <div class="category-strip-inner">
        <!-- LEFT: CATEGORIES NAVIGATION -->
        <div class="cat-strip-links" role="tablist" aria-label="Blog categories">
          {OLLANODE_BLOG_CATEGORIES.map((cat, idx) => (
            <button
              class={`cat-strip-btn ${idx === 0 ? 'active' : ''}`}
              data-category={cat}
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
            >
              {cat}
            </button>
          ))}
        </div>

        <!-- RIGHT: SEARCH BAR -->
        <div class="blog-search-wrap">
          <svg class="blog-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input
            type="text"
            id="blog-search-input"
            class="blog-search-input"
            placeholder="Search articles..."
            aria-label="Search articles"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- MAIN 3-COLUMN BLOG SECTION -->
  <section class="net-blog-section">
    <div class="net-blog-container">
      <div class="net-blog-grid">

        <!-- LEFT COLUMN: FEATURED INSIGHTS (STICKY BOX) -->
        <aside class="net-col-left">
          <div class="featured-box-card">
            <div class="pill-badge pill-orange">FEATURED</div>
            
            {leftSidebarArticles.length > 0 ? (
              <ul class="net-link-list">
                {leftSidebarArticles.map((item) => (
                  <li>
                    <a href={`/blog/${item.slug || item.id}`} class="net-link">{item.data.title}</a>
                  </li>
                ))}
              </ul>
            ) : (
              <ul class="net-link-list">
                <li><span class="net-link-placeholder">No featured articles yet</span></li>
              </ul>
            )}
            
            <a href="/docs" class="view-all-link">Explore Docs →</a>
          </div>
        </aside>

        <!-- CENTER COLUMN: MAIN CONTENT & LATEST ARTICLES -->
        <main class="net-col-center">
          <!-- CENTER HEADER -->
          <div class="center-header">
            <h1 class="center-h1">Ollanode Engineering &amp; Insights</h1>
            <p class="center-sub">Technical deep dives, architecture patterns &amp; self-hosted infrastructure updates</p>
          </div>

          <!-- LATEST ARTICLES BADGE STRIP -->
          <div class="section-label-strip">
            <span class="pill-badge pill-orange-filled">🔥 LATEST ARTICLES</span>
            <span class="strip-text" id="article-count-label">Showing {articles.length} article{articles.length === 1 ? '' : 's'}</span>
          </div>

          <!-- HERO FEATURED ARTICLE CARD (Automatic from Content Collection) -->
          {mainFeatured ? (
            <div
              class="hero-article-card blog-item-card"
              data-href={`/blog/${mainFeatured.slug || mainFeatured.id}`}
              data-category={mainFeatured.data.category}
              data-title={mainFeatured.data.title.toLowerCase()}
              data-excerpt={mainFeatured.data.excerpt.toLowerCase()}
              data-tags={(mainFeatured.data.tags || []).join(' ').toLowerCase()}
            >
              {mainFeatured.data.image && (
                <div class="hero-card-img-wrap">
                  <img
                    src={mainFeatured.data.image}
                    alt={mainFeatured.data.title}
                    class="hero-card-img"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="hero-card-body">
                <span class="hero-new-tag">🔥 FEATURED</span>
                <span class="pill-badge pill-category">{mainFeatured.data.category}</span>
                <h2 class="hero-card-title">
                  <a href={`/blog/${mainFeatured.slug || mainFeatured.id}`}>{mainFeatured.data.title}</a>
                </h2>
                <p class="hero-card-excerpt">{mainFeatured.data.excerpt}</p>
                <div class="hero-card-meta">
                  <span>{mainFeatured.data.publishedDate}</span>
                  <span class="meta-sep">•</span>
                  <span>{mainFeatured.data.readingTime}</span>
                  <span class="meta-sep">•</span>
                  <a href={`/blog/${mainFeatured.slug || mainFeatured.id}`} class="read-article-link">Read article →</a>
                </div>
              </div>
            </div>
          ) : (
            <div class="hero-article-card hero-placeholder-card">
              <div class="hero-card-body">
                <span class="hero-new-tag">WAITING FOR CONTENT</span>
                <span class="pill-badge pill-category">Engineering</span>
                <h2 class="hero-card-title">No Featured Article Yet</h2>
                <p class="hero-card-excerpt">Add your first markdown article with featured: true in src/content/blog/ to display it here automatically.</p>
              </div>
            </div>
          )}

          <!-- NEWEST ARTICLES 3-COLUMN GRID (Automatic from Content Collection) -->
          <div class="newest-grid" id="blog-grid-cards">
            {gridArticles.map((art) => (
              <article
                class="grid-card blog-item-card"
                data-href={`/blog/${art.slug || art.id}`}
                data-category={art.data.category}
                data-title={art.data.title.toLowerCase()}
                data-excerpt={art.data.excerpt.toLowerCase()}
                data-tags={(art.data.tags || []).join(' ').toLowerCase()}
              >
                <span class="pill-badge pill-category-sm">{art.data.category}</span>
                <h3 class="grid-card-title">
                  <a href={`/blog/${art.slug || art.id}`}>{art.data.title}</a>
                </h3>
                <p class="grid-card-excerpt">{art.data.excerpt}</p>
                <div class="grid-card-footer">
                  <span class="grid-card-readtime">{art.data.readingTime}</span>
                  <a href={`/blog/${art.slug || art.id}`} class="read-more-sm">Read →</a>
                </div>
              </article>
            ))}
          </div>

          <!-- EMPTY CATEGORY / SEARCH FILTER STATE -->
          <div id="blog-empty-state" class="blog-empty-card" style="display: none;">
            <div class="empty-icon">🔍</div>
            <h3 class="empty-h3">No matching articles found</h3>
            <p class="empty-p">Try adjusting your search query or selecting a different category filter.</p>
            <button id="reset-filters-btn" class="reset-btn">Clear Search &amp; Show All</button>
          </div>

        </main>

        <!-- RIGHT COLUMN: RESTRUCTURED STICKY SIDEBAR -->
        <aside class="net-col-right">
          <!-- A. QUICK JUMP LINKS -->
          <div class="right-sidebar-block">
            <div class="pill-badge pill-purple">QUICK JUMP</div>
            <ul class="bullet-list-cols">
              <li><a href="/#platform-capabilities" class="bullet-link-item">Video</a></li>
              <li><a href="/docs/cdn" class="bullet-link-item">CDN &amp; Delivery</a></li>
              <li><a href="/#agent-native" class="bullet-link-item">AI &amp; Agents</a></li>
              <li><a href="/docs/edge-functions" class="bullet-link-item">Edge</a></li>
              <li><a href="/#how-it-works" class="bullet-link-item">Engineering</a></li>
              <li><a href="/docs" class="bullet-link-item">Security</a></li>
              <li><a href="/#delivery-edge" class="bullet-link-item">Performance</a></li>
              <li><a href="/#start" class="bullet-link-item">Updates</a></li>
            </ul>
          </div>

          <!-- B. PRICING SECTION -->
          <div class="right-sidebar-block">
            <div class="pill-badge pill-purple">PRICING</div>
            <ul class="capsule-grid">
              <li><a href="/pricing" class="capsule-link">Self-Host: Free</a></li>
              <li><a href="/pricing" class="capsule-link">Managed: Custom</a></li>
              <li><a href="/pricing" class="capsule-link">No Per-Min Fees</a></li>
              <li><a href="/pricing" class="capsule-link">Apache-2.0 OSS</a></li>
              <li><a href="/pricing" class="capsule-link">Unlimited Videos</a></li>
              <li><a href="/pricing" class="capsule-link">View Tiers →</a></li>
            </ul>
          </div>


          <!-- C. CONTACT SECTION -->
          <div class="right-sidebar-block contact-card">
            <div class="pill-badge pill-purple">CONTACT</div>
            <a href="mailto:hello@ollanode.com" class="btn-contact-eng">Contact Engineering</a>
          </div>
        </aside>


      </div>
    </div>
  </section>
</div>

<!-- CLIENT-SIDE COMBINED CATEGORY STRIP & SEARCH FILTERING SCRIPT -->
<script>
  // Astro bundles this script as a module and automatically defers it until the DOM is ready.
  // It is immune to Cloudflare Rocket Loader and caching lifecycle bugs.
  
  const catBtns = document.querySelectorAll('.cat-strip-btn');
  const itemCards = document.querySelectorAll('.blog-item-card');
  const emptyState = document.getElementById('blog-empty-state');
  const resetBtn = document.getElementById('reset-filters-btn');
  const searchInput = document.getElementById('blog-search-input');
  const countLabel = document.getElementById('article-count-label');

  if (catBtns.length > 0 && itemCards.length > 0) {
    let currentCategory = 'All';
    let searchQuery = '';

    function normalizeCat(str) {
      if (!str) return '';
      let s = str.toLowerCase()
        .replace(/&amp;/g, 'and')
        .replace(/&/g, 'and')
        .replace(/[^a-z0-9]/g, '')
        .trim();
      if (s.endsWith('s') && s.length > 3) {
        s = s.slice(0, -1);
      }
      return s;
    }

    function isCategoryMatch(cardCat, selectedCategory) {
      if (!selectedCategory || selectedCategory.toLowerCase().trim() === 'all') return true;
      const normSel = normalizeCat(selectedCategory);
      const normCard = normalizeCat(cardCat);
      if (!normSel || !normCard) return false;
      return normCard === normSel || normCard.includes(normSel) || normSel.includes(normCard);
    }

    function filterArticles() {
      let visibleCount = 0;
      const query = searchQuery.trim().toLowerCase();

      itemCards.forEach(card => {
        const cat = card.getAttribute('data-category') || '';
        const title = card.getAttribute('data-title') || '';
        const excerpt = card.getAttribute('data-excerpt') || '';
        const tags = card.getAttribute('data-tags') || '';

        const matchesCategory = isCategoryMatch(cat, currentCategory);
        const matchesSearch = !query ||
          title.toLowerCase().includes(query) ||
          excerpt.toLowerCase().includes(query) ||
          cat.toLowerCase().includes(query) ||
          tags.toLowerCase().includes(query);

        if (matchesCategory && matchesSearch) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (countLabel) {
        countLabel.textContent = 'Showing ' + visibleCount + ' article' + (visibleCount === 1 ? '' : 's');
      }

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    // Bind card clicks
    itemCards.forEach(card => {
      card.style.cursor = 'pointer';
      card.addEventListener('click', (e) => {
        const href = card.getAttribute('data-href');
        if (href && !e.target.closest('a')) {
          window.location.href = href;
        }
      });
    });

    // Bind category buttons
    catBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        catBtns.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        currentCategory = btn.getAttribute('data-category') || 'All';
        filterArticles();
      });
    });

    // Bind search
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value || '';
        filterArticles();
      });
    }

    // Bind reset
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        currentCategory = 'All';
        searchQuery = '';
        if (searchInput) searchInput.value = '';

        catBtns.forEach((b, idx) => {
          if (idx === 0) {
            b.classList.add('active');
            b.setAttribute('aria-selected', 'true');
          } else {
            b.classList.remove('active');
            b.setAttribute('aria-selected', 'false');
          }
        });

        filterArticles();
      });
    }
    
    // Initial filter run
    filterArticles();
  }
</script>

