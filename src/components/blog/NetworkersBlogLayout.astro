---
import {
  getAllBlogArticles,
  getFeaturedBlogArticle,
  getLeftSidebarArticles,
} from '../../data/blogArticles';

const articles = await getAllBlogArticles();
const mainFeatured = await getFeaturedBlogArticle();
const leftSidebarArticles = await getLeftSidebarArticles();
const gridArticles = mainFeatured
  ? articles.filter((a) => a.id !== mainFeatured.id)
  : articles;

// Canonical categories with slug mappings and compact short labels for capsules
const allCategories = [
  { name: 'All', slug: 'all', short: 'All' },
  { name: 'Video Infrastructure & Developer Platforms', slug: 'video-infra', short: 'Video Infra' },
  { name: 'Video & CDN', slug: 'video-cdn', short: 'Video & CDN' },
  { name: 'Product & Changelog', slug: 'product', short: 'Product' },
  { name: 'Guides', slug: 'guides', short: 'Guides' },
  { name: 'Comparisons', slug: 'comparisons', short: 'Comparisons' },
  { name: 'AI & Agents', slug: 'ai', short: 'AI & Agents' },
  { name: 'Engineering', slug: 'engineering', short: 'Engineering' },
];

function getCategorySlug(cat: string | undefined): string {
  if (!cat) return 'engineering';
  const c = cat.toLowerCase().trim();
  if (c.includes('developer platform') || c.includes('infrastructure & developer') || c.includes('architecture') || c.includes('observability')) {
    return 'video-infra';
  }
  if (c.includes('video & cdn') || c.includes('cdn') || c.includes('streaming')) {
    return 'video-cdn';
  }
  if (c.includes('product') || c.includes('changelog')) {
    return 'product';
  }
  if (c.includes('guide') || c.includes('tutorial')) {
    return 'guides';
  }
  if (c.includes('comparison') || c.includes('vs') || c.includes('alternative')) {
    return 'comparisons';
  }
  if (c.includes('ai') || c.includes('agent')) {
    return 'ai';
  }
  if (c.includes('engineering') || c.includes('transcoding pipeline') || c.includes('rust')) {
    return 'engineering';
  }
  return 'engineering';
}

// Archive category groups
const archiveGroups = new Map<string, typeof articles>();
articles.forEach((art) => {
  const cat = art.data.category || 'Engineering';
  if (!archiveGroups.has(cat)) {
    archiveGroups.set(cat, []);
  }
  archiveGroups.get(cat)!.push(art);
});
const archiveList = Array.from(archiveGroups.entries());
---

<div class="blog-page-wrapper">
  <!-- 1. STICKY CATEGORY CHIPS STRIP (WITH SKY BLUE DARK & LIGHT GRADIENT) -->
  <nav class="category-strip" aria-label="Blog Categories">
    <div class="container-wide">
      <div class="category-strip-inner">
        {allCategories.map((cat, idx) => (
          <button
            type="button"
            class={`category-chip ${idx === 0 ? 'active' : ''}`}
            data-cat={cat.slug}
          >
            {cat.name}
          </button>
        ))}
      </div>
    </div>
  </nav>

  <!-- 2. MAIN 3-COLUMN BLOG LAYOUT SECTION -->
  <section id="articles" class="blog-layout-section">
    <div class="container-wide">
      <div class="nh-layout-grid">

        <!-- LEFT STICKY SIDEBAR: Featured Recent Blogs (Purple Badge) -->
        <aside class="sidebar-col sidebar-left">
          <div class="sticky-sidebar">
            <span class="badge-pill founder-badge-purple">FEATURED</span>
            <ul class="article-links-list">
              {leftSidebarArticles.map((item) => (
                <li>
                  <a
                    href={`/blog/${item.slug || item.id}`}
                    class="link-item"
                    title={item.data.title}
                  >
                    {item.data.title}
                  </a>
                </li>
              ))}
            </ul>
            <a href="#archive" class="view-all-btn-purple">View All →</a>
          </div>
        </aside>

        <!-- CENTER COLUMN: Middle Scrolling Blog Feed -->
        <main class="feed-col">
          <!-- Section Title Header inside Middle Feed Column -->
          <div class="feed-header-wrap">
            <h1 class="feed-section-title">OllaNode Infrastructure &amp; Engineering Blog</h1>
            <p class="feed-section-subtitle">
              Expert articles on video delivery, edge compute, AI infrastructure &amp; cloud storage
            </p>
          </div>

          <!-- Sub-header bar -->
          <div class="newest-header-bar">
            <span class="badge-pill newest-badge">
              <svg class="flame-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 23c-4.97 0-9-3.58-9-8 0-4.19 3.01-7.26 5.88-10.12.55-.55 1.12-1.09 1.67-1.65.34-.35.88-.23 1.05.21.68 1.76 1.95 3.39 3.2 4.41 1.72 1.41 3.2 2.65 3.2 5.15 0 .68-.09 1.34-.26 1.97-.1.35.21.68.56.59 1.54-.38 2.7-1.46 3.23-2.86.09-.23.4-.29.56-.1 1.25 1.52 1.91 3.27 1.91 5.4 0 4.42-4.03 8-9 8zm-1.87-4.47c1.78.68 3.51.15 4.31-.61.47-.45.74-1.07.78-1.72.03-.59-.19-1.2-.56-1.74-.53-.78-1.42-1.57-2.34-2.39-.77.85-1.54 1.83-1.89 2.92-.37 1.14-.23 2.5.7 3.54z"/>
              </svg>
              NEWEST ARTICLES
            </span>
            <span class="newest-subtitle-text">Latest from our experts</span>
          </div>

          <!-- Featured Main Hero Card -->
          {mainFeatured && (
            <a
              id="featured"
              href={`/blog/${mainFeatured.slug || mainFeatured.id}`}
              class="featured-main-card featured-main-card-no-img"
              data-category={getCategorySlug(mainFeatured.data.category)}
              aria-label={`Read featured post: ${mainFeatured.data.title}`}
            >
              <div class="featured-content-wrapper">
                <div class="featured-top-tag">
                  <span class="pill-tag-new">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 23c-4.97 0-9-3.58-9-8 0-4.19 3.01-7.26 5.88-10.12.55-.55 1.12-1.09 1.67-1.65.34-.35.88-.23 1.05.21.68 1.76 1.95 3.39 3.2 4.41 1.72 1.41 3.2 2.65 3.2 5.15 0 .68-.09 1.34-.26 1.97-.1.35.21.68.56.59 1.54-.38 2.7-1.46 3.23-2.86.09-.23.4-.29.56-.1 1.25 1.52 1.91 3.27 1.91 5.4 0 4.42-4.03 8-9 8z"/>
                    </svg>
                    FEATURED
                  </span>
                </div>
                <div class="featured-category-badge">{mainFeatured.data.category}</div>
                <h3 class="featured-title">
                  <span>{mainFeatured.data.title}</span>
                </h3>
                <p class="featured-desc">{mainFeatured.data.excerpt}</p>
                <div class="featured-footer-meta">
                  <span class="read-time">{mainFeatured.data.readingTime}</span>
                  <span class="meta-dot">•</span>
                  <span class="read-article-link">Read article →</span>
                </div>
              </div>
            </a>
          )}

          <!-- All Other Blog Cards Grid (Uniform Equal Size Compact Cards) -->
          <div class="subcards-grid" id="subcards-grid">
            {gridArticles.map((art) => (
              <div
                class="subcard-item"
                data-category={getCategorySlug(art.data.category)}
              >
                <span class="subcard-tag">{art.data.category}</span>
                <h4 class="subcard-title">
                  <a href={`/blog/${art.slug || art.id}`}>
                    <span class="subcard-title-desktop">{art.data.title}</span>
                    <span class="subcard-title-mobile">{art.data.title}</span>
                  </a>
                </h4>
                <p class="subcard-desc">
                  <span class="subcard-desc-desktop">{art.data.excerpt}</span>
                  <span class="subcard-desc-mobile">{art.data.excerpt}</span>
                </p>
                <div class="subcard-meta-footer">
                  <span class="subcard-read-time">{art.data.readingTime}</span>
                  <a href={`/blog/${art.slug || art.id}`} class="subcard-read-link">
                    <span class="subcard-read-text-desktop">Read article →</span>
                    <span class="subcard-read-text-mobile">Read →</span>
                  </a>
                </div>
              </div>
            ))}
          </div>

          <!-- Fallback when no posts in category -->
          <div id="no-category-posts" style="display: none; padding: 2.5rem 0; text-align: center; color: var(--muted, #64748b);">
            <p style="font-size: 1.05rem; font-weight: 600;">No articles found for this category.</p>
          </div>
        </main>

        <!-- RIGHT STICKY SIDEBAR: Quick Jump Links, Pricing & Contact -->
        <aside class="sidebar-col sidebar-right">
          <div class="sticky-sidebar">
            <!-- 1. Quick Jump Links (White Capsules, 2 per row) -->
            <div class="sidebar-block">
              <span class="badge-pill orange-badge">QUICK JUMP LINKS</span>
              <div class="quick-jump-capsules-grid">
                <a href="#featured" class="quick-jump-capsule-white">Featured</a>
                {allCategories.map((c) => (
                  <button
                    type="button"
                    class="quick-jump-capsule-white quick-jump-filter-btn"
                    data-cat={c.slug}
                    title={c.name}
                  >
                    {c.short}
                  </button>
                ))}
                <a href="#pricing-tab" class="quick-jump-capsule-white">Pricing</a>
                <a href="#archive" class="quick-jump-capsule-white">Archive</a>
              </div>
            </div>

            <!-- 2. Platform Pricing Section (Short Bullets) -->
            <div id="pricing-tab" class="sidebar-block">
              <span class="badge-pill orange-badge">PLATFORM PRICING</span>
              <ul class="simple-pricing-bullets">
                <li>
                  <span class="pricing-bullet-title">Self-Hosted ($0)</span> — Unlimited VOD, WhisperX Transcripts, Edge CDN &amp; S3 Storage.
                </li>
                <li>
                  <span class="pricing-bullet-title">Enterprise (Custom)</span> — Dedicated Edge Nodes, 99.99% SLA &amp; 24/7 Support.
                </li>
              </ul>
            </div>

            <!-- 3. Contact Engineering Button -->
            <div class="sidebar-contact-block">
              <a href="mailto:hello@ollanode.com" class="sidebar-contact-btn-orange">
                Contact Engineering ↗
              </a>
            </div>
          </div>
        </aside>

      </div>

      <!-- 3. COMPLETE BLOG ARCHIVE SECTION -->
      <div id="archive" class="archive-section">
        <h2 class="archive-title">Complete Blog Archive</h2>
        <p class="archive-subtitle">Browse all engineering articles, tutorials, and release updates by category.</p>
        <div class="archive-grid">
          {archiveList.map(([catName, catArticles]) => (
            <div class="archive-group">
              <h3 class="group-title">
                <span>{catName}</span>
                <span class="group-count">({catArticles.length})</span>
              </h3>
              <ul class="archive-list">
                {catArticles.map((art) => (
                  <li>
                    <a href={`/blog/${art.slug || art.id}`}>
                      {art.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <!-- 4. CONTRIBUTE / CONTACT CTA BANNER -->
      <div class="contribute-banner">
        <div class="contribute-banner-left">
          <div class="contribute-icon-wrap" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ff6600" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </div>
          <div class="contribute-text-wrap">
            <h3 class="contribute-title">Have an idea or want to contribute?</h3>
            <p class="contribute-desc">We'd love to hear from you. Join our community of builders.</p>
          </div>
        </div>
        <div class="contribute-banner-right">
          <a href="mailto:hello@ollanode.com" class="btn-contact-eng">
            <span>Contact Engineering</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>

    </div>
  </section>
</div>

<!-- CLIENT SCRIPT FOR INSTANT CATEGORY FILTERING & SMOOTH NAVIGATION -->
<script is:inline>
  (function () {
    function initBlogFilters() {
      var chips = document.querySelectorAll('.category-chip');
      var quickJumpBtns = document.querySelectorAll('.quick-jump-filter-btn');
      var featuredCard = document.getElementById('featured');
      var subcards = document.querySelectorAll('.subcard-item');
      var noPosts = document.getElementById('no-category-posts');

      function filterCategory(targetCat) {
        var cleanCat = (targetCat || 'all').toLowerCase().trim();
        var visibleCount = 0;

        // Update active chip state
        chips.forEach(function (c) {
          if (c.getAttribute('data-cat') === cleanCat) {
            c.classList.add('active');
          } else {
            c.classList.remove('active');
          }
        });

        // Filter featured card
        if (featuredCard) {
          var featCat = (featuredCard.getAttribute('data-category') || '').toLowerCase().trim();
          if (cleanCat === 'all' || featCat === cleanCat) {
            featuredCard.classList.remove('is-hidden');
            featuredCard.style.display = '';
            visibleCount++;
          } else {
            featuredCard.classList.add('is-hidden');
            featuredCard.style.display = 'none';
          }
        }

        // Filter subcards strictly
        subcards.forEach(function (card) {
          var itemCat = (card.getAttribute('data-category') || '').toLowerCase().trim();
          if (cleanCat === 'all' || itemCat === cleanCat) {
            card.classList.remove('is-hidden');
            card.style.display = '';
            visibleCount++;
          } else {
            card.classList.add('is-hidden');
            card.style.display = 'none';
          }
        });

        if (noPosts) {
          noPosts.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      }

      chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          var cat = this.getAttribute('data-cat');
          filterCategory(cat);
        });
      });

      quickJumpBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var cat = this.getAttribute('data-cat');
          filterCategory(cat);
          var mainFeed = document.querySelector('.feed-col');
          if (mainFeed) {
            mainFeed.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBlogFilters);
    } else {
      initBlogFilters();
    }

    document.addEventListener('astro:page-load', initBlogFilters);
  })();
</script>

<style>
  /* ==========================================================================
     BLOG PAGE STYLES WITH DARKENED AND BROADENED SKY BLUE CATEGORY STRIP
     ========================================================================== */

  .blog-page-wrapper {
    width: 100%;
    background-color: var(--bg, #FFFFFF);
    color: var(--text, #0F172A);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    position: relative;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .container-wide {
    width: 100%;
    max-width: 86rem;
    margin: 0 auto;
    padding: 0 1.25rem;
    box-sizing: border-box;
  }

  /* 1. STICKY CATEGORY CHIPS STRIP (DARKENED, BROADENED SKY BLUE TO DEEP CYAN GRADIENT) */
  .category-strip {
    width: 100%;
    background: linear-gradient(135deg, #E0F2FE 0%, #BAE6FD 20%, #7DD3FC 50%, #38BDF8 78%, #0284C7 100%);
    border-top: 1.5px solid rgba(2, 132, 199, 0.35);
    border-bottom: 2px solid rgba(3, 105, 161, 0.45);
    padding: 0.85rem 0; /* Broader strip */
    position: sticky;
    top: 62px;
    z-index: 40;
    box-shadow: 0 6px 24px rgba(2, 132, 199, 0.22), 0 2px 6px rgba(0, 0, 0, 0.06);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .category-strip-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin: 0 auto;
    padding: 0;
    text-align: center;
  }

  .category-chip {
    display: inline-flex;
    align-items: center;
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.35;
    color: #0F172A;
    background: rgba(255, 255, 255, 0.94);
    border: 1.5px solid rgba(255, 255, 255, 0.98);
    padding: 0.36rem 0.95rem;
    border-radius: 9999px;
    transition: all 0.18s ease;
    text-decoration: none;
    box-sizing: border-box;
    cursor: pointer;
    white-space: nowrap;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.1);
    font-family: inherit;
  }

  .category-chip:hover {
    color: #0369A1;
    border-color: #0284C7;
    background: #FFFFFF;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(2, 132, 199, 0.3);
  }

  .category-chip.active {
    color: #FFFFFF !important;
    background: linear-gradient(135deg, #FF5722, #FF4500) !important;
    border: 1.5px solid #FF5500 !important;
    box-shadow: 0 3px 12px rgba(255, 69, 0, 0.45) !important;
    font-weight: 800;
  }

  /* 2. BLOG LAYOUT 3-COLUMN GRID */
  .blog-layout-section {
    width: 100%;
    padding: 1.5rem 0 3rem;
    overflow: visible;
  }

  .nh-layout-grid {
    display: grid;
    grid-template-columns: 215px 1fr 215px;
    gap: 2.25rem;
    width: 100%;
    position: relative;
  }

  /* SIDEBARS */
  .sidebar-col {
    position: -webkit-sticky !important;
    position: sticky !important;
    top: 112px !important;
    align-self: start !important;
    z-index: 30 !important;
    width: 100% !important;
  }

  .sticky-sidebar {
    display: flex !important;
    flex-direction: column !important;
    position: static !important;
    gap: 1rem !important;
  }

  /* BADGE PILLS */
  .badge-pill {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    width: max-content;
    gap: 0.35rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    text-transform: uppercase;
    white-space: nowrap;
    font-family: 'JetBrains Mono', monospace;
  }

  .founder-badge-purple {
    background: #7C3AED;
    color: #FFFFFF;
    margin-bottom: 0.75rem;
    align-self: flex-start;
  }

  .orange-badge {
    background: #FF6600;
    color: #FFFFFF;
    margin-bottom: 0.75rem;
    align-self: flex-start;
  }

  .newest-badge {
    background: #FF6600;
    color: #FFFFFF;
  }

  .flame-icon {
    display: inline-block;
  }

  /* LEFT SIDEBAR ARTICLE LINKS */
  .article-links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .link-item {
    font-size: 0.835rem;
    font-weight: 500;
    color: #0F172A;
    text-decoration: none;
    transition: color 0.15s ease, transform 0.15s ease;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.36;
  }

  .link-item:hover {
    color: #FF6600;
    text-decoration: none;
    transform: translate(2px);
  }

  .view-all-btn-purple {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.88rem;
    font-weight: 700;
    color: #7C3AED;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .view-all-btn-purple:hover {
    color: #6D28D9;
    text-decoration: underline;
    transform: translate(3px);
  }

  /* FEED CENTER COLUMN */
  .feed-col {
    min-width: 0;
    width: 100%;
  }

  .feed-header-wrap {
    margin-bottom: 1.25rem;
  }

  .feed-section-title {
    font-size: 1.65rem;
    font-weight: 800;
    color: #0F172A;
    letter-spacing: -0.02em;
    margin: 0 0 0.35rem;
    line-height: 1.25;
  }

  .feed-section-subtitle {
    font-size: 0.92rem;
    color: #64748B;
    margin: 0;
    font-weight: 400;
  }

  .newest-header-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.15rem;
  }

  .newest-subtitle-text {
    font-size: 0.88rem;
    color: #64748B;
    font-weight: 500;
  }

  /* FEATURED MAIN CARD */
  .featured-main-card {
    display: block;
    background: #FFFCF7;
    border: 2.5px solid #FF6600;
    border-radius: 18px;
    overflow: hidden;
    margin-bottom: 1.25rem;
    transition: all 0.25s ease;
    box-shadow: 0 4px 18px -4px rgba(255, 102, 0, 0.15);
    position: relative;
    text-decoration: none !important;
    color: inherit !important;
    cursor: pointer !important;
  }

  .featured-main-card-no-img .featured-content-wrapper {
    padding: 1.4rem 1.65rem;
    width: 100%;
    box-sizing: border-box;
  }

  .featured-main-card:hover {
    border-color: #E65100;
    box-shadow: 0 8px 25px -4px rgba(255, 102, 0, 0.22);
    transform: translateY(-2px);
  }

  .featured-main-card:hover .featured-title {
    color: #FF6600 !important;
  }

  .featured-main-card:hover .read-article-link {
    text-decoration: underline !important;
    transform: translate(3px);
  }

  .featured-top-tag {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
  }

  .pill-tag-new {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    background: #FF6600;
    color: #FFFFFF;
    font-size: 0.65rem;
    font-weight: 800;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .featured-category-badge {
    display: inline-block;
    align-self: flex-start;
    background: #E65100;
    color: #FFFFFF;
    font-size: 0.68rem;
    font-weight: 800;
    padding: 0.2rem 0.65rem;
    border-radius: 9999px;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .featured-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: #0F172A;
    line-height: 1.3;
    margin: 0 0 0.55rem;
