---
import Site from './Site.astro';
const { title, description, active, wide } = Astro.props;

const groups = [
  { 
    label: 'GET STARTED', 
    items: [
      { href: '/docs', label: 'Overview', key: 'overview', icon: 'home' },
      { href: '/docs/quickstart', label: 'Quickstart', key: 'quickstart', icon: 'rocket' },
      { href: '/docs/authentication', label: 'Authentication & scopes', key: 'authentication', icon: 'lock' },
    ] 
  },
  { 
    label: 'VIDEO', 
    items: [
      { href: '/docs/videos', label: 'Upload & ingest', key: 'videos', icon: 'upload' },
      { href: '/docs/processing', label: 'Processing & AI', key: 'processing', icon: 'sparkle' },
      { href: '/docs/playback', label: 'Playback & delivery', key: 'playback', icon: 'play' },
      { href: '/docs/voice', label: 'Voice — translate, TTS, ASR', key: 'voice', icon: 'mic' },
    ]
  },
  { 
    label: 'DELIVERY', 
    items: [
      { href: '/docs/cdn', label: 'CDN pull zones', key: 'cdn', icon: 'globe' },
      { href: '/docs/storage', label: 'Storage & images', key: 'storage', icon: 'folder' },
    ] 
  },
  { 
    label: 'DEVELOP', 
    items: [
      { href: '/docs/edge-functions', label: 'Edge functions', key: 'edge-functions', icon: 'code' },
      { href: '/docs/kv', label: 'KV store', key: 'kv', icon: 'database' },
      { href: '/docs/webhooks', label: 'Webhooks', key: 'webhooks', icon: 'bell' },
    ] 
  },
  { 
    label: 'PLATFORM', 
    items: [
      { href: '/#status', label: 'Status', key: 'status', icon: 'activity' },
      { href: '/docs/agents', label: 'AI agents & governance', key: 'agents', icon: 'bot' },
    ] 
  },
];

const allItems = groups.flatMap(g => g.items);
const activeItem = allItems.find(it => it.key === active) || allItems[0];
---
<Site title={title || "Ollanode Documentation"} description={description || "Reference and guides for Ollanode API"}>
  <!-- MOBILE / TABLET STICKY SUB-BAR (Below Navbar) -->
  <div class="docs-mobile-subbar" id="docs-mobile-subbar">
    <button 
      type="button" 
      class="docs-mobile-toggle-btn" 
      id="docs-drawer-trigger" 
      aria-label="Toggle documentation navigation drawer" 
      aria-expanded="false" 
      aria-controls="docs-sidebar"
    >
      <div class="toggle-btn-left">
        <span class="toggle-icon-wrap">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="15" y2="12"></line>
            <line x1="3" y1="18" x2="19" y2="18"></line>
          </svg>
        </span>
        <span class="toggle-btn-label">Docs Menu</span>
      </div>
      <div class="toggle-btn-arrow">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </div>
    </button>

    <div class="docs-mobile-curr-page">
      <span class="curr-page-dot"></span>
      <span class="curr-page-label">{activeItem?.label || 'Overview'}</span>
    </div>
  </div>

  <!-- BACKDROP OVERLAY FOR TABLET / MOBILE DRAWER -->
  <div class="docs-drawer-backdrop" id="docs-drawer-backdrop" aria-hidden="true"></div>

  <div class="docs-redesign-shell">
    <!-- LEFT SIDEBAR / MOBILE SLIDE-OUT DRAWER -->
    <aside class="docs-sidebar" id="docs-sidebar" aria-label="Documentation Sidebar">
      <!-- Mobile Drawer Top Header -->
      <div class="docs-drawer-header">
        <div class="drawer-header-brand">
          <span class="drawer-brand-dot"></span>
          <span class="drawer-brand-title">DOCS NAVIGATION</span>
        </div>
        <button 
          type="button" 
          class="docs-drawer-close-btn" 
          id="docs-drawer-close" 
          aria-label="Close documentation menu"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <nav class="docs-nav-tree">
        {groups.map((g) => (
          <div class="docs-sidebar-group">
            <h4 class="docs-group-label">{g.label}</h4>
            <ul class="docs-group-list">
              {g.items.map((it) => (
                <li>
                  <a 
                    href={it.href} 
                    class={active === it.key ? 'docs-nav-link active' : 'docs-nav-link'} 
                    aria-current={active === it.key ? 'page' : undefined}
                  >
                    <span class="nav-link-icon-wrap">
                      {it.icon === 'home' && (
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                      )}
                      {it.icon === 'rocket' && (
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>
                      )}
                      {it.icon === 'lock' && (
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                      )}
                      {it.icon === 'upload' && (
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                      )}
                      {it.icon === 'sparkle' && (
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
                      )}
                      {it.icon === 'play' && (
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                      )}
                      {it.icon === 'mic' && (
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
                      )}
                      {it.icon === 'globe' && (
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                      )}
                      {it.icon === 'folder' && (
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/></svg>
                      )}
                      {it.icon === 'code' && (
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                      )}
                      {it.icon === 'database' && (
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
                      )}
                      {it.icon === 'bell' && (
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
                      )}
                      {it.icon === 'activity' && (
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                      )}
                      {it.icon === 'bot' && (
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 17v1"/><path d="M15 17v1"/><path d="M9 9h.01"/><path d="M15 9h.01"/></svg>
                      )}
                    </span>
                    <span class="nav-link-label">{it.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>

      <!-- Sidebar Support Callout Box -->
      <div class="docs-sidebar-help-card">
        <div class="help-icon-wrap">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF5A3D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 18.72a9 9 0 1 1 0-13.44"/>
            <path d="M12 8v4l3 3"/>
          </svg>
        </div>
        <h5 class="help-title">Need help?</h5>
        <p class="help-desc">Join our community or contact our team.</p>
        <a href="mailto:hello@ollanode.com" class="btn-help-contact">
          <span>CONTACT SUPPORT</span>
          <span class="arrow-icon">→</span>
        </a>
      </div>
    </aside>

    <!-- RIGHT MAIN CONTENT CONTAINER -->
    <article class="docs-main-content">
      <slot />
    </article>
  </div>

  <script is:inline>
    (function () {
      function initDocsDrawer() {
        var trigger = document.getElementById('docs-drawer-trigger');
        var sidebar = document.getElementById('docs-sidebar');
        var backdrop = document.getElementById('docs-drawer-backdrop');
        var closeBtn = document.getElementById('docs-drawer-close');

        if (!sidebar || !trigger) return;

        function openDrawer() {
          sidebar.classList.add('is-open');
          if (backdrop) backdrop.classList.add('is-open');
          document.body.classList.add('docs-drawer-open');
          trigger.setAttribute('aria-expanded', 'true');
        }

        function closeDrawer() {
          sidebar.classList.remove('is-open');
          if (backdrop) backdrop.classList.remove('is-open');
          document.body.classList.remove('docs-drawer-open');
          trigger.setAttribute('aria-expanded', 'false');
        }

        trigger.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          if (sidebar.classList.contains('is-open')) {
            closeDrawer();
          } else {
            openDrawer();
          }
        });

        if (closeBtn) {
          closeBtn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            closeDrawer();
          });
        }

        if (backdrop) {
          backdrop.addEventListener('click', function () {
            closeDrawer();
          });
        }

        // Close on escape key
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && sidebar.classList.contains('is-open')) {
            closeDrawer();
          }
        });

        // Close when clicking any nav link inside drawer
        sidebar.querySelectorAll('.docs-nav-link').forEach(function (link) {
          link.addEventListener('click', function () {
            if (window.innerWidth <= 960) {
              closeDrawer();
            }
          });
        });

        // Touch swipe-to-close handling for sliding drawer back left
        var touchStartX = 0;
        var touchStartY = 0;
        var touchCurrentX = 0;

        sidebar.addEventListener('touchstart', function (e) {
          touchStartX = e.touches[0].clientX;
          touchStartY = e.touches[0].clientY;
          touchCurrentX = touchStartX;
        }, { passive: true });

        sidebar.addEventListener('touchmove', function (e) {
          touchCurrentX = e.touches[0].clientX;
        }, { passive: true });

        sidebar.addEventListener('touchend', function () {
          var deltaX = touchCurrentX - touchStartX;
          var deltaY = Math.abs((event.changedTouches ? event.changedTouches[0].clientY : 0) - touchStartY);
          // If swiped left by more than 40px and not primarily vertical scroll
          if (deltaX < -40 && deltaY < 80) {
            closeDrawer();
          }
        }, { passive: true });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initDocsDrawer);
      } else {
        initDocsDrawer();
      }

      // Astro View Transitions support
      document.addEventListener('astro:page-load', initDocsDrawer);
    })();
  </script>
</Site>

<style>
  /* ==========================================
     STICKY MOBILE SUB-BAR (TABLET & MOBILE)
     ========================================== */
  .docs-mobile-subbar {
    display: none;
  }

  .docs-drawer-backdrop {
    display: none;
  }

  .docs-drawer-header {
    display: none;
  }

  .docs-redesign-shell {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 52px;
    max-width: 1280px;
    margin: 0 auto;
    padding: 44px 28px 80px;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* SIDEBAR (DESKTOP) */
  .docs-sidebar {
    position: sticky;
    top: 76px;
    align-self: start;
    max-height: calc(100vh - 92px);
    overflow-y: auto;
    padding-right: 12px;
    display: flex;
    flex-direction: column;
    gap: 28px;
    background: transparent;
  }

  .docs-sidebar::-webkit-scrollbar {
    width: 4px;
  }
  .docs-sidebar::-webkit-scrollbar-thumb {
    background: #E2E8F0;
    border-radius: 4px;
  }

  .docs-sidebar-group {
    margin-bottom: 22px;
  }

  .docs-group-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94A3B8;
    margin: 0 0 10px 10px;
  }

  .docs-group-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .docs-nav-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border-radius: 10px;
    color: #475569;
    font-size: 13.5px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.18s ease;
  }

  .nav-link-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94A3B8;
    transition: color 0.18s ease;
  }

  .docs-nav-link:hover {
    color: #0F172A;
    background: #F1F5F9;
  }
  .docs-nav-link:hover .nav-link-icon-wrap {
    color: #0F172A;
  }

  .docs-nav-link.active {
    color: #EA580C;
    background: #FFF7ED;
    font-weight: 600;
    box-shadow: 0 1px 4px rgba(255, 90, 61, 0.08);
  }
  .docs-nav-link.active .nav-link-icon-wrap {
    color: #FF5A3D;
  }

  /* HELP CALLOUT CARD */
  .docs-sidebar-help-card {
    background: #FFFDFB;
    border: 1px solid #FFE4DD;
    border-radius: 16px;
    padding: 18px;
    box-shadow: 0 4px 16px -2px rgba(255, 90, 61, 0.06);
  }

  .help-icon-wrap {
    width: 32px;
    height: 32px;
    background: #FFF0EB;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
  }

  .help-title {
    font-size: 0.95rem;
    font-weight: 750;
    color: #0F172A;
    margin: 0 0 4px;
  }

  .help-desc {
    font-size: 0.8rem;
    color: #64748B;
    line-height: 1.4;
    margin: 0 0 14px;
  }

  .btn-help-contact {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    padding: 8px 12px;
    background: #FFFFFF;
    border: 1px solid #FFCDBC;
    border-radius: 8px;
    color: #EA580C;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-help-contact:hover {
    background: #FFF7ED;
    border-color: #FF5A3D;
  }

  /* MAIN CONTENT */
  .docs-main-content {
    min-width: 0;
    max-width: 100%;
  }

  .docs-main-content pre,
  .docs-main-content code-block,
  .docs-main-content table {
    max-width: 100%;
    overflow-x: auto;
  }

  /* =========================================================
     TABLET & MOBILE RESPONSIVE DRAWER SYSTEM (<= 960px)
     ========================================================= */
  @media (max-width: 960px) {
    /* Sticky Mobile Sub-bar */
    .docs-mobile-subbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 62px;
      z-index: 45;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid #E2E8F0;
      box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
      padding: 10px clamp(16px, 4vw, 24px);
      gap: 12px;
    }

    .docs-mobile-toggle-btn {
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      background: #FFF7ED;
      border: 1px solid #FFD0C2;
      border-radius: 999px;
      padding: 6px 14px 6px 10px;
      cursor: pointer;
      color: #EA580C;
      font-family: 'Inter', sans-serif;
      font-size: 12.5px;
      font-weight: 600;
      box-shadow: 0 1px 3px rgba(255, 90, 61, 0.1);
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }

    .docs-mobile-toggle-btn:hover,
    .docs-mobile-toggle-btn:active {
      background: #FFEDD5;
      border-color: #FB923C;
      transform: translateY(-1px);
      box-shadow: 0 3px 8px rgba(255, 90, 61, 0.18);
    }

    .toggle-btn-left {
      display: inline-flex;
      align-items: center;
      gap: 7px;
    }

    .toggle-icon-wrap {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 22px;
      height: 22px;
      background: #FFE4DC;
      border-radius: 50%;
      color: #EA580C;
    }

    .toggle-btn-label {
      letter-spacing: -0.01em;
    }

    .toggle-btn-arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      color: #EA580C;
      opacity: 0.8;
      transition: transform 0.2s ease;
    }

    .docs-mobile-toggle-btn[aria-expanded="true"] .toggle-btn-arrow {
      transform: rotate(90deg);
    }

    .docs-mobile-curr-page {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      font-weight: 600;
      color: #64748B;
      background: #F8FAFC;
      border: 1px solid #E2E8F0;
      padding: 5px 11px;
      border-radius: 8px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 180px;
    }

    .curr-page-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #FF5A3D;
      flex-shrink: 0;
    }

    .curr-page-label {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* BACKDROP OVERLAY */
    .docs-drawer-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.55);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      z-index: 9998;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .docs-drawer-backdrop.is-open {
      opacity: 1;
      pointer-events: auto;
    }

    /* SLIDE-OUT DRAWER PANEL */
    .docs-sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: min(320px, 86vw);
      height: 100vh;
      height: 100dvh;
      max-height: 100dvh;
      background: #FFFFFF;
      z-index: 9999;
      transform: translateX(-100%);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 12px 0 36px rgba(15, 23, 42, 0.22);
      padding: 20px 18px 36px;
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
      gap: 20px;
      border-right: 1px solid #E2E8F0;
    }

    .docs-sidebar.is-open {
      transform: translateX(0);
    }

    /* DRAWER TOP HEADER */
    .docs-drawer-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 14px;
