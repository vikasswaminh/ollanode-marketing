---
import '../styles/tokens.css';
const { title = 'Ollanode — Self-hosted video infrastructure & CDN', description = 'Upload, transcode, stream, and deliver video at scale on infrastructure you own. An API-first video platform with a global CDN.' } = Astro.props;
// Absolute URLs for canonical + social cards (Astro.site = https://ollanode.com).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;
const nav = [
  { href: '/#capabilities', label: 'Platform' },
  { href: '/#pipeline', label: 'Pipeline' },
  { href: '/#agents', label: 'Agents' },
  { href: '/docs/edge-functions', label: 'Docs' },
  { href: '/pricing', label: 'Pricing' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ollanode" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Chivo+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <script is:inline src="/theme.js"></script>
  </head>
  <body>
    <header class="nav">
      <div class="wrap">
        <a href="/" class="brand"><span class="mark">◢</span> ollanode</a>
        <nav class="nav-links">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
        <div class="nav-right">
          <button class="icon-btn" id="theme" aria-label="Toggle light/dark theme" title="Toggle theme">
            <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          </button>
          <a class="nav-signin" href="https://login.ollanode.com">Sign in</a>
          <a class="btn btn-primary chamfer-sm" href="https://login.ollanode.com">Start free</a>
        </div>
      </div>
    </header>
    <main><slot /></main>
    <footer class="foot">
      <div class="foot-inner">
        <div class="foot-grid">
          <div>
            <a href="/" class="brand"><span class="mark">◢</span> ollanode</a>
            <p class="tag">A self-hosted, API-first video + CDN + storage + edge platform you run on your own hardware.</p>
          </div>
          <div>
            <h4>Product</h4>
            <ul>
              <li><a href="/#capabilities">Video &amp; playback</a></li>
              <li><a href="/#capabilities">CDN &amp; storage</a></li>
              <li><a href="/#agents">AI agents</a></li>
              <li><a href="/pricing">Pricing</a></li>
            </ul>
          </div>
          <div>
            <h4>Developers</h4>
            <ul>
              <li><a href="/docs/edge-functions">Edge functions</a></li>
              <li><a href="/#pipeline">VOD pipeline</a></li>
              <li><a href="/#architecture">Architecture</a></li>
              <li><a href="https://login.ollanode.com/api">API reference</a></li>
            </ul>
          </div>
          <div>
            <h4>Project</h4>
            <ul>
              <li><a href="https://login.ollanode.com">Dashboard</a></li>
              <li><a href="/#architecture">License · Apache-2.0</a></li>
              <li><a href="mailto:hello@ollanode.com">Contact</a></li>
              <li><a href="https://login.ollanode.com">Self-host</a></li>
            </ul>
          </div>
        </div>
      </div>
      <div class="foot-base">
        <span>© {new Date().getFullYear()} Ollanode — Apache-2.0.</span>
        <span>Self-hosted. Permissive OSS only. Your hardware, your rules.</span>
      </div>
    </footer>
  </body>
</html>
