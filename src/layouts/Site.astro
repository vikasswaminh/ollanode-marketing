---
import '../styles/tokens.css';
const { title = 'Ollanode — Self-hosted video infrastructure & CDN', description = 'Upload, transcode, stream, and deliver video at scale on infrastructure you own. An API-first video platform with a global CDN.' } = Astro.props;
// Absolute URLs for canonical + social cards (Astro.site = https://ollanode.com).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;
const path = Astro.url.pathname;
const nav = [
  { href: '/#platform-capabilities', label: 'Features' },
  { href: '/#how-it-works', label: 'Architecture' },
  { href: '/docs', label: 'Docs' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/blog', label: 'Blogs' },
  { href: 'https://login.ollanode.com', label: 'Dashboard' },
];

---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ollanode" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <script is:inline src="/theme.js"></script>
  </head>
  <body>
    <div class="announce" aria-hidden="true">
      <div class="announce-track">
        <span class="announce-item">Power your applications with <b>Video</b>, <b>CDN</b>, <b>Storage</b>, <b>Edge Compute</b>, and <b>Developer Infrastructure</b> — all through <b>OllaNode</b>.</span>
        <span class="announce-item">Power your applications with <b>Video</b>, <b>CDN</b>, <b>Storage</b>, <b>Edge Compute</b>, and <b>Developer Infrastructure</b> — all through <b>OllaNode</b>.</span>
      </div>
    </div>
    <header class="nav">
      <div class="nav-inner">
        <a href="/" class="brand" aria-label="Ollanode home">
          <svg class="brand-logo-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="12" cy="12" r="10" stroke="#FF5A3D" stroke-width="1.8" fill="none"/>
            <ellipse cx="12" cy="12" rx="4" ry="10" stroke="#FF5A3D" stroke-width="1.2" stroke-opacity="0.5" fill="none"/>
            <path d="M 2.5 12 H 21.5" stroke="#FF5A3D" stroke-width="1.2" stroke-opacity="0.5"/>
            <polygon points="10,7 17,12 10,17" fill="#FF5A3D" stroke="#FF5A3D" stroke-width="1" stroke-linejoin="round"/>
          </svg>
          <span class="wordmark" style="font-family: 'Inter', sans-serif; font-weight: 800; font-size: 1.1rem; letter-spacing: 0.05em; color: #1A1D23;">OLLANODE</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          {nav.map((n) => (
            <a href={n.href} class={path === n.href ? 'active' : ''}>{n.label}</a>
          ))}
        </nav>
        <div class="nav-right">
          <button class="icon-btn" id="theme" aria-label="Toggle light/dark theme" title="Toggle theme">
            <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          </button>
          <a class="nav-signin" href="https://login.ollanode.com">Sign in</a>
          <button class="nav-burger" id="nav-burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
      <div class="mobile-menu" id="mobile-menu">
        <nav aria-label="Mobile">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
          <a href="https://login.ollanode.com" class="nav-signin">Sign in</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <div class="site-footer-grid">
          {/* Column 1: Brand & Live Status */}
          <div class="foot-col-brand">
            <a href="/" class="brand foot-brand" aria-label="Ollanode home">
              <svg class="brand-logo-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10" stroke="#FF5A3D" stroke-width="1.8" fill="none"/>
                <ellipse cx="12" cy="12" rx="4" ry="10" stroke="#FF5A3D" stroke-width="1.2" stroke-opacity="0.5" fill="none"/>
                <path d="M 2.5 12 H 21.5" stroke="#FF5A3D" stroke-width="1.2" stroke-opacity="0.5"/>
                <polygon points="10,7 17,12 10,17" fill="#FF5A3D" stroke="#FF5A3D" stroke-width="1" stroke-linejoin="round"/>
              </svg>
              <span class="wordmark" style="font-family: 'Inter', sans-serif; font-weight: 800; font-size: 1.1rem; letter-spacing: 0.05em; color: #1A1D23;">OLLANODE</span>
            </a>
            <p class="foot-tagline">
              A self-hosted, API-first video + CDN + storage + edge platform for modern engineering teams. Own your infrastructure, deliver without limits.
            </p>
            <div class="foot-status-badge">
              <span class="status-indicator-dot"></span>
              <span class="status-text">All Systems Operational · 100+ POPs</span>
            </div>
          </div>

          {/* Column 2: Product Surfaces */}
          <div class="foot-col">
            <h4 class="foot-col-title">Product</h4>
            <ul class="foot-links">
              <li><a href="/#how-it-works">How It Works</a></li>
              <li><a href="/#vod-pipeline">VOD Pipeline</a></li>
              <li><a href="/docs/cdn">CDN Pull Zones</a></li>
              <li><a href="/docs/storage">Storage &amp; Optimizer</a></li>
              <li><a href="/docs/dns">Authoritative DNS</a></li>
              <li><a href="/docs/edge-functions">Edge Functions</a></li>
            </ul>
          </div>

          {/* Column 3: Developers */}
          <div class="foot-col">
            <h4 class="foot-col-title">Developers</h4>
            <ul class="foot-links">
              <li><a href="/docs/quickstart">Quickstart Guide</a></li>
              <li><a href="/docs">Documentation</a></li>
              <li><a href="/docs/playback">Vidstack Player SDK</a></li>
              <li><a href="/docs/agents">AI Agent Governance</a></li>
              <li><a href="https://login.ollanode.com/api">API Reference (OpenAPI)</a></li>
            </ul>
          </div>

          {/* Column 4: Platform & Cloud */}
          <div class="foot-col">
            <h4 class="foot-col-title">Platform</h4>
            <ul class="foot-links">
              <li><a href="https://login.ollanode.com">Dashboard Sign-in</a></li>
              <li><a href="/pricing">Pricing Plans</a></li>
              <li><a href="/docs/quickstart">Self-Host Setup</a></li>
              <li><a href="mailto:hello@ollanode.com">Contact Engineering</a></li>
              <li><a href="https://github.com" target="_blank" rel="noopener noreferrer">Apache-2.0 License</a></li>
            </ul>
          </div>
        </div>

        {/* Bottom Sub-Footer Bar */}
        <div class="site-footer-bottom">
          <div class="foot-copy">
            <span>© {new Date().getFullYear()} Ollanode, Inc. Licensed under <strong>Apache-2.0</strong>.</span>
            <span class="foot-subtext">Self-hosted. Permissive OSS only. Your hardware, your rules.</span>
          </div>
          <div class="foot-bottom-links">
            <a href="/docs/quickstart">Security</a>
            <span class="link-sep">·</span>
            <a href="/docs">Privacy</a>
            <span class="link-sep">·</span>
            <a href="/docs">Terms</a>
            <span class="link-sep">·</span>
            <a href="mailto:hello@ollanode.com">Support</a>
          </div>
        </div>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var nav = document.querySelector('.nav');
        if (nav) {
          var onScroll = function () {
            if (window.scrollY > 15) {
              nav.classList.add('scrolled');
            } else {
              nav.classList.remove('scrolled');
            }
          };
          window.addEventListener('scroll', onScroll, { passive: true });
          onScroll();
        }

        var burger = document.getElementById('nav-burger');
        var menu = document.getElementById('mobile-menu');
        if (burger && menu) {
          burger.addEventListener('click', function () {
            var open = menu.classList.toggle('open');
            burger.classList.toggle('open', open);
            burger.setAttribute('aria-expanded', open ? 'true' : 'false');
          });
        }
        // Global Section Scroll Reveal Observer & Heading Transitions
        function initRevealObserver() {
          if ('IntersectionObserver' in window) {
            var sectionObserver = new IntersectionObserver(function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  sectionObserver.unobserve(entry.target);
                }
              });
            }, { threshold: 0.02, rootMargin: '0px 0px -40px 0px' });

            document.querySelectorAll('.section-reveal, .reveal-up').forEach(function (el) {
              var rect = el.getBoundingClientRect();
              if (rect.top < window.innerHeight && rect.bottom > 0) {
                el.classList.add('is-visible');
              } else {
                sectionObserver.observe(el);
              }
            });
          } else {
            document.querySelectorAll('.section-reveal, .reveal-up').forEach(function (el) {
              el.classList.add('is-visible');
            });
          }
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initRevealObserver);
        } else {
          initRevealObserver();
        }
      })();
    </script>

  </body>
</html>
