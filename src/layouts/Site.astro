---
import '../styles/tokens.css';
const { title = 'Ollanode — Self-hosted video infrastructure & CDN', description = 'Upload, transcode, stream, and deliver video at scale on infrastructure you own. An API-first video platform with a global CDN.' } = Astro.props;
// Absolute URLs for canonical + social cards (Astro.site = https://ollanode.com).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;
const nav = [
  { href: '/#platform', label: 'Platform' },
  { href: '/#api', label: 'API' },
  { href: '/docs/edge-functions', label: 'Docs' },
  { href: '/pricing', label: 'Pricing' },
  { href: 'https://login.ollanode.com', label: 'Dashboard' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ollanode" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Chivo+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-ink font-sans text-paper antialiased">
    <header class="sticky top-0 z-20 border-b border-line bg-[#0a0a0a]/80 backdrop-blur">
      <div class="mx-auto flex max-w-content items-center justify-between px-6 py-4">
        <a href="/" class="flex items-center gap-2 font-mono text-sm font-semibold tracking-tight text-paper">
          <span class="text-accent">◢</span> ollanode
        </a>
        <nav class="hidden items-center gap-8 font-mono text-xs uppercase tracking-wide text-paper-muted md:flex">
          {nav.map((n) => <a href={n.href} class="transition-colors hover:text-paper">{n.label}</a>)}
        </nav>
        <a href="https://login.ollanode.com" class="chamfer-sm bg-paper px-4 py-2 font-mono text-xs font-medium uppercase tracking-wide text-ink transition-opacity hover:opacity-80">Sign in</a>
      </div>
    </header>
    <main><slot /></main>
    <footer class="border-t border-line">
      <div class="mx-auto flex max-w-content flex-col items-center justify-between gap-4 px-6 py-10 text-sm text-paper-faint sm:flex-row">
        <div class="font-mono text-xs">© {new Date().getFullYear()} ollanode — self-hosted video, your infrastructure.</div>
        <div class="flex gap-6 font-mono text-xs uppercase tracking-wide">
          <a href="/docs/edge-functions" class="transition-colors hover:text-paper">Docs</a>
          <a href="/pricing" class="transition-colors hover:text-paper">Pricing</a>
          <a href="https://login.ollanode.com" class="transition-colors hover:text-paper">Dashboard</a>
          <a href="mailto:hello@ollanode.com" class="transition-colors hover:text-paper">Contact</a>
        </div>
      </div>
    </footer>
  </body>
</html>
