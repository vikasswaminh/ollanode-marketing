---
import Site from '../layouts/Site.astro';
---
<Site title="404 — Page not found · Ollanode" description="The page you were looking for does not exist.">
  <section class="band dot-bg" style="text-align:center">
    <div class="wrap" style="max-width:560px;display:flex;flex-direction:column;align-items:center;gap:18px">
      <span class="eyebrow">Error 404</span>
      <h1 style="font-size:clamp(2.4rem,6vw,3.4rem)">Page not found</h1>
      <p class="lede" style="color:var(--muted)">The page you were looking for doesn’t exist or has moved.</p>
      <a class="btn btn-primary btn-lg chamfer-sm" href="/">Back to home</a>
    </div>
  </section>
</Site>
