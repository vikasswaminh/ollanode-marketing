  }

  .founder-badge-purple {
    background: #7c3aed;
    color: #fff;
    margin-bottom: 1.15rem;
    align-self: flex-start;
    width: max-content;
  }

  .orange-badge {
    background: #ff6600;
    color: #fff;
    margin-bottom: 0.85rem;
    align-self: flex-start;
    width: max-content;
  }

  /* LEFT SIDEBAR: TOC BOX */
