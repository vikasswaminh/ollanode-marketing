---
import Site from '../../layouts/Site.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('blog');
  return articles.map((article) => ({
    params: { slug: article.slug || article.id },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'blog'>;
}

const { article } = Astro.props;
const { Content, headings } = await article.render();

// Extract H2 & H3 headings for the "ON THIS PAGE" sticky left sidebar
const tocHeadings = headings.filter(
  (h) => (h.depth === 2 || h.depth === 3) && h.slug !== 'table-of-contents'
);

// Fetch related articles for the "RELATED READING" sticky right sidebar
const allArticles = await getCollection('blog');
const otherArticles = allArticles.filter((a) => a.id !== article.id);
const sameCategory = otherArticles.filter(
  (a) => a.data.category === article.data.category
);
const differentCategory = otherArticles.filter(
  (a) => a.data.category !== article.data.category
);
const relatedArticles = [...sameCategory, ...differentCategory].slice(0, 5);
---

<Site
  title={`${article.data.title} · OllaNode Blog`}
  description={article.data.excerpt}
>
  <div class="article-page-wrap">
    <div class="container-wide">
      
      <!-- 3-COLUMN ARTICLE LAYOUT (EXACT REPLICATION OF BLOGS.OLLANODE.COM) -->
      <div class="article-3col-layout">

        <!-- 1. LEFT SIDEBAR: STICKY "ON THIS PAGE" TABLE OF CONTENTS -->
        <aside class="sidebar-col sidebar-toc">
          <div class="sticky-sidebar">
            <span class="badge-pill founder-badge-purple">ON THIS PAGE</span>
            <div class="toc-card-box">
              <nav class="toc-nav" aria-label="Table of Contents">
                {tocHeadings.length > 0 ? (
                  <ul class="toc-list">
                    {tocHeadings.map((h) => (
                      <li class={`toc-item toc-depth-${h.depth}`}>
                        <a href={`#${h.slug}`} class="toc-link" title={h.text}>
                          {h.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <ul class="toc-list">
                    <li class="toc-item toc-depth-2">
                      <a href="#overview" class="toc-link">Overview</a>
                    </li>
                  </ul>
                )}
              </nav>
            </div>
            <a href="/blog" class="view-all-btn-purple">← Back to Blog Home</a>
          </div>
        </aside>

        <!-- 2. MIDDLE COLUMN: MAIN ARTICLE CONTENT & FLOW -->
        <main class="article-middle-col">
          
          <!-- Breadcrumb Navigation -->
          <nav class="article-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span class="breadcrumb-sep">›</span>
            <a href="/blog">Blog</a>
            <span class="breadcrumb-sep">›</span>
            <span class="breadcrumb-current">{article.data.title}</span>
          </nav>

          <!-- Article Header -->
          <header class="article-header">
            <div class="article-category-eyebrow">
              <span class="category-pill-orange">{article.data.category || 'Product & Changelog'}</span>
              <span class="eyebrow-dot">·</span>
              <time datetime={article.data.publishedDate}>{article.data.publishedDate || 'Aug 21, 2026'}</time>
              <span class="eyebrow-dot">·</span>
              <span>{article.data.readingTime || '27 min read'}</span>
            </div>

            <h1 class="article-main-title">{article.data.title}</h1>

            <p class="article-lead-desc">{article.data.excerpt}</p>

            <div class="article-author-bar">
              <div class="author-meta-text">
                <span>By <strong class="author-name">{article.data.author?.name || 'The OllaNode Team'}</strong></span>
                <span class="meta-dot">·</span>
                <span>Category: <strong>{article.data.category || 'Product & Changelog'}</strong></span>
                <span class="meta-dot">·</span>
                <span>Published <time datetime={article.data.publishedDate}>{article.data.publishedDate || 'Aug 21, 2026'}</time></span>
              </div>
            </div>
          </header>

          <!-- Optional Cover Image -->
          {article.data.image && (
            <div class="article-cover-wrap">
              <img src={article.data.image} alt={article.data.title} class="article-cover-img" />
            </div>
          )}

          <!-- Article Prose Body (Flow of content with headings, paragraphs, lists, code, and callouts) -->
          <div class="prose article-prose-content">
            <Content />
          </div>

          <!-- Tags Footer (if tags present) -->
          {article.data.tags && article.data.tags.length > 0 && (
            <div class="article-tags-wrap">
              <span class="tags-label">Tags:</span>
              <div class="tags-list">
                {article.data.tags.map((tag) => (
                  <span class="tag-chip">#{tag}</span>
                ))}
              </div>
            </div>
          )}

          <!-- Article Bottom CTA Card -->
          <div class="article-footer-cta">
            <div class="article-footer-card">
              <h3>Run your own VOD transcoding, adaptive HLS, edge CDN, and AI-governed media storage</h3>
              <p>Deploy Apache-2.0 open source video infrastructure on your own cloud hardware in minutes.</p>
              <div class="article-footer-actions">
                <a href="https://ollanode.com" class="btn-ollanode-primary">Explore OllaNode ↗</a>
              </div>
            </div>
          </div>

        </main>

        <!-- 3. RIGHT SIDEBAR: STICKY "RELATED READING" CARDS -->
        <aside class="sidebar-col sidebar-related">
          <div class="sticky-sidebar">
            <span class="badge-pill orange-badge">RELATED READING</span>
            <div class="related-cards-stack">
              {relatedArticles.map((art) => (
                <a href={`/blog/${art.slug || art.id}`} class="related-card-item">
                  <div class="related-card-top">
                    <span class="related-card-tag">{art.data.category || 'Video & CDN'}</span>
                    <span class="related-card-arrow" aria-hidden="true">↗</span>
                  </div>
                  <h4 class="related-card-title">{art.data.title}</h4>
                  <p class="related-card-desc">{art.data.excerpt}</p>
                </a>
              ))}
            </div>
          </div>
        </aside>

      </div>
    </div>
  </div>
</Site>

<!-- CLIENT SCRIPT FOR TOC ACTIVE STATE TRACKING -->
<script is:inline>
  (function () {
    function initTocTracker() {
      var links = document.querySelectorAll('.toc-link');
      if (!links.length) return;

      var headings = [];
      links.forEach(function (link) {
        var href = link.getAttribute('href');
        if (href && href.startsWith('#')) {
          var el = document.getElementById(href.substring(1));
          if (el) {
            headings.push({ el: el, link: link });
          }
        }
      });

      function onScroll() {
        var scrollPos = window.scrollY + 140;
        var active = null;

        for (var i = 0; i < headings.length; i++) {
          if (headings[i].el.offsetTop <= scrollPos) {
            active = headings[i];
          } else {
            break;
          }
        }

        links.forEach(function (l) {
          l.classList.remove('active');
        });

        if (active) {
          active.link.classList.add('active');
        } else if (links.length > 0) {
          links[0].classList.add('active');
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTocTracker);
    } else {
      initTocTracker();
    }

    document.addEventListener('astro:page-load', initTocTracker);
  })();
</script>

<style>
  /* ==========================================================================
     EXACT CSS COPY-PASTE FROM BLOGS.OLLANODE.COM /BLOG/[SLUG]
     ========================================================================== */

  :root {
    --bg: #ffffff;
    --bg-soft: #f8fafc;
    --border: #e2e8f0;
    --border-light: #f1f5f9;
    --text: #0f172a;
