---
import Site from '../../layouts/Site.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('blog');
  return articles.map((article) => ({
    params: { slug: article.slug || article.id },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'blog'>;
}

const { article } = Astro.props;
const { Content, headings } = await article.render();

// Extract H2 & H3 headings for the "ON THIS PAGE" sticky left sidebar
const tocHeadings = headings.filter(
  (h) => (h.depth === 2 || h.depth === 3) && h.slug !== 'table-of-contents'
);

// Fetch related articles for the "RELATED READING" sticky right sidebar
const allArticles = await getCollection('blog');
const otherArticles = allArticles.filter((a) => a.id !== article.id);
// Prioritize articles in same category
const sameCategory = otherArticles.filter(
  (a) => a.data.category === article.data.category
);
const differentCategory = otherArticles.filter(
  (a) => a.data.category !== article.data.category
);
const relatedArticles = [...sameCategory, ...differentCategory].slice(0, 5);

// Key takeaways from frontmatter if available or derived
const keyTakeaways = (article.data as any).keyTakeaways || [
  `Self-hosted video infrastructure gives you total control over ingestion, transcoding, storage, and edge delivery.`,
  `Combines adaptive HLS packaging, private-origin proxying, and WhisperX transcription in an event-driven Rust pipeline.`,
  `Permissively licensed under Apache-2.0 with native AI-agent governance and tamper-evident audit logging.`,
];
---

<Site
  title={`${article.data.title} · OllaNode Blog`}
  description={article.data.excerpt}
>
  <div class="article-page-wrap">
    <div class="container-wide">
      
      <!-- 3-COLUMN ARTICLE LAYOUT (EXACT REPLICATION OF BLOGS.OLLANODE.COM) -->
      <div class="article-3col-layout">

        <!-- 1. LEFT SIDEBAR: STICKY "ON THIS PAGE" TABLE OF CONTENTS -->
        <aside class="sidebar-col sidebar-toc">
          <div class="sticky-sidebar">
            <span class="badge-pill founder-badge-purple">ON THIS PAGE</span>
            <nav class="toc-card-box" aria-label="Table of contents">
              {tocHeadings.length > 0 ? (
                <ul class="toc-list">
                  {tocHeadings.map((h) => (
                    <li class={`toc-item depth-${h.depth}`}>
                      <a href={`#${h.slug}`} class="toc-link" title={h.text}>
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <ul class="toc-list">
                  <li class="toc-item depth-2">
                    <a href="#overview" class="toc-link">Overview</a>
                  </li>
                  <li class="toc-item depth-2">
                    <a href="#architecture" class="toc-link">Architecture</a>
                  </li>
                </ul>
              )}
            </nav>
            <a href="/blog" class="view-all-btn-purple">← Back to Blog Home</a>
          </div>
        </aside>

        <!-- 2. MIDDLE COLUMN: MAIN ARTICLE CONTENT -->
        <main class="article-middle-col">
          
          <!-- Breadcrumb Navigation -->
          <nav class="article-breadcrumb" aria-label="Breadcrumb">
            <a href="/" class="crumb-link">Home</a>
            <span class="crumb-sep">›</span>
            <a href="/blog" class="crumb-link">Blog</a>
            <span class="crumb-sep">›</span>
            <span class="crumb-current">{article.data.title}</span>
          </nav>

          <!-- Article Header -->
          <header class="article-header">
            <div class="article-meta-top">
              <span class="category-pill-orange">{article.data.category}</span>
              <span class="meta-dot">•</span>
              <span class="meta-item">{article.data.publishedDate}</span>
              <span class="meta-dot">•</span>
              <span class="meta-item">{article.data.readingTime}</span>
            </div>

            <h1 class="article-main-title">{article.data.title}</h1>

            <p class="article-lead-desc">{article.data.excerpt}</p>

            <div class="article-author-bar">
              <div class="author-avatar">{article.data.author?.avatar || '⚡'}</div>
              <div class="author-info">
                <span class="author-name">{article.data.author?.name || 'OllaNode Team'}</span>
                <span class="author-role">{article.data.author?.role || 'Core Engineering'}</span>
              </div>
            </div>
          </header>

          <!-- Featured Hero Image (if available) -->
          {article.data.image && (
            <div class="article-hero-banner">
              <img src={article.data.image} alt={article.data.title} />
            </div>
          )}

          <!-- Key Takeaways Callout Box -->
          {keyTakeaways && keyTakeaways.length > 0 && (
            <div class="key-takeaways-box">
              <div class="takeaways-header">
                <svg class="takeaways-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                </svg>
                <h3 class="takeaways-title">Key Takeaways</h3>
              </div>
              <ul class="takeaways-list">
                {keyTakeaways.map((item: string) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )}

          <!-- Main Article Prose -->
          <div class="article-prose-content prose">
            <Content />
          </div>

          <!-- Tags Footer -->
          {article.data.tags && article.data.tags.length > 0 && (
            <div class="article-tags-wrap">
              <span class="tags-label">Tags:</span>
              <div class="tags-list">
                {article.data.tags.map((tag) => (
                  <span class="tag-chip">#{tag}</span>
                ))}
              </div>
            </div>
          )}

          <!-- Bottom CTA Banner Card -->
          <div class="article-bottom-cta">
            <div class="bottom-cta-inner">
              <span class="cta-badge">GET STARTED</span>
              <h3 class="cta-title">Run your own VOD transcoding, adaptive HLS, edge CDN, and AI-governed media storage</h3>
              <p class="cta-desc">Deploy Apache-2.0 open source video infrastructure on your own cloud hardware in minutes.</p>
              <div class="cta-btn-wrap">
                <a href="https://ollanode.com" class="btn-cta-orange">Explore OllaNode ↗</a>
              </div>
            </div>
          </div>

        </main>

        <!-- 3. RIGHT SIDEBAR: STICKY "RELATED READING" CARDS -->
        <aside class="sidebar-col sidebar-related">
          <div class="sticky-sidebar">
            <span class="badge-pill orange-badge">RELATED READING</span>
            <div class="related-cards-stack">
              {relatedArticles.map((art) => (
                <a href={`/blog/${art.slug || art.id}`} class="related-card-item">
                  <span class="related-card-category">{art.data.category} ↗</span>
                  <h4 class="related-card-title">{art.data.title}</h4>
                  <p class="related-card-desc">{art.data.excerpt}</p>
                </a>
              ))}
            </div>
          </div>
        </aside>

      </div>
    </div>
  </div>
</Site>

<!-- CLIENT SCRIPT FOR TOC ACTIVE STATE TRACKING -->
<script is:inline>
  (function () {
    function initTocTracker() {
      var links = document.querySelectorAll('.toc-link');
      if (!links.length) return;

      var headings = [];
      links.forEach(function (link) {
        var href = link.getAttribute('href');
        if (href && href.startsWith('#')) {
          var el = document.getElementById(href.substring(1));
          if (el) {
            headings.push({ el: el, link: link });
          }
        }
      });

      function onScroll() {
        var scrollPos = window.scrollY + 140;
        var active = null;

        for (var i = 0; i < headings.length; i++) {
          if (headings[i].el.offsetTop <= scrollPos) {
            active = headings[i];
          } else {
            break;
          }
        }

        links.forEach(function (l) {
          l.classList.remove('active');
        });

        if (active) {
          active.link.classList.add('active');
        } else if (links.length > 0) {
          links[0].classList.add('active');
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTocTracker);
    } else {
      initTocTracker();
    }

    document.addEventListener('astro:page-load', initTocTracker);
  })();
</script>

<style>
