---
import Site from '../../layouts/Site.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('blog');
  return articles.map((article) => ({
    params: { slug: article.slug || article.id },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'blog'>;
}

const { article } = Astro.props;
const { Content, headings } = await article.render();

// Extract H2 headings for the "ON THIS PAGE" sticky left sidebar
const tocHeadings = headings.filter((h) => h.depth === 2 && h.slug !== 'table-of-contents');

// Fetch related articles for the "RELATED READING" sticky right sidebar
const allArticles = await getCollection('blog');
const otherArticles = allArticles.filter((a) => a.id !== article.id);
const relatedArticles = (otherArticles.length > 0 ? otherArticles : allArticles).slice(0, 5);
---

<Site
  title={`${article.data.title} — Ollanode Blog`}
  description={article.data.excerpt}
>
  <article class="post-detail-sec">
    <!-- POST HERO HEADER -->
    <header class="post-hero">
      <div class="wrap">
        <a href="/blog" class="back-link">← Back to Blog</a>

        <div class="post-hero-body">
          <div class="post-meta">
            <span class="cat-pill">{article.data.category}</span>
            <span class="meta-dot">•</span>
            <span>{article.data.publishedDate}</span>
            <span class="meta-dot">•</span>
            <span>{article.data.readingTime}</span>
          </div>

          <h1 class="post-title">{article.data.title}</h1>

          <p class="post-excerpt-lead">{article.data.excerpt}</p>

          <div class="post-author-box">
            <div class="author-avatar">{article.data.author.avatar || '⚡'}</div>
            <div class="author-info">
              <span class="author-name">{article.data.author.name}</span>
              <span class="author-role">{article.data.author.role}</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    {article.data.image && (
      <div class="post-hero-banner-wrap">
        <div class="wrap">
          <img src={article.data.image} alt={article.data.title} class="post-hero-banner-img" />
        </div>
      </div>
    )}

    <!-- COMPLETE 3-COLUMN POST DETAIL LAYOUT GRID -->
    <div class="post-body-container">
      <div class="wrap post-detail-max-wrap">
        <div class="post-detail-grid">

          <!-- 1. LEFT SIDEBAR: STICKY "ON THIS PAGE" TABLE OF CONTENTS -->
          <aside class="post-sidebar-left">
            <div class="toc-card">
              <div class="toc-badge">ON THIS PAGE</div>
              <nav class="toc-nav">
                {tocHeadings.length > 0 ? (
                  <ul>
                    {tocHeadings.map((h) => (
                      <li>
                        <a href={`#${h.slug}`} class="toc-link">
                          {h.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="toc-empty">Overview &amp; details</p>
                )}
              </nav>
            </div>
          </aside>

          <!-- 2. CENTER COLUMN: ARTICLE BODY CONTENT -->
          <main class="post-content-main prose">
            <Content />

            {article.data.tags && article.data.tags.length > 0 && (
              <div class="post-tags-footer">
                <span class="tags-label">Tags:</span>
                {article.data.tags.map((tag) => (
                  <span class="tag-chip">#{tag}</span>
                ))}
              </div>
            )}
          </main>

          <!-- 3. RIGHT SIDEBAR: STICKY "RELATED READING" CARDS -->
          <aside class="post-sidebar-right">
            <div class="related-sidebar-card">
              <div class="related-badge">RELATED READING</div>
              <div class="related-sidebar-list">
                {relatedArticles.map((art) => (
                  <article class="related-mini-card">
                    <span class="related-mini-cat">{art.data.category}</span>
                    <h4 class="related-mini-title">
                      <a href={`/blog/${art.slug || art.id}`}>{art.data.title}</a>
                    </h4>
                    <div class="related-mini-footer">
                      <span class="related-mini-time">{art.data.readingTime}</span>
                      <a href={`/blog/${art.slug || art.id}`} class="related-mini-arrow">Read →</a>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          </aside>

        </div>
      </div>
    </div>
  </article>
</Site>
