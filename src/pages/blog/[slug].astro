    line-height: 1.55;
  }

  .article-footer-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-ollanode-primary {
    display: inline-flex;
    align-items: center;
    background: linear-gradient(135deg, #ff6600, #e65100);
    color: #ffffff !important;
    font-weight: 700;
    font-size: 0.92rem;
    padding: 0.75rem 1.6rem;
