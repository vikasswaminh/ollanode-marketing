  }

  /* ARTICLE HEADER */
  .article-header {
    margin-bottom: 2rem;
  }

  .article-category-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--muted, #64748b);
    font-weight: 500;
    margin-bottom: 0.75rem;
  }

  .category-pill-orange {
    display: inline-block;
    background: rgba(255, 102, 0, 0.08);
    color: #ea580c;
    border: 1px solid rgba(255, 102, 0, 0.2);
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.2rem 0.65rem;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .eyebrow-dot,
  .meta-dot {
    color: #94a3b8;
  }

  .article-main-title {
    font-size: 2.35rem;
