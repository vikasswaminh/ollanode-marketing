---
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import Endpoint from '../../components/Endpoint.astro';

const eps = [
  { method: 'POST', path: '/v1/translate', scope: 'translate:write',
    desc: 'Translate text between languages. `source_language` / `target_language` are ISO-639-1 codes. Hindi targets return natural Hindi in **Devanagari** script — English technical terms are transliterated (router → राउटर, server → सर्वर), true acronyms preserved. Typically sub-second.',
    curl: `curl -X POST https://api.ollanode.com/v1/translate \\
  -H "Authorization: Bearer $OLLANODE_API_KEY" -H "Content-Type: application/json" \\
  -d '{"text":"The router forwards this traffic to the next hop.","source_language":"en","target_language":"hi"}'`,
    response: `{ "translation": "राउटर इस ट्रैफ़िक को नेक्स्ट हॉप पर फ़ॉरवर्ड करता है।", "backend": "gemini" }`,
    useCases: [
      'Live meeting and video-caption translation',
      'Localizing subtitles and UI strings',
      'Natural Hindi for Indian technical audiences',
    ] },
  { method: 'POST', path: '/v1/tts', scope: 'tts:write',
    desc: 'Synthesize speech → `audio/wav` (24 kHz). Send JSON `{input, language, voice?}`. `language` selects the engine + accent: **en / en-IN / hi / kn** → Soniox (default voice **Mohan**, 96 voices), **en-US / fr / es** → pocket (voice **george**). `voice` names a built-in voice or a custom cloned voice from `GET /v1/voices`; omit for the language default. `input` also accepts the legacy alias `text`.',
    curl: `curl -X POST https://api.ollanode.com/v1/tts \\
  -H "Authorization: Bearer $OLLANODE_API_KEY" -H "Content-Type: application/json" \\
  -d '{"input":"Welcome to the live demo.","language":"en"}' -o hello.wav`,
    response: `# 200 OK — binary audio/wav (24 kHz; save with -o hello.wav)`,
    responseLabel: 'Response (audio/wav)',
    useCases: [
      'Voiceover and narration for generated video',
      'Spoken notifications and IVR prompts',
      'Indian English, Hindi & Kannada (Soniox) plus American English, French & Spanish (pocket)',
    ] },
  { method: 'GET', path: '/v1/voices', scope: 'voices:read',
    desc: 'List the available voices — the Soniox catalogue (96 voices, each with gender + a short description), pocket’s `george`, and your `custom_voices` (`{id, name, ready}`) — plus the `language` → engine table used by `/v1/tts`.',
    curl: `curl https://api.ollanode.com/v1/voices -H "Authorization: Bearer $OLLANODE_API_KEY"`,
    response: `{ "engine": "soniox+pocket", "voices": ["Mohan", "Rohan", "...", "george"],
  "custom_voices": [ { "id": "…uuid…", "name": "anchor", "ready": true } ],
  "catalog": { "soniox": { "default_voice": "Mohan", "voices": [ … ] }, "pocket": { … } },
  "languages": { "en": "Indian English — Soniox (default Mohan)", "...": "..." } }`,
    useCases: ['Populate a voice picker', 'Discover voices + the language→engine map'] },
  { method: 'POST', path: '/v1/voices', scope: 'voices:write',
    desc: '**Zero-shot voice cloning** — create a custom voice from a clean reference clip. Multipart `name` + `file`. Cloning is **async**: you get a voice `id` back; poll `GET /v1/voices` until that voice’s `ready` is true, then synthesize with `voice: "<id>"` on `/v1/tts`. Remove it with `DELETE /v1/voices/{id}`.',
    curl: `curl -X POST https://api.ollanode.com/v1/voices \\
  -H "Authorization: Bearer $OLLANODE_API_KEY" \\
  -F name=anchor -F file=@reference.wav`,
    response: `{ "id": "…uuid…", "name": "anchor", "ready": false }`,
    useCases: [
      'Branded / personal narration voices',
      'A reusable voice library for your product',
      'Clone once, speak any Soniox language',
    ] },
  { method: 'POST', path: '/v1/asr', scope: 'asr:write',
    desc: 'Transcribe a short audio clip (multilingual **Nemotron** backend). POST the raw `audio/wav` bytes as the request body (up to 25 MB); returns the text plus timed segments. Language is **auto-detected**; pass `?language=<ISO-639-1>` to hint it.',
    curl: `curl -X POST "https://api.ollanode.com/v1/asr?language=en" \\
  -H "Authorization: Bearer $OLLANODE_API_KEY" -H "Content-Type: audio/wav" \\
  --data-binary @clip.wav`,
    response: `{
  "text": "Hello from the Ollanode voice API.",
  "segments": [ { "start": 0.0, "end": 2.4, "text": "Hello from the Ollanode voice API." } ]
}`,
    useCases: [
      'Voice-note and command transcription',
      'Short-clip captioning',
      'Voice input for agents',
    ] },
];

const compose = `// Speech -> speech: transcribe, translate, and speak the result.
const key = process.env.OLLANODE_API_KEY;
const auth = { Authorization: \`Bearer \${key}\` };

// 1) transcribe the input clip
const { text } = await fetch("https://api.ollanode.com/v1/asr?language=en",
  { method: "POST", headers: { ...auth, "Content-Type": "audio/wav" }, body: clipBytes }
).then((r) => r.json());

// 2) translate it to Hindi
const { translation } = await fetch("https://api.ollanode.com/v1/translate",
  { method: "POST", headers: { ...auth, "Content-Type": "application/json" },
    body: JSON.stringify({ text, source_language: "en", target_language: "hi" }) }
).then((r) => r.json());

// 3) speak the translation (Hindi -> Soniox voice Mohan)
const wav = await fetch("https://api.ollanode.com/v1/tts",
  { method: "POST", headers: { ...auth, "Content-Type": "application/json" },
    body: JSON.stringify({ input: translation, language: "hi" }) }
).then((r) => r.arrayBuffer());   // audio/wav`;

// Voice languages, by engine.
const soniox = ['Indian English (en / en-IN)', 'Hindi (hi)', 'Kannada (kn)'];
const pocket = ['American English (en-US)', 'French (fr)', 'Spanish (es)'];
---
<DocsLayout active="voice" title="Voice — Ollanode Docs" description="Multilingual text-to-speech, zero-shot voice cloning, translation, and transcription — through one project-scoped Ollanode API on self-hosted inference.">
  <div class="docs-hero">
    <span class="eyebrow">Docs / Voice</span>
    <h1>Voice</h1>
    <p class="lede">Multilingual speech synthesis, zero-shot voice cloning, translation, and transcription through one project-scoped API — backed by Ollanode's own inference. No third-party keys, no per-character SaaS metering.</p>
    <div class="docs-chips"><span class="chip">Indian + Western voices</span><span class="chip">voice cloning</span><span class="chip">Hindi · Kannada</span><span class="chip">translation</span></div>
  </div>

  <h2>Endpoints</h2>
  {eps.map((e) => <Endpoint {...e} />)}

  <h2>Voices & languages</h2>
  <p>Text-to-speech picks the engine from the <code>language</code> you send:</p>
  <p><strong>Soniox</strong> (default voice <code>Mohan</code>, plus 95 more via <code>GET /v1/voices</code>): <span set:html={soniox.map((l) => `<code>${l}</code>`).join(' · ')} /></p>
  <p><strong>pocket</strong> (voice <code>george</code>): <span set:html={pocket.map((l) => `<code>${l}</code>`).join(' · ')} /></p>

  <h2>Compose them</h2>
  <p>The routes are ordinary JSON/audio calls, so you can chain them — the classic pipeline is transcribe → translate → speak.</p>
  <CodeBlock code={compose} label="speech → speech" />

  <div class="note">Grant <code>translate:write</code> / <code>tts:write</code> / <code>asr:write</code> / <code>voices:read</code> (fine-grained grants go in <code>extra_scopes</code>; the <a href="/docs/agents">agent</a> role preset includes them). These routes are for on-demand text and short audio clips — for full-length video transcripts use the async <a href="/docs/processing">transcript</a> flow. Try it live in the <a href="https://login.ollanode.com/playground">Voice Playground</a>.</div>
</DocsLayout>
