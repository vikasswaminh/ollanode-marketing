---
import Site from '../layouts/Site.astro';
const features = [
  { icon: '⬆', tone: 'text-paper', title: 'Upload any source', body: 'Direct upload, resumable multipart for large files, or pull from a URL. We handle the rest.' },
  { icon: '⚙', tone: 'text-blue', title: 'Adaptive transcoding', body: 'Automatic HLS ladders, audio loudness normalization, MP4 + audio renditions, thumbnails and storyboards.' },
  { icon: '▶', tone: 'text-paper', title: 'Player & embed', body: 'Drop-in embed, signed or public playback, chapters, and multi-language subtitles out of the box.' },
  { icon: '◳', tone: 'text-green', title: 'Global CDN', body: 'Multi-tenant pull zones with instant purge, signed URLs, CORS, and declarative edge rules.' },
  { icon: 'ƒ', tone: 'text-accent', title: 'Edge functions', body: 'Deploy JavaScript that runs in a V8 isolate at the edge — invoke at /__fn/<id> in seconds.' },
  { icon: '⌘', tone: 'text-paper', title: 'API-first', body: 'Everything is a REST endpoint: API keys, webhooks (Mux-style events), and per-project scoping.' },
];
const steps = [
  { n: '01', title: 'Create a video', body: 'POST a video (or a source URL) and get a presigned upload target.' },
  { n: '02', title: 'We process it', body: 'Transcode to an adaptive ladder, extract thumbnails, normalize audio — fully async.' },
  { n: '03', title: 'Stream anywhere', body: 'Embed the player or serve the HLS manifest through your CDN, signed or public.' },
];
const snippet = `curl -X POST https://api.ollanode.com/v1/videos \\
  -H "authorization: Bearer $OLLA_KEY" \\
  -d '{"title":"launch.mp4","source_url":"https://.../launch.mp4"}'`;
---
<Site>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-line">
    <div class="grid-bg pointer-events-none absolute inset-0"></div>
    <div class="relative mx-auto max-w-content px-6 py-28 text-center">
      <span class="chamfer-sm inline-block border border-line bg-surface-2 px-3 py-1 font-mono text-[11px] uppercase tracking-widest text-paper-muted">
        API-first · self-hosted · CDN included
      </span>
      <h1 class="mx-auto mt-7 max-w-3xl text-4xl font-semibold tracking-tight text-paper sm:text-6xl">
        Video infrastructure & CDN <span class="text-accent">you actually own</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-paper-muted">
        Upload, transcode, stream, and deliver video at scale — on your own VMs and storage.
        The power of Mux or Cloudflare Stream, without the lock-in or per-minute pricing.
      </p>
      <div class="mt-9 flex items-center justify-center gap-3">
        <a href="https://login.ollanode.com" class="chamfer-sm bg-paper px-5 py-3 font-mono text-xs font-medium uppercase tracking-wide text-ink transition-opacity hover:opacity-80">Open the dashboard</a>
        <a href="/#features" class="chamfer-sm border border-line px-5 py-3 font-mono text-xs font-medium uppercase tracking-wide text-paper transition-colors hover:bg-surface-2">Explore features</a>
      </div>
      <pre class="chamfer mx-auto mt-14 max-w-xl overflow-x-auto border border-line bg-surface-1 p-5 text-left font-mono text-xs text-paper-dim"><code>{snippet}</code></pre>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="border-b border-line">
    <div class="mx-auto max-w-content px-6 py-24">
      <p class="text-center font-mono text-xs uppercase tracking-widest text-accent">// Capabilities</p>
      <h2 class="mt-3 text-center text-3xl font-semibold tracking-tight text-paper">Everything to ship video</h2>
      <p class="mx-auto mt-3 max-w-2xl text-center text-paper-muted">One platform for ingest, processing, delivery, and the control plane.</p>
      <div class="mt-14 grid grid-cols-1 gap-px overflow-hidden border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
        {features.map((f) => (
          <div class="bg-ink p-7 transition-colors hover:bg-surface-1">
            <div class={`font-mono text-2xl ${f.tone}`}>{f.icon}</div>
            <h3 class="mt-4 font-medium text-paper">{f.title}</h3>
            <p class="mt-2 text-sm text-paper-muted">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how" class="border-b border-line">
    <div class="mx-auto max-w-content px-6 py-24">
      <p class="text-center font-mono text-xs uppercase tracking-widest text-accent">// Workflow</p>
      <h2 class="mt-3 text-center text-3xl font-semibold tracking-tight text-paper">From upload to playback in three steps</h2>
      <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-3">
        {steps.map((s) => (
          <div class="chamfer border border-line bg-surface-1 p-7">
            <div class="font-mono text-3xl font-semibold text-accent">{s.n}</div>
            <h3 class="mt-4 font-medium text-paper">{s.title}</h3>
            <p class="mt-2 text-sm text-paper-muted">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative overflow-hidden">
    <div class="grid-bg pointer-events-none absolute inset-0 opacity-60"></div>
    <div class="relative mx-auto max-w-content px-6 py-24 text-center">
      <h2 class="text-3xl font-semibold tracking-tight text-paper">Ready to run your own video platform?</h2>
      <p class="mx-auto mt-3 max-w-xl text-paper-muted">Sign in to the dashboard and create your first video in minutes.</p>
      <a href="https://login.ollanode.com" class="chamfer-sm mt-9 inline-block bg-accent px-6 py-3 font-mono text-xs font-semibold uppercase tracking-wide text-paper transition-opacity hover:opacity-90">Get started →</a>
    </div>
  </section>
</Site>
