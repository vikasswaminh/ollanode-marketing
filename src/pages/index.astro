---
import Site from '../layouts/Site.astro';

const stats = [
  { n: '9', l: 'Services' },
  { n: '11', l: 'Library crates' },
  { n: '360p→4K', l: 'HLS ladder' },
  { n: '−52%', l: 'AVIF posters' },
  { n: ':53', l: 'Authoritative DNS' },
];

const pipeline = [
  ['event', 'upload_completed', false],
  ['step', 'validate', false],
  ['step', 'extract_metadata', false],
  ['encode', 'transcode', true],
  ['encode', 'generate_hls', true],
  ['step', 'thumbnails', false],
  ['step', 'transcript', false],
  ['step', 'store_assets', false],
  ['step', 'emit_webhook', false],
  ['ready', 'mark_ready', true],
];

const svg = (p) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${p}</svg>`;

const caps = [
  { icon: svg('<rect x="2.5" y="5" width="15" height="14" rx="2"/><path d="M17.5 10l4-2.5v9L17.5 14"/>'), t: 'Video',
    d: 'Adaptive HLS ladder (360p→4K, no upscaling), H.264 plus optional H.265/NVENC, progressive MP4 + audio-only MP3, sub-clips, and optional AES-128 HLS encryption.' },
  { icon: svg('<rect x="4" y="10.5" width="16" height="10" rx="2"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/>'), t: 'Playback',
    d: 'Signed, expiring tokens over a private origin (bytes never served direct), cookie-scoped CDN-cacheable segments, and an embeddable Vidstack player.' },
  { icon: svg('<rect x="3" y="4" width="18" height="14" rx="2"/><path d="M7 21h10M6 9h5M6 13h8"/>'), t: 'Thumbnails & transcripts',
    d: 'Poster + sampled frames + storyboard sprite/WebVTT; word-level WhisperX transcripts (VTT/SRT), optional diarization, manual chapters, and AI title/description/tags/chapters.' },
  { icon: svg('<path d="M6.5 18a4.5 4.5 0 0 1-.5-8.97A6 6 0 0 1 18 8.5a4 4 0 0 1 .5 9.5H7z"/><path d="M12 12v5M9.5 14.5 12 12l2.5 2.5"/>'), t: 'CDN',
    d: 'Multi-tenant pull zones on an OpenResty edge: per-zone TTL/CORS/edge rules, hotlink token signing, full + path-granular purge, live traffic analytics.' },
  { icon: svg('<ellipse cx="12" cy="6" rx="7.5" ry="3"/><path d="M4.5 6v6c0 1.66 3.36 3 7.5 3s7.5-1.34 7.5-3V6M4.5 12v6c0 1.66 3.36 3 7.5 3s7.5-1.34 7.5-3v-6"/>'), t: 'Storage',
    d: 'S3-style storage zones with presigned upload + a signed on-the-fly image optimizer (resize / format / quality via imgproxy).' },
  { icon: svg('<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 3.8 5.7 3.8 9S14.5 18.5 12 21c-2.5-2.5-3.8-5.7-3.8-9S9.5 5.5 12 3z"/>'), t: 'DNS',
    d: 'Authoritative DNS server (Hickory) serving zones/records (A/AAAA/CNAME/TXT/MX/NS) from Postgres on :53.' },
  { icon: svg('<path d="m8 8-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14"/>'), t: 'Edge functions',
    d: 'Deploy JS/TS functions, executed at the edge in V8 isolates.' },
  { icon: svg('<path d="M12 3v6M8.5 6 12 9l3.5-3M5 12a7 7 0 0 0 14 0M5 12v3a3 3 0 0 0 3 3h3M19 12v3a3 3 0 0 1-3 3h-1"/>'), t: 'Webhooks',
    d: 'HMAC-signed delivery with exponential-backoff retries + dead-letter.' },
  { icon: svg('<circle cx="9" cy="8" r="3.2"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0M16 6.2a3.2 3.2 0 0 1 0 6M17.5 19a5.5 5.5 0 0 0-3-4.9"/>'), t: 'Accounts & access',
    d: 'Self-serve signup, roles (owner/admin/member/viewer), true per-project tenant isolation, fine-grained resource:action scopes.' },
  { icon: svg('<rect x="4.5" y="8" width="15" height="11" rx="2.5"/><path d="M12 8V4.5M12 4.5a1.5 1.5 0 1 1 0-.01M9 13h.01M15 13h.01M9.5 16.5h5"/>'), t: 'AI-agent model',
    d: 'Agents work API-first with approval-gated destructive/code actions, a /v1/whoami capability map, tamper-evident hash-chain audit, and a kill-switch.' },
  { icon: svg('<path d="M12 3 5 6v5c0 4.4 3 8 7 9 4-1 7-4.6 7-9V6l-7-3z"/><path d="m9 12 2 2 4-4"/>'), t: 'Security',
    d: 'Coraza + OWASP CRS WAF in front of the API, origin guard, idempotency keys, rate limiting, request-id correlation.' },
  { icon: svg('<path d="M4 7h16M4 12h16M4 17h16"/><circle cx="8" cy="7" r="1.4" fill="currentColor" stroke="none"/><circle cx="15" cy="12" r="1.4" fill="currentColor" stroke="none"/><circle cx="10" cy="17" r="1.4" fill="currentColor" stroke="none"/>'), t: 'Orchestration',
    d: 'Clean architecture + DDD: the domain core has no IO, adapters implement ports. NATS JetStream, or Temporal when TEMPORAL_ENABLED=true.' },
];

const stack = ['Rust · Axum', 'PostgreSQL', 'NATS JetStream', 'S3 · SeaweedFS', 'FFmpeg', 'WhisperX', 'imgproxy', 'tusd', 'Coraza WAF', 'Hickory DNS', 'Supabase Edge Runtime'];

const services = ['upload', 'transcode', 'thumbnail', 'transcript', 'webhook', 'cdn-edge-agent', 'playback', 'dns-service'];

const faqs = [
  ['Is there live streaming?', "No — it's a VOD pipeline only. There's no live / RTMP ingest."],
  ['HLS or DASH?', 'HLS today. Segments are already CMAF/fMP4 (DASH-ready packaging); a DASH manifest is the remaining piece.'],
  ['How does pricing work?', "It's self-hosted software you run on your own hardware. There's no billing system and no metered plans — the cost is your infrastructure."],
  ["What's off by default?", 'AI metadata, speaker diarization, H.265/NVENC, loudness normalization and the SVT-AV1 tier are all real but config/hardware-gated and off by default.'],
  ['How is it licensed?', 'Apache-2.0, with permissive-OSS-only dependencies (no AGPL) — SeaweedFS, imgproxy, tusd, Coraza, Hickory, Vidstack.'],
  ["Where's the API described?", 'Machine-readable at GET /openapi.json (OpenAPI 3.1), with MCP for agents.'],
];

const heroCode = `<span class="pr">$</span> <span class="cmd">curl -X POST https://api.ollanode.com/<span class="k">v1/videos</span> \\</span>
    <span class="cmd">-H <span class="s">"Authorization: Bearer $OLLA_KEY"</span> \\</span>
    <span class="cmd">-d <span class="s">'{"title":"launch.mp4"}'</span></span>

<span class="c">// 201 Created</span>
<span class="p">{</span>
  <span class="k">"id"</span><span class="p">:</span> <span class="s">"vid_8Kd2Qa7Rn0"</span><span class="p">,</span>
  <span class="k">"status"</span><span class="p">:</span> <span class="s">"created"</span><span class="p">,</span>
  <span class="k">"master_url"</span><span class="p">:</span> <span class="s">"…/hls/master.m3u8?<span class="n">token</span>=…"</span>
<span class="p">}</span>`;
---
<Site>
  <!-- HERO -->
  <section class="band hero dot-bg" id="top">
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">Self-hosted · API-first</span>
          <h1>A self-hosted <span class="hl">video&nbsp;+&nbsp;CDN&nbsp;+&nbsp;storage&nbsp;+&nbsp;edge</span> platform you run yourself.</h1>
          <p class="lede">It ingests video, transcodes to an adaptive HLS ladder, extracts thumbnails &amp; storyboards, generates word-level transcripts, and serves signed playback — all behind a project-scoped REST API.</p>
          <p class="hero-class">// Mux / Cloudflare Stream / Bunny.net-class — on your own hardware.</p>
          <div class="hero-cta">
            <a class="btn btn-primary btn-lg chamfer-sm" href="https://login.ollanode.com">Start free</a>
            <a class="btn btn-lg" href="/docs/edge-functions">Read the docs&nbsp; <span class="mono" style="color:var(--muted-2)">GET /openapi.json</span></a>
          </div>
        </div>
        <div class="code" role="img" aria-label="Example API call creating a video and receiving a signed playback URL">
          <div class="code-head"><span class="dots"><i></i><i></i><i></i></span><span class="lbl">create a video</span><span class="tag">REST</span></div>
          <pre set:html={heroCode}></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- POSITIONING / STATS -->
  <section class="band tight alt">
    <div class="wrap">
      <div class="strip">
        <p class="strip-lead">One REST API for the whole stack — no per-minute billing, no vendor origin.</p>
        <div class="stats">
          {stats.map((s) => (
            <div class="stat"><div class="num">{s.n}</div><div class="lbl">{s.l}</div></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- PIPELINE -->
  <section class="band grid-bg" id="pipeline">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">The VOD pipeline</span>
        <h2>One upload. A full pipeline.</h2>
        <p>All long-running work is async and runs in workers, never in request handlers.</p>
      </div>
      <div class="flow">
        {pipeline.map(([st, name, key], i) => (
          <>
            <div class={key ? 'node key' : 'node'}><span class="st">{st}</span>{name}</div>
            {i < pipeline.length - 1 && <span class="arr">→</span>}
          </>
        ))}
      </div>
      <p class="flow-note">// NATS JetStream by default; Temporal optional via <span class="hl">TEMPORAL_ENABLED=true</span> — both engines share the same activity implementation.</p>
    </div>
  </section>

  <!-- CAPABILITIES -->
  <section class="band alt" id="capabilities">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">What it does</span>
        <h2>Everything, behind one project-scoped REST API.</h2>
        <p>Twelve product surfaces — video, delivery, storage, DNS, edge, and governance — from a single self-hosted control plane.</p>
      </div>
      <div class="cards">
        {caps.map((c) => (
          <div class="card">
            <span class="ico" set:html={c.icon}></span>
            <h3>{c.t}</h3>
            <p>{c.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PLAYBACK -->
  <section class="band grid-bg">
    <div class="wrap">
      <div class="split">
        <div>
          <span class="eyebrow">Signed delivery</span>
          <h2 style="margin:.7rem 0 .9rem">Playback the origin never leaks.</h2>
          <p class="lede">Bytes are never served direct — the playback-service proxies and rewrites every HLS URI through itself, so your origin stays private.</p>
          <div class="feat-list">
            <div class="feat"><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="4" y="10.5" width="16" height="10" rx="2"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/></svg></span><div><div class="ft">Signed, expiring tokens</div><div class="fd">Every master + variant URI carries an HMAC token; the default policy is <span class="mono">signed</span>, with optional revocation lookup.</div></div></div>
            <div class="feat"><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 3 5 6v5c0 4.4 3 8 7 9 4-1 7-4.6 7-9V6l-7-3z"/></svg></span><div><div class="ft">AES-128 HLS encryption</div><div class="fd">Per-video key with <span class="mono">#EXT-X-KEY</span> and token-gated key delivery.</div></div></div>
            <div class="feat"><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><polygon points="6,4 20,12 6,20"/></svg></span><div><div class="ft">Embeddable Vidstack player</div><div class="fd">Quality selector, storyboard, chapters, and captions at <span class="mono">/embed/:id</span>.</div></div></div>
          </div>
        </div>
        <div class="player" role="img" aria-label="Illustration of the embeddable player with signed playback and an adaptive quality ladder">
          <div class="stage">
            <div class="badges"><span class="lock">🔒 signed</span><span class="lock">AES-128</span></div>
            <div class="res"><span>360p</span><span>720p</span><span class="on">1080p</span><span>4K</span></div>
            <div class="play" aria-hidden="true"></div>
          </div>
          <div class="bar">
            <span class="tri"></span>
            <div class="scrub"></div>
            <span class="time">02:14 / 05:47</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CDN / STORAGE / DNS / EDGE -->
  <section class="band alt">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Delivery &amp; edge</span>
        <h2>A CDN, object store, DNS and edge runtime — yours.</h2>
        <p>The same control plane that ingests video also runs the network that delivers it.</p>
      </div>
      <div class="quad">
        <div class="qcard">
          <div class="qh"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 18a4.5 4.5 0 0 1-.5-8.97A6 6 0 0 1 18 8.5a4 4 0 0 1 .5 9.5H7z"/></svg></span><h3>CDN pull zones</h3></div>
          <div class="demo"><span class="box">request</span><span class="ar">→</span><span class="box">edge</span><span class="ar">→</span><span class="pill err">MISS</span><span class="ar">→</span><span class="pill ok">HIT</span></div>
          <p>Multi-tenant pull zones on OpenResty, routed by Host. Full purge bumps a cache version; the next request is a <span class="mono">MISS</span> again, then <span class="mono">HIT</span>.</p>
        </div>
        <div class="qcard">
          <div class="qh"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="6" rx="7.5" ry="3"/><path d="M4.5 6v12c0 1.66 3.36 3 7.5 3s7.5-1.34 7.5-3V6"/></svg></span><h3>Storage + image optimizer</h3></div>
          <p>S3-style zones with presigned upload and a signed on-the-fly optimizer via imgproxy — resize, format, quality.</p>
          <div class="kv">30&nbsp;KB JPEG <b>→</b> 2.9&nbsp;KB WebP&nbsp;&nbsp;<span class="dim">@200px&nbsp; f/q/rs</span></div>
        </div>
        <div class="qcard">
          <div class="qh"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 3.8 5.7 3.8 9S14.5 18.5 12 21"/></svg></span><h3>Authoritative DNS</h3></div>
          <p>Hickory serves your zones and records (A/AAAA/CNAME/TXT/MX/NS) straight from Postgres.</p>
          <div class="kv">dig demo.ollanode.com <b>→</b> SOA + NS&nbsp;&nbsp;<span class="dim">UDP · TCP · :53</span></div>
        </div>
        <div class="qcard">
          <div class="qh"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m8 8-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14"/></svg></span><h3>Edge functions</h3></div>
          <p>Deploy JS/TS and run it at the edge in a V8 isolate — no cold container, no server to manage.</p>
          <div class="kv">GET /__fn/&lt;id&gt; <b>→</b> your code&nbsp;&nbsp;<span class="dim">V8 isolate · 200</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- AGENT GOVERNANCE -->
  <section class="band grid-bg" id="agents">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Built for AI agents</span>
        <h2>Agent-native — with guardrails.</h2>
        <p>Agents are API-first citizens. Destructive and code actions don't just run — they route through a human, once.</p>
      </div>
      <div class="gov">
        <div class="gov-flow">
          <div class="step"><span class="t">agent</span>{'POST /v1/… (gated)'}</div><span class="arr">→</span>
          <div class="step"><span class="t">gateway</span><span class="code202">202</span> {'{ approval_id }'}</div><span class="arr">→</span>
          <div class="step human"><span class="t">human</span>reviews &amp; approves</div><span class="arr">→</span>
          <div class="step"><span class="t">agent</span>replay + X-Approval-Id</div><span class="arr">→</span>
          <div class="step"><span class="t">once</span>executes ✓</div>
        </div>
        <div class="gov-chips">
          <span class="chip"><span class="dot" style="background:var(--ok)"></span>/v1/whoami capability map</span>
          <span class="chip"><span class="dot" style="background:var(--brand)"></span>hash-chain audit · /v1/audit/verify</span>
          <span class="chip"><span class="dot" style="background:var(--warn)"></span>kill-switch: disable all agents</span>
          <span class="chip"><span class="dot" style="background:var(--err)"></span>human-only: team · keys · org → 403</span>
          <span class="chip"><span class="dot" style="background:var(--muted-2)"></span>OpenAPI 3.1 + MCP</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ARCHITECTURE -->
  <section class="band alt" id="architecture">
    <div class="wrap">
      <div class="arch">
        <div class="topo" role="img" aria-label="Service topology: a REST client hits the api-gateway, which dispatches over NATS JetStream to worker services, backed by PostgreSQL and an S3 object store">
          <div class="row"><span class="n">REST client</span></div>
          <div class="vgap">↓</div>
          <div class="row"><span class="n gw">api-gateway</span></div>
          <div class="busline">NATS JetStream — events + jobs</div>
          <div class="row">
            {services.map((s) => <span class="n">{s}</span>)}
          </div>
          <div class="vgap">↓</div>
          <div class="row"><span class="n infra">PostgreSQL</span><span class="n infra">S3 object store</span></div>
        </div>
        <div>
          <span class="eyebrow">Architecture</span>
          <h2 style="margin:.7rem 0 .9rem">Clean architecture. Your hardware.</h2>
          <p class="lede">A Cargo workspace built in Rust (Axum): 11 library crates and 9 independently-deployable services. The domain core has no IO; adapters implement ports.</p>
          <div class="stack-chips">
            {stack.map((s) => <span class="chip">{s}</span>)}
          </div>
          <p class="arch-note"><b>Permissive OSS only</b> — no AGPL. Licensed <b>Apache-2.0</b>. Provision ≥ 8 vCPU / 16–32 GB RAM (GPU recommended for WhisperX / NVENC), then <span class="mono">make deploy-up</span>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="band grid-bg" id="faq">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Straight answers</span>
        <h2>What it is — and what it isn't.</h2>
        <p>The honest edges, from our capability source-of-truth.</p>
      </div>
      <div class="faq">
        {faqs.map(([q, a]) => (
          <div class="qa"><h3>{q}</h3><p>{a}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- CLOSING -->
  <section class="band closing dot-bg" id="start">
    <div class="wrap">
      <span class="eyebrow" style="justify-content:center">Quick start</span>
      <h2 style="margin-top:.7rem">Run your own video stack.</h2>
      <p class="lede" style="margin:0 auto;color:var(--muted)">Bring up the infra, migrate, and run the gateway — then create a project and upload a video.</p>
      <div class="cmd-line"><span class="pr">$</span> cp .env.example .env &amp;&amp; make infra-up &amp;&amp; make migrate &amp;&amp; make run-gateway</div>
      <div class="cta">
        <a class="btn btn-primary btn-lg chamfer-sm" href="https://login.ollanode.com">Start free</a>
        <a class="btn btn-lg" href="/docs/edge-functions">Read the docs</a>
        <a class="btn btn-lg" href="/pricing">Pricing</a>
      </div>
    </div>
  </section>
</Site>
