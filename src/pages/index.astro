    icon: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/><line x1="14" y1="4" x2="10" y2="20"/>'
  },
  {
    num: '08',
    title: 'Webhooks',
    short: 'HMAC-signed delivery with exponential retries & dead-letter queue.',
    full: '<span class="mono">HMAC</span>-signed delivery with exponential-backoff retries + dead-letter.',
    icon: '<path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>'
  },
  {
    num: '09',
