---
import Site from '../layouts/Site.astro';
import HowItWorksArchitecture from '../components/HowItWorksArchitecture.astro';
import VodPipelineSection from '../components/VodPipelineSection.astro';
import TechCapabilitiesCarousel from '../components/TechCapabilitiesCarousel.astro';
import DeliveryEdgeSection from '../components/DeliveryEdgeSection.astro';
import QuickStartSection from '../components/QuickStartSection.astro';
import WhyOllanodeSection from '../components/WhyOllanodeSection.astro';
import AgentNativeSection from '../components/AgentNativeSection.astro';
import WhatOllanodeIsSection from '../components/WhatOllanodeIsSection.astro';

const line1Chars = Array.from("Own your Infrastructure");
const line2Chars = Array.from("Deliver without Limits");

const stats = [
  { n: '9', l: 'Services' },
  { n: '11', l: 'Library crates' },
  { n: '360p→4K', l: 'HLS ladder' },
  { n: '−52%', l: 'AVIF posters' },
  { n: ':53', l: 'Authoritative DNS' },
];

const pipeline = [
  ['event', 'upload_completed', false],
  ['step', 'validate', false],
  ['step', 'extract_metadata', false],
  ['encode', 'transcode', true],
  ['encode', 'generate_hls', true],
  ['step', 'thumbnails', false],
  ['step', 'transcript', false],
  ['step', 'store_assets', false],
  ['step', 'emit_webhook', false],
  ['ready', 'mark_ready', true],
];

const svg = (p) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${p}</svg>`;

const caps = [
  { icon: svg('<rect x="2.5" y="5" width="15" height="14" rx="2"/><path d="M17.5 10l4-2.5v9L17.5 14"/>'), t: 'Video',
    d: 'Adaptive HLS ladder (360p→4K, no upscaling), H.264 plus optional H.265/NVENC, progressive MP4 + audio-only MP3, sub-clips, and optional AES-128 HLS encryption.' },
  { icon: svg('<rect x="4" y="10.5" width="16" height="10" rx="2"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/>'), t: 'Playback',
    d: 'Signed, expiring tokens over a private origin (bytes never served direct), cookie-scoped CDN-cacheable segments, and an embeddable Vidstack player.' },
  { icon: svg('<rect x="3" y="4" width="18" height="14" rx="2"/><path d="M7 21h10M6 9h5M6 13h8"/>'), t: 'Thumbnails & transcripts',
    d: 'Poster + sampled frames + storyboard sprite/WebVTT; word-level WhisperX transcripts (VTT/SRT), optional diarization, manual chapters, and AI title/description/tags/chapters.' },
  { icon: svg('<path d="M6.5 18a4.5 4.5 0 0 1-.5-8.97A6 6 0 0 1 18 8.5a4 4 0 0 1 .5 9.5H7z"/><path d="M12 12v5M9.5 14.5 12 12l2.5 2.5"/>'), t: 'CDN',
    d: 'Multi-tenant pull zones on an OpenResty edge: per-zone TTL/CORS/edge rules, hotlink token signing, full + path-granular purge, live traffic analytics.' },
  { icon: svg('<ellipse cx="12" cy="6" rx="7.5" ry="3"/><path d="M4.5 6v6c0 1.66 3.36 3 7.5 3s7.5-1.34 7.5-3V6M4.5 12v6c0 1.66 3.36 3 7.5 3s7.5-1.34 7.5-3v-6"/>'), t: 'Storage',
    d: 'S3-style storage zones with presigned upload + a signed on-the-fly image optimizer (resize / format / quality via imgproxy).' },
  { icon: svg('<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 3.8 5.7 3.8 9S14.5 18.5 12 21c-2.5-2.5-3.8-5.7-3.8-9S9.5 5.5 12 3z"/>'), t: 'DNS',
    d: 'Authoritative DNS server (Hickory) serving zones/records (A/AAAA/CNAME/TXT/MX/NS) from Postgres on :53.' },
  { icon: svg('<path d="m8 8-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14"/>'), t: 'Edge functions',
    d: 'Deploy JS/TS functions, executed at the edge in V8 isolates.' },
  { icon: svg('<path d="M12 3v6M8.5 6 12 9l3.5-3M5 12a7 7 0 0 0 14 0M5 12v3a3 3 0 0 0 3 3h3M19 12v3a3 3 0 0 1-3 3h-1"/>'), t: 'Webhooks',
    d: 'HMAC-signed delivery with exponential-backoff retries + dead-letter.' },
  { icon: svg('<circle cx="9" cy="8" r="3.2"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0M16 6.2a3.2 3.2 0 0 1 0 6M17.5 19a5.5 5.5 0 0 0-3-4.9"/>'), t: 'Accounts & access',
    d: 'Self-serve signup, roles (owner/admin/member/viewer), true per-project tenant isolation, fine-grained resource:action scopes.' },
  { icon: svg('<rect x="4.5" y="8" width="15" height="11" rx="2.5"/><path d="M12 8V4.5M12 4.5a1.5 1.5 0 1 1 0-.01M9 13h.01M15 13h.01M9.5 16.5h5"/>'), t: 'AI-agent model',
    d: 'Agents work API-first with approval-gated destructive/code actions, a /v1/whoami capability map, tamper-evident hash-chain audit, and a kill-switch.' },
  { icon: svg('<path d="M12 3 5 6v5c0 4.4 3 8 7 9 4-1 7-4.6 7-9V6l-7-3z"/><path d="m9 12 2 2 4-4"/>'), t: 'Security',
    d: 'Coraza + OWASP CRS WAF in front of the API, origin guard, idempotency keys, rate limiting, request-id correlation.' },
  { icon: svg('<path d="M4 7h16M4 12h16M4 17h16"/><circle cx="8" cy="7" r="1.4" fill="currentColor" stroke="none"/><circle cx="15" cy="12" r="1.4" fill="currentColor" stroke="none"/><circle cx="10" cy="17" r="1.4" fill="currentColor" stroke="none"/>'), t: 'Orchestration',
    d: 'Clean architecture + DDD: the domain core has no IO, adapters implement ports. NATS JetStream, or Temporal when TEMPORAL_ENABLED=true.' },
];

const stack = ['Rust · Axum', 'PostgreSQL', 'NATS JetStream', 'S3 · SeaweedFS', 'FFmpeg', 'WhisperX', 'imgproxy', 'tusd', 'Coraza WAF', 'Hickory DNS', 'Supabase Edge Runtime'];

const services = ['upload', 'transcode', 'thumbnail', 'transcript', 'webhook', 'cdn-edge-agent', 'playback', 'dns-service'];

const faqs = [
  ['Is there live streaming?', "No — it's a VOD pipeline only. There's no live / RTMP ingest."],
  ['HLS or DASH?', 'HLS today. Segments are already CMAF/fMP4 (DASH-ready packaging); a DASH manifest is the remaining piece.'],
  ['How does pricing work?', "It's self-hosted software you run on your own hardware. There's no billing system and no metered plans — the cost is your infrastructure."],
  ["What's off by default?", 'AI metadata, speaker diarization, H.265/NVENC, loudness normalization and the SVT-AV1 tier are all real but config/hardware-gated and off by default.'],
  ['How is it licensed?', 'Apache-2.0, with permissive-OSS-only dependencies (no AGPL) — SeaweedFS, imgproxy, tusd, Coraza, Hickory, Vidstack.'],
  ["Where's the API described?", 'Machine-readable at GET /openapi.json (OpenAPI 3.1), with MCP for agents.'],
];

const heroCode = `<span class="pr">$</span> <span class="cmd">curl -X POST https://api.ollanode.com/<span class="k">v1/videos</span> \\</span>
    <span class="cmd">-H <span class="s">"Authorization: Bearer $OLLA_KEY"</span> \\</span>
    <span class="cmd">-d <span class="s">'{"title":"launch.mp4"}'</span></span>

<span class="c">// 201 Created</span>
<span class="p">{</span>
  <span class="k">"id"</span><span class="p">:</span> <span class="s">"vid_8Kd2Qa7Rn0"</span><span class="p">,</span>
  <span class="k">"status"</span><span class="p">:</span> <span class="s">"created"</span><span class="p">,</span>
  <span class="k">"master_url"</span><span class="p">:</span> <span class="s">"…/hls/master.m3u8?<span class="n">token</span>=…"</span>
<span class="p">}</span>`;
const platformCapabilities = [
  {
    num: '01',
    title: 'Video',
    short: 'Adaptive video delivery with HLS, transcoding and playback.',
    full: 'Adaptive HLS ladder (<span class="mono">360p→4K</span>, no upscaling), <span class="mono">H.264</span> plus optional <span class="mono">H.265/NVENC</span>, progressive <span class="mono">MP4</span> + audio-only <span class="mono">MP3</span>, sub-clips, and optional <span class="mono">AES-128 HLS</span> encryption.',
    icon: '<polygon points="5 3 19 12 5 21 5 3"/>'
  },
  {
    num: '02',
    title: 'Playback',
    short: 'Private origin streaming with expiring tokens & Vidstack player.',
    full: 'Signed, expiring tokens over a private origin (bytes never served direct), cookie-scoped CDN-cacheable segments, and an embeddable <span class="mono">Vidstack</span> player.',
    icon: '<rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>'
  },
  {
    num: '03',
    title: 'Thumbnails & Transcripts',
    short: 'Poster sprites, WebVTT, WhisperX transcripts & AI metadata.',
    full: 'Poster + sampled frames + storyboard sprite/<span class="mono">WebVTT</span>; word-level <span class="mono">WhisperX</span> transcripts (<span class="mono">VTT/SRT</span>), optional diarization, manual chapters, and AI title/description/tags/chapters.',
    icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>'
  },
  {
    num: '04',
    title: 'CDN',
    short: 'Multi-tenant OpenResty edge pull zones & instant cache purge.',
    full: 'Multi-tenant pull zones on an <span class="mono">OpenResty</span> edge: per-zone TTL/CORS/edge rules, hotlink token signing, full + path-granular purge, live traffic analytics.',
    icon: '<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>'
  },
  {
    num: '05',
    title: 'Storage',
    short: 'S3-compatible storage zones with signed on-the-fly image optimizer.',
    full: '<span class="mono">S3</span>-style storage zones with presigned upload + a signed on-the-fly image optimizer (resize / format / quality via <span class="mono">imgproxy</span>).',
    icon: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>'
  },
  {
