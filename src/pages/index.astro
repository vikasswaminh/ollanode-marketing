---
<Site>
  <!-- HERO -->
  <section class="hero" id="top">
    {/* REMOVED ORANGE GLOW AND PARTICLES */}
    <div class="hero-wrap-centered">
      <div class="hero-eyebrow-light">
        <span class="hero-eyebrow-star">★</span>
        <span>SELF-HOSTED INFRASTRUCTURE PLATFORM</span>
      </div>


      <h1 class="hero-h1-light" aria-label="Own your Infrastructure Deliver without Limits">
        <span class="hero-h1-line">
          {line1Chars.map((char, index) => (
            <span class={`char-span ${index >= 9 ? 'text-orange' : ''}`} style={`animation-delay: ${0.2 + index * 0.035}s`}>
              {char === ' ' ? '\u00A0' : char}
            </span>
          ))}
        </span>
        <br />
        <span class="hero-h1-line">
          {line2Chars.map((char, index) => (
            <span class="char-span" style={`animation-delay: ${0.2 + (line1Chars.length + index) * 0.035}s`}>
              {char === ' ' ? '\u00A0' : char}
            </span>
          ))}
        </span>
      </h1>

      <p class="hero-desc-light">
        OllaNode is a self-hosted infrastructure platform for video, CDN, storage and edge compute — giving developers complete control over how their applications are built, delivered and scaled.
      </p>

      <div class="hero-cta-light">
        <a class="btn-primary-light" href="https://login.ollanode.com">GET STARTED</a>
        <a class="btn-secondary-light" href="/docs">EXPLORE DOCS</a>
      </div>
    </div>
  </section>

  <!-- FEATURE CHARACTERISTICS -->
  <section class="characteristics-section" id="capabilities-strip">
    <div class="characteristics-wrap">
      <p class="characteristics-subheading">Trusted by teams building modern experiences</p>

      <div class="characteristics-grid">
        <!-- Item 1: FULL CONTROL -->
        <div class="characteristic-item">
          <div class="characteristic-circle">
            <svg class="characteristic-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <span class="characteristic-title">FULL CONTROL</span>
        </div>

        <!-- Item 2: HIGH PERFORMANCE -->
        <div class="characteristic-item">
          <div class="characteristic-circle">
            <svg class="characteristic-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
          </div>
          <span class="characteristic-title">HIGH PERFORMANCE</span>
        </div>

        <!-- Item 3: COST EFFICIENT -->
        <div class="characteristic-item">
          <div class="characteristic-circle">
            <svg class="characteristic-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="23 18 13.5 8.5 8.5 13.5 1 6"/>
              <polyline points="17 18 23 18 23 12"/>
            </svg>
          </div>
          <span class="characteristic-title">COST EFFICIENT</span>
        </div>

        <!-- Item 4: BUILT FOR SCALE -->
        <div class="characteristic-item">
          <div class="characteristic-circle">
            <svg class="characteristic-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
              <line x1="12" y1="22.08" x2="12" y2="12"/>
            </svg>
          </div>
          <span class="characteristic-title">BUILT FOR SCALE</span>
        </div>

        <!-- Item 5: DEVELOPER FIRST -->
        <div class="characteristic-item">
          <div class="characteristic-circle">
            <svg class="characteristic-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6"/>
              <polyline points="8 6 2 12 8 18"/>
            </svg>
          </div>
          <span class="characteristic-title">DEVELOPER FIRST</span>
        </div>
      </div>
    </div>
  </section>

  <!-- PLATFORM / PRODUCT CAPABILITIES -->
  <section class="platform-capabilities-section" id="platform-capabilities">
    <div class="platform-capabilities-wrap">
      <div class="platform-head">
        <h2 class="platform-h2 reveal-up ">
          One <span class="text-orange">platform.</span> Every layer you need.
        </h2>
        <p class="platform-sub reveal-up reveal-up">
          Everything works together. Everything runs on you.
        </p>
      </div>

      <div class="carousel-outer">
        <button class="carousel-arrow prev" id="cap-prev" type="button" aria-label="Previous capabilities" disabled>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
        </button>

        <div class="carousel-viewport" id="cap-viewport">
          <div class="carousel-track" id="cap-track">
            {platformCapabilities.map((item) => (
              <div class="cap-card-static">
                <div class="cap-card-content">
                  <div class="cap-card-header">
                    <h3 class="cap-card-title">{item.title}</h3>
                    <div class="cap-card-circle">
                      <svg class="cap-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
                    </div>
                  </div>
                  <p class="cap-card-short">{item.short}</p>
                  <ul class="cap-card-bullets">
                    {item.full.split(/(?:; |, and |, )/).filter(Boolean).map(bullet => (
                      <li set:html={bullet + (bullet.endsWith('.') ? '' : '.')} />
                    ))}
                  </ul>
                </div>
              </div>
            ))}
          </div>
        </div>

        <button class="carousel-arrow next" id="cap-next" type="button" aria-label="Next capabilities">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </button>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      function initPlatformCarousel() {
        var track = document.getElementById('cap-track');
        var prevBtn = document.getElementById('cap-prev');
        var nextBtn = document.getElementById('cap-next');
        var viewport = document.getElementById('cap-viewport');

        if (!track || !prevBtn || !nextBtn || !viewport) return;

        var cards = track.querySelectorAll('.cap-card-static');
        var currentIndex = 0;

        function getVisibleCount() {
          var w = window.innerWidth;
          if (w <= 680) return 1;
          if (w <= 1100) return 2;
          return 3;
        }

        function updateCarousel() {
          var visibleCount = getVisibleCount();
          var maxIndex = Math.max(0, cards.length - visibleCount);

          if (currentIndex > maxIndex) currentIndex = maxIndex;
          if (currentIndex < 0) currentIndex = 0;

          if (cards.length > 0) {
            var cardWidth = cards[0].offsetWidth;
            var gap = 20;
            var moveDistance = (cardWidth + gap) * currentIndex;
            track.style.transform = 'translateX(-' + moveDistance + 'px)';
          }

          prevBtn.disabled = (currentIndex === 0);
          nextBtn.disabled = (currentIndex >= maxIndex);
        }

        prevBtn.addEventListener('click', function (e) {
          e.preventDefault();
          currentIndex -= 2; // MOVE EXACTLY 2 CARDS PER CLICK
          updateCarousel();
        });

        nextBtn.addEventListener('click', function (e) {
          e.preventDefault();
          currentIndex += 2; // MOVE EXACTLY 2 CARDS PER CLICK
          updateCarousel();
        });

        /* No flip script needed */

        window.addEventListener('resize', updateCarousel);
        updateCarousel();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPlatformCarousel);
      } else {
        initPlatformCarousel();
      }
    })();
  </script>

  <!-- WHY OLLANODE SECTION -->
  <WhyOllanodeSection />

  <!-- HOW IT WORKS ARCHITECTURE SECTION -->
  <HowItWorksArchitecture />

  <!-- VOD PIPELINE SECTION -->
  <VodPipelineSection />

  <!-- TECHNICAL CAPABILITIES CAROUSEL -->
  <TechCapabilitiesCarousel />

  <!-- DELIVERY & EDGE SECTION -->
  <DeliveryEdgeSection />

  <!-- AGENT-NATIVE SECTION -->
  <AgentNativeSection />

  <!-- WHAT OLLANODE IS & ISN'T SECTION -->
  <WhatOllanodeIsSection />

  <!-- QUICK START SECTION -->
  <QuickStartSection />
</Site>
