---
import Site from '../layouts/Site.astro';
const features = [
  { icon: '⬆', title: 'Upload any source', body: 'Direct upload, resumable multipart for large files, or pull from a URL. We handle the rest.' },
  { icon: '⚙', title: 'Adaptive transcoding', body: 'Automatic HLS ladders, audio loudness normalization, MP4 + audio renditions, thumbnails and storyboards.' },
  { icon: '▶', title: 'Player & embed', body: 'Drop-in embed, signed or public playback, chapters, and multi-language subtitles out of the box.' },
  { icon: '🌐', title: 'Global CDN', body: 'Multi-tenant pull zones with instant purge, signed URLs, CORS, and cache rules at the edge.' },
  { icon: '🔑', title: 'API-first', body: 'Everything is a REST endpoint: API keys, webhooks (Mux-style events), and per-project scoping.' },
  { icon: '🔒', title: 'You own it', body: 'Self-hosted on your VMs and storage. No per-minute lock-in, no surprise egress bills.' },
];
const steps = [
  { n: '1', title: 'Create a video', body: 'POST a video (or a source URL) and get a presigned upload target.' },
  { n: '2', title: 'We process it', body: 'Transcode to an adaptive ladder, extract thumbnails, normalize audio — fully async.' },
  { n: '3', title: 'Stream anywhere', body: 'Embed the player or serve the HLS manifest through your CDN, signed or public.' },
];
const snippet = `curl -X POST https://api.ollanode.com/v1/videos \\
  -H "authorization: Bearer $VB_KEY" \\
  -d '{"title":"launch.mp4","source_url":"https://.../launch.mp4"}'`;
---
<Site>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="mx-auto max-w-6xl px-6 py-24 text-center">
      <span class="inline-block rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">API-first · self-hosted · CDN included</span>
      <h1 class="mx-auto mt-6 max-w-3xl text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
        Video infrastructure & CDN <span class="text-brand-600">you actually own</span>
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-slate-600">
        Upload, transcode, stream, and deliver video at scale — on your own VMs and storage.
        The power of Mux or Cloudflare Stream, without the lock-in or per-minute pricing.
      </p>
      <div class="mt-8 flex items-center justify-center gap-3">
        <a href="https://login.ollanode.com" class="rounded-md bg-brand-600 px-5 py-3 text-sm font-medium text-white hover:bg-brand-700">Open the dashboard</a>
        <a href="/#features" class="rounded-md border border-slate-300 px-5 py-3 text-sm font-medium text-slate-700 hover:bg-slate-50">Explore features</a>
      </div>
      <pre class="mx-auto mt-12 max-w-xl overflow-x-auto rounded-lg bg-slate-900 p-4 text-left text-xs text-slate-100"><code>{snippet}</code></pre>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="border-t border-slate-100 bg-slate-50">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900">Everything to ship video</h2>
      <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">One platform for ingest, processing, delivery, and the control plane.</p>
      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {features.map((f) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <div class="text-2xl">{f.icon}</div>
            <h3 class="mt-3 font-semibold text-slate-900">{f.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how" class="mx-auto max-w-6xl px-6 py-20">
    <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900">From upload to playback in three steps</h2>
    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
      {steps.map((s) => (
        <div class="rounded-xl border border-slate-200 p-6">
          <div class="grid h-9 w-9 place-items-center rounded-full bg-brand-600 text-sm font-semibold text-white">{s.n}</div>
          <h3 class="mt-4 font-semibold text-slate-900">{s.title}</h3>
          <p class="mt-2 text-sm text-slate-600">{s.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-brand-900">
    <div class="mx-auto max-w-6xl px-6 py-16 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white">Ready to run your own video platform?</h2>
      <p class="mx-auto mt-3 max-w-xl text-brand-100">Sign in to the dashboard and create your first video in minutes.</p>
      <a href="https://login.ollanode.com" class="mt-8 inline-block rounded-md bg-white px-5 py-3 text-sm font-semibold text-brand-700 hover:bg-brand-50">Get started →</a>
    </div>
  </section>
</Site>
