---
import Site from '../layouts/Site.astro';
import HowItWorksArchitecture from '../components/HowItWorksArchitecture.astro';
import VodPipelineSection from '../components/VodPipelineSection.astro';
import TechCapabilitiesCarousel from '../components/TechCapabilitiesCarousel.astro';
import DeliveryEdgeSection from '../components/DeliveryEdgeSection.astro';
import QuickStartSection from '../components/QuickStartSection.astro';
import WhyOllanodeSection from '../components/WhyOllanodeSection.astro';
import AgentNativeSection from '../components/AgentNativeSection.astro';
import FaqSection from '../components/FaqSection.astro';

const prefixChars = Array.from("Own your ");
const infraChars = Array.from("Infrastructure");
const line2Chars = Array.from("Deliver without Limits");

const stats = [
  { n: '9', l: 'Services' },
  { n: '11', l: 'Library crates' },
  { n: '360p→4K', l: 'HLS ladder' },
  { n: '−52%', l: 'AVIF posters' },
  { n: ':53', l: 'Authoritative DNS' },
];

const pipeline = [
  ['event', 'upload_completed', false],
  ['step', 'validate', false],
  ['step', 'extract_metadata', false],
  ['encode', 'transcode', true],
  ['encode', 'generate_hls', true],
  ['step', 'thumbnails', false],
  ['step', 'transcript', false],
  ['step', 'store_assets', false],
  ['step', 'emit_webhook', false],
  ['ready', 'mark_ready', true],
];

const svg = (p) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${p}</svg>`;

const caps = [
  { icon: svg('<rect x="2.5" y="5" width="15" height="14" rx="2"/><path d="M17.5 10l4-2.5v9L17.5 14"/>'), t: 'Video',
    d: 'Adaptive HLS ladder (360p→4K, no upscaling), H.264 plus optional GPU-accelerated H.265, progressive MP4 + audio-only MP3, sub-clips, and optional AES-128 HLS encryption.' },
  { icon: svg('<rect x="4" y="10.5" width="16" height="10" rx="2"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/>'), t: 'Playback',
    d: 'Signed, expiring tokens over a private origin (bytes never served direct), cookie-scoped CDN-cacheable segments, and an embeddable web player.' },
  { icon: svg('<rect x="3" y="4" width="18" height="14" rx="2"/><path d="M7 21h10M6 9h5M6 13h8"/>'), t: 'Thumbnails & transcripts',
    d: 'Poster + sampled frames + storyboard sprite/WebVTT; word-level transcripts (VTT/SRT), optional diarization, manual chapters, and AI title/description/tags/chapters.' },
  { icon: svg('<path d="M6.5 18a4.5 4.5 0 0 1-.5-8.97A6 6 0 0 1 18 8.5a4 4 0 0 1 .5 9.5H7z"/><path d="M12 12v5M9.5 14.5 12 12l2.5 2.5"/>'), t: 'CDN',
    d: 'Multi-tenant pull zones on the CDN edge: per-zone TTL/CORS/edge rules, hotlink token signing, full + path-granular purge, live traffic analytics.' },
  { icon: svg('<ellipse cx="12" cy="6" rx="7.5" ry="3"/><path d="M4.5 6v6c0 1.66 3.36 3 7.5 3s7.5-1.34 7.5-3V6M4.5 12v6c0 1.66 3.36 3 7.5 3s7.5-1.34 7.5-3v-6"/>'), t: 'Storage',
    d: 'Object-storage-style storage zones with presigned upload + a signed on-the-fly image optimizer (resize / format / quality).' },
  { icon: svg('<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 3.8 5.7 3.8 9S14.5 18.5 12 21c-2.5-2.5-3.8-5.7-3.8-9S9.5 5.5 12 3z"/>'), t: 'DNS',
    d: 'Authoritative DNS server serving zones/records (A/AAAA/CNAME/TXT/MX/NS) from the database on :53.' },
  { icon: svg('<path d="m8 8-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14"/>'), t: 'Edge functions',
    d: 'Deploy JS/TS functions, executed at the edge in sandboxed isolates.' },
  { icon: svg('<path d="M12 3v6M8.5 6 12 9l3.5-3M5 12a7 7 0 0 0 14 0M5 12v3a3 3 0 0 0 3 3h3M19 12v3a3 3 0 0 1-3 3h-1"/>'), t: 'Webhooks',
    d: 'HMAC-signed delivery with exponential-backoff retries + dead-letter.' },
  { icon: svg('<circle cx="9" cy="8" r="3.2"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0M16 6.2a3.2 3.2 0 0 1 0 6M17.5 19a5.5 5.5 0 0 0-3-4.9"/>'), t: 'Accounts & access',
    d: 'Self-serve signup, roles (owner/admin/member/viewer), true per-project tenant isolation, fine-grained resource:action scopes.' },
  { icon: svg('<rect x="4.5" y="8" width="15" height="11" rx="2.5"/><path d="M12 8V4.5M12 4.5a1.5 1.5 0 1 1 0-.01M9 13h.01M15 13h.01M9.5 16.5h5"/>'), t: 'AI-agent model',
    d: 'Agents work API-first with approval-gated destructive/code actions, a /v1/whoami capability map, tamper-evident hash-chain audit, and a kill-switch.' },
  { icon: svg('<path d="M12 3 5 6v5c0 4.4 3 8 7 9 4-1 7-4.6 7-9V6l-7-3z"/><path d="m9 12 2 2 4-4"/>'), t: 'Security',
    d: 'A WAF with an industry-standard ruleset in front of the API, origin guard, idempotency keys, rate limiting, request-id correlation.' },
  { icon: svg('<path d="M4 7h16M4 12h16M4 17h16"/><circle cx="8" cy="7" r="1.4" fill="currentColor" stroke="none"/><circle cx="15" cy="12" r="1.4" fill="currentColor" stroke="none"/><circle cx="10" cy="17" r="1.4" fill="currentColor" stroke="none"/>'), t: 'Orchestration',
    d: 'Clean architecture + DDD: the domain core has no IO, adapters implement ports. Runs on an event bus, or an optional workflow engine when enabled.' },
];

const stack = ['API core', 'SQL database', 'Event streaming', 'Object storage', 'Media pipeline', 'Transcription', 'Image optimizer', 'Resumable uploads', 'WAF', 'Authoritative DNS', 'Edge runtime'];

const services = ['upload', 'transcode', 'thumbnail', 'transcript', 'webhook', 'cdn-edge-agent', 'playback', 'dns-service'];

const heroCode = `<span class="pr">$</span> <span class="cmd">curl -X POST https://api.ollanode.com/<span class="k">v1/videos</span> \\</span>
    <span class="cmd">-H <span class="s">"Authorization: Bearer $OLLA_KEY"</span> \\</span>
    <span class="cmd">-d <span class="s">'{"title":"launch.mp4"}'</span></span>

<span class="c">// 201 Created</span>
<span class="p">{</span>
  <span class="k">"id"</span><span class="p">:</span> <span class="s">"vid_8Kd2Qa7Rn0"</span><span class="p">,</span>
  <span class="k">"status"</span><span class="p">:</span> <span class="s">"created"</span><span class="p">,</span>
  <span class="k">"master_url"</span><span class="p">:</span> <span class="s">"…/hls/master.m3u8?<span class="n">token</span>=…"</span>
<span class="p">}</span>`;
const platformCapabilities = [
  {
    num: '01',
    title: 'Video',
    category: 'VOD ENGINE',
    short: 'Adaptive multi-bitrate video delivery with HLS, GPU transcoding & playback.',
    bullets: ['360p→4K HLS resolution ladder', 'H.264 & GPU-accelerated H.265', 'AES-128 HLS chunk encryption'],
    icon: '<polygon points="5 3 19 12 5 21 5 3"/>',
    color: '#FF5A3D',
    bg: '#FFF0EB',
    border: '#FFD6CC',
    type: 'video'
  },
  {
    num: '02',
    title: 'Playback',
    category: 'ORIGIN SECURITY',
    short: 'Private origin streaming with expiring tokens & embeddable web player.',
    bullets: ['Signed expiring HMAC tokens', 'Private origin shield (no direct bytes)', 'Cookie-scoped CDN cacheable segments'],
    icon: '<rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>',
    color: '#2563EB',
    bg: '#EFF6FF',
    border: '#DBEAFE',
    type: 'playback'
  },
  {
    num: '03',
    title: 'Thumbnails & Transcripts',
    category: 'METADATA & AI',
    short: 'Poster sprites, WebVTT, word-level transcripts & AI metadata tagging.',
    bullets: ['Sampled frame sprite storyboards', 'WebVTT / SRT subtitles & diarization', 'AI title, tags & chapter extraction'],
    icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>',
    color: '#8B5CF6',
    bg: '#F5F3FF',
    border: '#EDE9FE',
    type: 'transcripts'
  },
  {
    num: '04',
    title: 'CDN',
    category: 'GLOBAL EDGE',
    short: 'Multi-tenant edge pull zones with sub-150ms instant cache purging.',
    bullets: ['Global edge pull zones with Anycast', 'Per-zone TTL, CORS & hotlink tokens', 'Sub-150ms full & path-granular purge'],
    icon: '<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
    color: '#0284C7',
    bg: '#F0F9FF',
    border: '#E0F2FE',
    type: 'cdn'
  },
  {
    num: '05',
    title: 'Storage',
    category: 'OBJECT STORAGE',
    short: 'S3-compatible storage zones with signed on-the-fly image optimization.',
    bullets: ['Standard S3-compatible API & TUS', 'Presigned direct multi-part uploads', 'Real-time AVIF/WebP image optimizer (-52%)'],
    icon: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>',
    color: '#0D9488',
    bg: '#F0FDFA',
    border: '#CCFBF1',
    type: 'storage'
  },
  {
    num: '06',
    title: 'DNS',
    category: 'AUTHORITATIVE :53',
    short: 'Authoritative DNS server serving zone records directly on port 53.',
    bullets: ['A, AAAA, CNAME, TXT, MX records', 'Sub-second cluster database sync', 'Direct high-speed UDP/TCP on :53'],
    icon: '<rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/>',
    color: '#6366F1',
    bg: '#EEF2FF',
    border: '#E0E7FF',
    type: 'dns'
  },
  {
    num: '07',
    title: 'Edge Functions',
    category: 'ISOLATE COMPUTE',
    short: 'Deploy TypeScript/JavaScript functions executed in low-latency isolates.',
    bullets: ['Sandboxed V8 lightweight isolates', 'TypeScript & standard Web APIs', '< 5ms ultra-low cold start times'],
    icon: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/><line x1="14" y1="4" x2="10" y2="20"/>',
    color: '#F97316',
    bg: '#FFF7ED',
    border: '#FFEDD5',
    type: 'functions'
  },
  {
    num: '08',
    title: 'Webhooks',
    category: 'EVENT DISPATCH',
    short: 'HMAC-signed delivery with exponential retries & dead-letter queue.',
    bullets: ['HMAC-SHA256 payload signing', 'Exponential backoff retry policy', 'Dead-letter capture & inspection'],
    icon: '<path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>',
    color: '#E11D48',
    bg: '#FFF1F2',
    border: '#FFE4E6',
    type: 'webhooks'
  },
  {
    num: '09',
    title: 'Accounts & Access',
    category: 'IAM & RBAC',
    short: 'Multi-tenant role isolation, fine-grained scopes & self-serve auth.',
    bullets: ['Owner, Admin, Member & Viewer roles', 'Granular resource:action API scopes', 'True tenant isolation per project'],
    icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
    color: '#16A34A',
    bg: '#F0FDF4',
    border: '#DCFCE7',
    type: 'access'
  },
  {
    num: '10',
    title: 'AI-Agent Model',
    category: 'MCP AGENT PROTOCOL',
    short: 'Approval-gated agent actions, /v1/whoami map & audit hash-chain.',
    bullets: ['Model Context Protocol (MCP) native', 'Approval-gated destructive mutations', 'Cryptographic hash-chain audit log'],
    icon: '<rect x="3" y="11" width="18" height="10" rx="2"/><circle cx="12" cy="5" r="2"/><path d="M12 7v4"/><line x1="8" y1="16" x2="8.01" y2="16"/><line x1="16" y1="16" x2="16.01" y2="16"/>',
    color: '#7C3AED',
    bg: '#F5F3FF',
    border: '#EDE9FE',
    type: 'agent'
  },
  {
    num: '11',
    title: 'Security',
    category: 'WAF & SHIELD',
    short: 'WAF with OWASP Core ruleset, origin guard & rate limiting.',
    bullets: ['OWASP Core WAF rule inspection', 'Sliding window rate limiting', 'Idempotency keys & origin tokens'],
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
    color: '#059669',
    bg: '#ECFDF5',
    border: '#D1FAE5',
    type: 'security'
  },
  {
    num: '12',
    title: 'Orchestration',
    category: 'CORE ARCHITECTURE',
    short: 'Domain-Driven Design (DDD) with asynchronous event bus.',
    bullets: ['Zero-IO domain core in Rust', 'High-throughput async event bus', 'Clean pluggable ports & adapters'],
    icon: '<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>',
    color: '#D97706',
    bg: '#FFFBEB',
    border: '#FEF3C7',
    type: 'orchestration'
  }
];
---
<Site>
  <!-- HERO -->
  <section class="hero" id="top">
    {/* REMOVED ORANGE GLOW AND PARTICLES */}
    <div class="hero-wrap-centered">
      <div class="hero-eyebrow-light">
        <span class="hero-eyebrow-star">✦</span>
        <span class="hero-eyebrow-text">SELF-HOSTED INFRASTRUCTURE PLATFORM</span>
      </div>


      <h1 class="hero-h1-light" aria-label="Own your Infrastructure Deliver without Limits">
        <span class="hero-h1-line">
          {prefixChars.map((char, index) => (
            char === ' ' ? (
              <span class="char-space">&nbsp;</span>
            ) : (
              <span class="char-span" style={`animation-delay: ${0.2 + index * 0.035}s`}>
                {char}
              </span>
            )
          ))}
          <span class="hero-gradient-word">
            {infraChars.map((char, index) => (
              <span class="char-span gradient-char" style={`animation-delay: ${0.2 + (prefixChars.length + index) * 0.035}s`}>
                {char}
              </span>
            ))}
          </span>
        </span>
        <br class="hero-h1-br" />
        <span class="hero-h1-line">
          {line2Chars.map((char, index) => (
            char === ' ' ? (
              <span class="char-space">&nbsp;</span>
            ) : (
              <span class="char-span" style={`animation-delay: ${0.2 + (prefixChars.length + infraChars.length + index) * 0.035}s`}>
                {char}
              </span>
            )
          ))}
        </span>
      </h1>

      <!-- CTA BUTTONS (BEFORE DESCRIPTION) -->
      <div class="hero-cta-light">
        <a class="btn-primary-light" href="https://login.ollanode.com">GET STARTED</a>
        <a class="btn-secondary-light" href="/docs">EXPLORE DOCS</a>
      </div>

      <!-- DESCRIPTION (AFTER BUTTONS) -->
      <p class="hero-desc-light">
        OllaNode is a self-hosted infrastructure platform for video, CDN, storage and edge compute — giving developers complete control over how their applications are built, delivered and scaled.
      </p>

      <!-- TRUSTED BY BLOCK (INSIDE HERO WITH NARROW MARGINS & STYLED BG) -->
      <div class="hero-trusted-wrapper">
        <span class="hero-trusted-title">TRUSTED BY TEAMS BUILDING MODERN EXPERIENCES</span>
        <div class="hero-trusted-block">
          <span class="trust-bullet-item">
            <span class="trust-check-icon">✓</span>
            <span>Full Control</span>
          </span>
          <span class="trust-bullet-sep" aria-hidden="true">•</span>
          <span class="trust-bullet-item">
            <span class="trust-check-icon">✓</span>
            <span>High Performance</span>
          </span>
          <span class="trust-bullet-sep" aria-hidden="true">•</span>
          <span class="trust-bullet-item">
            <span class="trust-check-icon">✓</span>
            <span>Cost Efficient</span>
          </span>
          <span class="trust-bullet-sep" aria-hidden="true">•</span>
          <span class="trust-bullet-item">
            <span class="trust-check-icon">✓</span>
            <span>Built for Scale</span>
          </span>
          <span class="trust-bullet-sep" aria-hidden="true">•</span>
          <span class="trust-bullet-item">
            <span class="trust-check-icon">✓</span>
            <span>Developer First</span>
          </span>
        </div>
      </div>

    </div>
  </section>

  <!-- PLATFORM / PRODUCT CAPABILITIES -->
  <section class="platform-capabilities-section" id="platform-capabilities">
    <div class="platform-capabilities-wrap">
      <div class="platform-head">
        <h2 class="platform-h2 reveal-up ">
          One <span class="text-orange">platform.</span> Every layer you need.
        </h2>
        <p class="platform-sub reveal-up">
          Everything works together. Everything runs on you.
        </p>
      </div>

      <div class="carousel-outer">
        <button class="carousel-arrow prev" id="cap-prev" type="button" aria-label="Previous capabilities" disabled>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
        </button>

        <div class="carousel-viewport" id="cap-viewport">
          <div class="carousel-track" id="cap-track">
            {platformCapabilities.map((item) => (
              <div class="cap-card-static" style={`--item-accent: ${item.color}; --item-bg: ${item.bg}; --item-border: ${item.border};`}>
                <div class="cap-card-content">
                  
                  <!-- CARD HEADER -->
                  <div class="cap-card-header">
                    <div class="cap-card-head-meta">
                      <span class="cap-card-num">{item.num}</span>
                      <span class="cap-card-cat">{item.category}</span>
                    </div>
                    <div class="cap-card-circle">
                      <svg class="cap-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
                    </div>
                  </div>

                  <h3 class="cap-card-title">{item.title}</h3>

                  <!-- VISUAL CARD / UI PREVIEW IMAGE -->
                  <div class="cap-card-visual" data-type={item.type}>
                    {item.type === 'video' && (
                      <div class="vcard vcard-video">
                        <div class="v-top-row">
                          <span class="v-pill v-pill-orange">4K HLS</span>
                          <span class="v-pill v-pill-dark">GPU H.265</span>
                        </div>
                        <div class="v-center-player">
                          <div class="v-play-btn">
                            <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="6 4 20 12 6 20 6 4"/></svg>
                          </div>
                          <div class="v-bars">
                            <span></span><span></span><span></span><span></span><span></span><span></span>
                          </div>
                        </div>
                        <div class="v-ladder-strip">
                          <span class="v-tag">360p</span>
                          <span class="v-tag">720p</span>
                          <span class="v-tag">1080p</span>
                          <span class="v-tag active">4K</span>
                        </div>
                      </div>
                    )}

                    {item.type === 'playback' && (
                      <div class="vcard vcard-playback">
                        <div class="v-top-row">
                          <span class="v-pill v-pill-blue">🔒 PRIVATE ORIGIN</span>
                          <span class="v-pill v-pill-green">SIGNED TOKEN</span>
                        </div>
                        <div class="v-token-box">
                          <span class="v-token-lbl">TOKEN GATE</span>
                          <span class="v-token-str">master.m3u8?token=exp_9a2f7c01</span>
                        </div>
                        <div class="v-gate-badges">
                          <span class="v-mini-badge">🛡 Origin Shield</span>
                          <span class="v-mini-badge">⚡ Edge Cache</span>
                        </div>
                      </div>
                    )}

                    {item.type === 'transcripts' && (
                      <div class="vcard vcard-transcripts">
                        <div class="v-frames-row">
                          <div class="v-frame"><span>00:06</span></div>
                          <div class="v-frame active"><span>00:18</span></div>
                          <div class="v-frame"><span>00:32</span></div>
                        </div>
                        <div class="v-ai-bubble">
                          <span class="v-ai-tag">✨ AI Whisper</span>
                          <p class="v-ai-snippet">"Deploy video infra with zero limits..."</p>
                        </div>
                      </div>
                    )}

                    {item.type === 'cdn' && (
                      <div class="vcard vcard-cdn">
                        <div class="v-pops-grid">
                          <div class="v-pop"><span class="v-dot"></span><span>SFO</span><strong>12ms</strong></div>
                          <div class="v-pop"><span class="v-dot"></span><span>FRA</span><strong>18ms</strong></div>
                          <div class="v-pop"><span class="v-dot"></span><span>SIN</span><strong>22ms</strong></div>
                        </div>
                        <div class="v-purge-row">
                          <div class="v-purge-head"><span>⚡ Instant Purge</span><strong>140ms</strong></div>
                          <div class="v-bar-track"><div class="v-bar-fill v-bar-fill-cyan"></div></div>
                        </div>
                      </div>
                    )}

                    {item.type === 'storage' && (
                      <div class="vcard vcard-storage">
                        <div class="v-top-row">
                          <span class="v-pill v-pill-teal">S3 COMPATIBLE</span>
                          <span class="v-pill v-pill-green">-52% AVIF</span>
                        </div>
                        <div class="v-file-item">
                          <div class="v-file-info"><span>video_4k_master.mp4</span><strong>4.2 GB</strong></div>
                          <div class="v-bar-track"><div class="v-bar-fill v-bar-fill-teal"></div></div>
                        </div>
                      </div>
                    )}

                    {item.type === 'dns' && (
                      <div class="vcard vcard-dns">
                        <div class="v-top-row">
                          <span class="v-pill v-pill-indigo">PORT :53</span>
                          <span class="v-pill v-pill-green">&lt;1s SYNC</span>
                        </div>
                        <div class="v-dns-table">
                          <div class="v-dns-line"><span class="v-rec-type">A</span><span class="v-rec-host">@</span><span class="v-rec-ip">76.76.21.21</span></div>
                          <div class="v-dns-line"><span class="v-rec-type">CNAME</span><span class="v-rec-host">cdn</span><span class="v-rec-ip">edge.ollanode.com</span></div>
                        </div>
                      </div>
                    )}

                    {item.type === 'functions' && (
                      <div class="vcard vcard-functions">
                        <div class="v-mac-bar">
