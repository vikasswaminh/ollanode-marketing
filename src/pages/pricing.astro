---
import Site from '../layouts/Site.astro';
---

<Site
  title="Pricing — Ollanode"
  description="Ownership-first pricing. No per-minute fees, no egress surprises. You bring the VMs and storage — we bring the platform."
>
  <div class="pricing-page-wrapper">
    <!-- Sophisticated Hero Backdrop with Left Peach Glow and Right Geometric Fan Rays -->
    <div class="pricing-backdrop" aria-hidden="true">
      <!-- Left Warm Peach/Coral Glow -->
      <div class="backdrop-glow-left"></div>
      
      <!-- Left Stipple / Dot Texture Field -->
      <div class="backdrop-dots-left"></div>

      <!-- Right Lavender/Violet Ambient Glow -->
      <div class="backdrop-glow-right"></div>

      <!-- Right Geometric Curved Ray Fan (SVG Vector Rays) -->
      <svg class="backdrop-rays-svg" viewBox="0 0 1440 680" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMaxYMin meet">
        <defs>
          <linearGradient id="rayGrad" x1="100%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#8B5CF6" stop-opacity="0.55" />
            <stop offset="45%" stop-color="#A78BFA" stop-opacity="0.32" />
            <stop offset="80%" stop-color="#DDD6FE" stop-opacity="0.12" />
            <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="rayGradSubtle" x1="100%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#C084FC" stop-opacity="0.45" />
            <stop offset="50%" stop-color="#E9D5FF" stop-opacity="0.20" />
            <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0" />
          </linearGradient>
        </defs>
        
        <!-- Curved Vector Ray Splines Fanning from Top-Right Corner -->
        <path d="M1440 -40 Q 1150 60 780 200" stroke="url(#rayGrad)" stroke-width="1.3" />
        <path d="M1440 -10 Q 1180 110 830 250" stroke="url(#rayGrad)" stroke-width="1.3" />
        <path d="M1440 20 Q 1200 160 880 300" stroke="url(#rayGrad)" stroke-width="1.3" />
        <path d="M1440 50 Q 1230 210 930 350" stroke="url(#rayGrad)" stroke-width="1.3" />
        <path d="M1440 80 Q 1250 260 980 400" stroke="url(#rayGrad)" stroke-width="1.3" />
        <path d="M1440 110 Q 1270 310 1030 450" stroke="url(#rayGrad)" stroke-width="1.3" />
        <path d="M1440 140 Q 1300 360 1080 500" stroke="url(#rayGrad)" stroke-width="1.3" />
        <path d="M1440 170 Q 1320 410 1130 550" stroke="url(#rayGrad)" stroke-width="1.3" />
        <path d="M1440 200 Q 1340 460 1180 600" stroke="url(#rayGrad)" stroke-width="1.3" />
        <path d="M1440 230 Q 1360 510 1230 650" stroke="url(#rayGrad)" stroke-width="1.3" />

        <!-- Concentric Perspective Guide Arcs -->
        <path d="M780 200 C 950 140 1200 50 1440 -40" stroke="url(#rayGradSubtle)" stroke-width="1" stroke-dasharray="3 3" />
        <path d="M880 300 C 1050 230 1270 120 1440 20" stroke="url(#rayGradSubtle)" stroke-width="1" stroke-dasharray="3 3" />
        <path d="M980 400 C 1130 320 1330 200 1440 80" stroke="url(#rayGradSubtle)" stroke-width="1" stroke-dasharray="3 3" />
        <path d="M1080 500 C 1220 420 1370 280 1440 140" stroke="url(#rayGradSubtle)" stroke-width="1" stroke-dasharray="3 3" />

        <!-- Extra Delicate Ray Accents -->
        <path d="M1440 5 Q 1190 135 855 275" stroke="url(#rayGradSubtle)" stroke-width="0.9" />
        <path d="M1440 35 Q 1215 185 905 325" stroke="url(#rayGradSubtle)" stroke-width="0.9" />
        <path d="M1440 65 Q 1240 235 955 375" stroke="url(#rayGradSubtle)" stroke-width="0.9" />
        <path d="M1440 95 Q 1260 285 1005 425" stroke="url(#rayGradSubtle)" stroke-width="0.9" />
        <path d="M1440 125 Q 1285 335 1055 475" stroke="url(#rayGradSubtle)" stroke-width="0.9" />
        <path d="M1440 155 Q 1310 385 1105 525" stroke="url(#rayGradSubtle)" stroke-width="0.9" />
        <path d="M1440 185 Q 1330 435 1155 575" stroke="url(#rayGradSubtle)" stroke-width="0.9" />
      </svg>
    </div>

    <main class="pricing-main-container">
      <!-- 1. HERO HEADER SECTION -->
      <section class="pricing-hero-header">
        <div class="pricing-eyebrow-pill">
          <span class="eyebrow-orange-dot"></span>
          <span class="eyebrow-text">PRICING</span>
        </div>

        <h1 class="pricing-hero-h1">
          Ownership-first pricing<span class="text-brand-dot">.</span>
        </h1>

        <p class="pricing-hero-lead">
          No per-minute fees. No egress surprises.<br />
          You bring the VMs and storage — we bring the platform.
        </p>
      </section>

      <!-- 2. TWO PRIMARY PRICING CARDS -->
      <section class="pricing-cards-section">
        <div class="pricing-cards-grid">
          
          <!-- CARD 1: SELF-HOST (FREE) -->
          <div class="pricing-card card-selfhost">
            <div class="card-top-badge">
              <span class="badge-selfhost">SELF-HOST</span>
            </div>

            <div class="card-price-row">
              <h2 class="card-price-h2">Free</h2>
              <div class="price-accent-bar accent-blue"></div>
            </div>

            <p class="card-tagline">
              Run the whole stack on your own infrastructure.
            </p>

            <ul class="card-features-list">
              <li>
                <span class="check-icon-circle">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span>Full source — Apache-2.0, permissive stack</span>
              </li>
              <li>
                <span class="check-icon-circle">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span>Video pipeline + CDN + storage + edge functions</span>
              </li>
              <li>
                <span class="check-icon-circle">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span>Unlimited videos, zones &amp; projects</span>
              </li>
              <li>
                <span class="check-icon-circle">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span>~60 REST endpoints, webhooks, audit</span>
              </li>
              <li>
                <span class="check-icon-circle">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span>Community support</span>
              </li>
            </ul>

            <div class="card-action-wrap">
              <a href="https://login.ollanode.com" class="btn-pricing-outline">
                <span>OPEN DASHBOARD</span>
                <span class="arrow-icon">→</span>
              </a>
            </div>
          </div>

          <!-- CARD 2: MANAGED (RECOMMENDED) -->
          <div class="pricing-card card-managed">
            <div class="card-top-badge badge-row-managed">
              <span class="badge-managed">MANAGED</span>
              <span class="badge-recommended">Recommended</span>
            </div>

            <div class="card-price-row">
              <h2 class="card-price-h2">Talk to us</h2>
              <div class="price-accent-bar accent-orange"></div>
            </div>

            <p class="card-tagline">
              We operate it on your cloud, you keep your data.
            </p>

            <ul class="card-features-list">
              <li>
                <span class="check-icon-circle">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span>Everything in Self-host</span>
              </li>
              <li>
                <span class="check-icon-circle">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span>Provisioning, upgrades &amp; monitoring</span>
              </li>
              <li>
                <span class="check-icon-circle">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span>Multi-region edge PoPs</span>
              </li>
              <li>
                <span class="check-icon-circle">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span>SLA &amp; priority support</span>
              </li>
            </ul>

            <div class="card-action-wrap">
              <a href="mailto:hello@ollanode.com" class="btn-pricing-solid">
                <span>CONTACT SALES</span>
                <span class="arrow-icon">→</span>
              </a>
            </div>
          </div>

        </div>

        <!-- Info Note Banner Below Cards -->
        <div class="pricing-info-pill-banner">
          <div class="info-pill-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FF5A3D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
          </div>
          <p class="info-pill-text">
            Both tiers are the same platform – Managed just means we run the ops.
            <a href="#scale-features" class="info-pill-link">See everything included →</a>
          </p>
        </div>
      </section>

      <!-- 3. FOUR VALUE PROPOSITION PILLARS -->
      <section class="pricing-pillars-section">
        <div class="pillars-grid">
          
          <!-- Pillar 1 -->
          <div class="pillar-card">
            <div class="pillar-icon-box icon-blue">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="1" x2="12" y2="23"></line>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
              </svg>
            </div>
            <h3 class="pillar-title">No per-minute fees</h3>
            <p class="pillar-desc">
              Predictable usage.<br />No egress or surprise charges.
            </p>
          </div>

          <!-- Pillar 2 -->
          <div class="pillar-card">
            <div class="pillar-icon-box icon-green">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </div>
            <h3 class="pillar-title">You own everything</h3>
            <p class="pillar-desc">
              Your data stays in your cloud.<br />You stay in control.
            </p>
          </div>

          <!-- Pillar 3 -->
          <div class="pillar-card">
            <div class="pillar-icon-box icon-orange">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F97316" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path>
              </svg>
            </div>
            <h3 class="pillar-title">One platform, all you need</h3>
            <p class="pillar-desc">
              Video, CDN, storage, edge functions — built-in.
            </p>
          </div>

          <!-- Pillar 4 -->
          <div class="pillar-card">
            <div class="pillar-icon-box icon-purple">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#8B5CF6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
            </div>
            <h3 class="pillar-title">Open &amp; extensible</h3>
            <p class="pillar-desc">
              Apache-2.0 license.<br />Extend and integrate freely.
            </p>
          </div>

        </div>
      </section>

      <!-- 4. EVERYTHING YOU NEED TO BUILD AT SCALE (FEATURE MATRIX) -->
      <section class="pricing-features-card-section" id="scale-features">
        <div class="features-box-container">
          
          <!-- Left Column Content -->
          <div class="features-left-col">
            <div class="features-eyebrow">
              <span class="eyebrow-orange-dot"></span>
              <span>INCLUDED IN BOTH TIERS</span>
            </div>

            <h2 class="features-box-title">
              Everything you need to build at scale<span class="text-brand-dot">.</span>
            </h2>

            <p class="features-box-desc">
              From ingest to edge delivery, access control to observability — it's all in Ollanode.
            </p>
          </div>

          <!-- Right Column 2x3 Grid of Sub-Capabilities -->
          <div class="features-right-grid">
            
            <!-- Item 1: Video Pipeline -->
            <div class="feature-sub-item">
              <div class="feature-icon-wrap icon-blue">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
              </div>
              <div class="feature-item-text">
                <h4 class="feature-item-title">Video Pipeline</h4>
                <p class="feature-item-desc">Ingest, transcode, ABR, thumbnails, captions.</p>
              </div>
            </div>

            <!-- Item 2: CDN + Edge -->
            <div class="feature-sub-item">
              <div class="feature-icon-wrap icon-green">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="2" y1="12" x2="22" y2="12"></line>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                </svg>
              </div>
              <div class="feature-item-text">
                <h4 class="feature-item-title">CDN + Edge</h4>
                <p class="feature-item-desc">Global delivery, caching, edge functions.</p>
              </div>
            </div>

            <!-- Item 3: Storage -->
            <div class="feature-sub-item">
              <div class="feature-icon-wrap icon-orange">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F97316" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </div>
              <div class="feature-item-text">
                <h4 class="feature-item-title">Storage</h4>
                <p class="feature-item-desc">S3-compatible, lifecycle policies, versioning.</p>
              </div>
            </div>

            <!-- Item 4: Access Control -->
            <div class="feature-sub-item">
              <div class="feature-icon-wrap icon-purple">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8B5CF6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
              </div>
              <div class="feature-item-text">
                <h4 class="feature-item-title">Access Control</h4>
                <p class="feature-item-desc">API keys, JWT, role-based access, audit logs.</p>
              </div>
            </div>

            <!-- Item 5: APIs & Webhooks -->
            <div class="feature-sub-item">
              <div class="feature-icon-wrap icon-blue">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0EA5E9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="16 18 22 12 16 6"></polyline>
                  <polyline points="8 6 2 12 8 18"></polyline>
                </svg>
              </div>
              <div class="feature-item-text">
                <h4 class="feature-item-title">APIs &amp; Webhooks</h4>
                <p class="feature-item-desc">~60 REST endpoints, webhooks, SDKs.</p>
              </div>
            </div>

            <!-- Item 6: Observability -->
            <div class="feature-sub-item">
              <div class="feature-icon-wrap icon-green">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                  <polyline points="17 6 23 6 23 12"></polyline>
                </svg>
              </div>
              <div class="feature-item-text">
                <h4 class="feature-item-title">Observability</h4>
                <p class="feature-item-desc">Metrics, logs, alerts, health checks.</p>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- 5. BOTTOM CTA BANNER -->
      <section class="pricing-cta-section">
        <div class="pricing-cta-banner">
          <div class="cta-left-content">
            <div class="cta-rocket-icon-wrap">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FF8A00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path>
                <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path>
                <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path>
                <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path>
              </svg>
            </div>
            <div class="cta-text-wrap">
              <h2 class="cta-title">Ready to get started?</h2>
              <p class="cta-subtitle">Spin up the free self-hosted stack in minutes.</p>
            </div>
          </div>

          <div class="cta-right-btn-wrap">
            <a href="https://login.ollanode.com" class="btn-cta-white">
              <span>OPEN DASHBOARD</span>
              <span class="arrow-icon">→</span>
            </a>
          </div>
        </div>
      </section>
    </main>
  </div>
</Site>

<style>
  /* ==========================================================================
     REDESIGNED PRICING PAGE STYLING (MATCHING EXACT AMBIENT BACKDROP SPEC)
     ========================================================================== */

  .pricing-page-wrapper {
    position: relative;
    background-color: #FFFFFF;
    color: #1A1D23;
    overflow: hidden;
    padding-bottom: 90px;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* Sophisticated Hero Backdrop Container */
  .pricing-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 720px;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }

  /* Left Warm Peach/Coral Ambient Glow */
  .backdrop-glow-left {
    position: absolute;
    top: -60px;
    left: -120px;
    width: 680px;
    height: 680px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 140, 110, 0.32) 0%, rgba(255, 185, 160, 0.16) 45%, rgba(255, 255, 255, 0) 72%);
    filter: blur(30px);
  }

  /* Left Fine Stipple Dot Pattern Field */
  .backdrop-dots-left {
    position: absolute;
    top: 0;
    left: 0;
    width: 480px;
    height: 540px;
    background-image: radial-gradient(rgba(255, 120, 80, 0.18) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 70% 60% at 20% 30%, black 20%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 20% 30%, black 20%, transparent 80%);
    opacity: 0.85;
  }

  /* Right Lavender/Violet Ambient Glow */
  .backdrop-glow-right {
    position: absolute;
    top: -80px;
    right: -100px;
    width: 750px;
    height: 700px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(216, 195, 255, 0.40) 0%, rgba(235, 225, 255, 0.18) 50%, rgba(255, 255, 255, 0) 75%);
    filter: blur(40px);
  }

  /* Right Geometric Curved Ray Fan */
  .backdrop-rays-svg {
    position: absolute;
    top: 0;
    right: 0;
    width: 920px;
    height: 680px;
    opacity: 0.9;
    mix-blend-mode: multiply;
  }

  .pricing-main-container {
    position: relative;
    z-index: 1;
    max-width: 1040px;
    margin: 0 auto;
    padding: 60px 24px 0;
  }

  /* 1. HERO HEADER */
  .pricing-hero-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 52px;
  }

  .pricing-eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
  }

  .eyebrow-orange-dot {
    width: 6px;
    height: 6px;
    background-color: #FF5A3D;
    border-radius: 50%;
    box-shadow: 0 0 0 3px rgba(255, 90, 61, 0.2);
    display: inline-block;
  }

  .eyebrow-text {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11.5px;
    font-weight: 700;
    color: #FF5A3D;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .pricing-hero-h1 {
    font-size: clamp(2.6rem, 4.5vw, 3.6rem);
    font-weight: 800;
    color: #0F172A;
    line-height: 1.12;
    letter-spacing: -0.03em;
    margin: 0 0 20px;
  }

  .text-brand-dot {
    color: #FF5A3D;
  }

  .pricing-hero-lead {
    font-size: clamp(1.05rem, 1.8vw, 1.18rem);
    color: #475569;
    line-height: 1.6;
    margin: 0 auto;
    max-width: 580px;
  }

  /* 2. TWO PRIMARY PRICING CARDS */
  .pricing-cards-section {
    margin-bottom: 64px;
  }

  .pricing-cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
    margin-bottom: 28px;
  }

  .pricing-card {
    background: #FFFFFF;
